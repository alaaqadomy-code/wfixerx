---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  schema,
  ogImage = '/og-default.jpg'
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();

// عنوان الصفحة: لاحقة العلامة تُضاف فقط إن لم تكن موجودة ولم يتجاوز الناتج 60 حرفاً،
// لأن ما يزيد على ذلك يُقطع في نتائج البحث فتُهدر مساحة الكلمة المفتاحية.
const BRAND = 'WFixerX';
const pageTitle = title.includes(BRAND)
  ? title
  : (title.length + BRAND.length + 3 <= 60 ? `${title} | ${BRAND}` : title);
---
<!doctype html>
<html dir="rtl" lang="ar">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="5KAFuCk1EZv0rb4Bj4yswBl7_quo__0DbqhRDNFBWYM" />
    <meta name="msvalidate.01" content="D909DC0D7874D0FDE4C80DDE330570BD" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ar_AR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts: non-render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&display=swap" /></noscript>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD Schema -->
    {schema && <script type="application/ld+json" set:html={schema} />}

    <!-- WebSite + Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "WFixerX",
        "url": "https://wfixerx.com",
        "description": "خدمة متخصصة في مساعدة أصحاب حسابات واتساب المحظورة في العالم العربي",
        "potentialAction": {
          "@type": "SearchAction",
          "target": { "@type": "EntryPoint", "urlTemplate": "https://wfixerx.com/مدونة/?q={search_term_string}" },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "WFixerX",
        "url": "https://wfixerx.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://wfixerx.com/og-default.jpg",
          "width": 1200,
          "height": 630
        },
        "description": "خدمة عربية متخصصة في مساعدة أصحاب حسابات واتساب المحظورة على استعادة حساباتهم",
        "areaServed": [
          { "@type": "Country", "name": "السعودية" },
          { "@type": "Country", "name": "مصر" },
          { "@type": "Country", "name": "الإمارات" },
          { "@type": "Country", "name": "الكويت" },
          { "@type": "Country", "name": "قطر" },
          { "@type": "Country", "name": "البحرين" },
          { "@type": "Country", "name": "عُمان" },
          { "@type": "Country", "name": "الأردن" },
          { "@type": "Country", "name": "العراق" }
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "availableLanguage": "Arabic",
          "url": "https://wa.me/962795827790"
        },
        "knowsAbout": [
          "حظر واتساب",
          "فك حظر واتساب",
          "استرجاع حساب واتساب",
          "طلب مراجعة واتساب"
        ]
      }
    ])} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingButtons />

    <script>
      // Force scroll to top on every page load/refresh
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);

      // Scroll reveal
      const revealObs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            revealObs.unobserve(e.target);
          }
        });
      }, { threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

      // Animated number counter
      function runCounter(el: HTMLElement, target: number, suffix = '') {
        const dur = 1600;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(eased * target).toLocaleString('ar-SA') + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      const counterObs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const el = e.target as HTMLElement;
            const target = parseInt(el.dataset.target || '0');
            const suffix = el.dataset.suffix || '';
            runCounter(el, target, suffix);
            counterObs.unobserve(el);
          }
        });
      }, { threshold: 0.5 });
      document.querySelectorAll('[data-target]').forEach(el => counterObs.observe(el));

      // Typewriter effect
      const twEl = document.getElementById('typewriter');
      if (twEl) {
        const phrases = ['حظر مؤقت','حظر نهائي','رسالة "لا يمكن لهذا الحساب"','حظر واتساب الأعمال','طلب مراجعة مرفوض'];
        let pi = 0, ci = 0, deleting = false;
        const TYPE_SPEED = 80, DELETE_SPEED = 40, PAUSE = 1800;
        function tick() {
          const phrase = phrases[pi];
          if (!deleting) {
            twEl.textContent = phrase.slice(0, ++ci);
            if (ci === phrase.length) { deleting = true; setTimeout(tick, PAUSE); return; }
          } else {
            twEl.textContent = phrase.slice(0, --ci);
            if (ci === 0) { deleting = false; pi = (pi + 1) % phrases.length; }
          }
          setTimeout(tick, deleting ? DELETE_SPEED : TYPE_SPEED);
        }
        setTimeout(tick, 600);
      }
    </script>
  </body>
</html>
