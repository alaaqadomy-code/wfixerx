---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  schema,
  ogImage = '/og-default.jpg'
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html dir="rtl" lang="ar">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | WFixerX</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | WFixerX`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ar_AR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD Schema -->
    {schema && <script type="application/ld+json" set:html={schema} />}

    <!-- WebSite Schema -->
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "WFixerX",
      "url": "https://wfixerx.com",
      "description": "خدمة متخصصة في مساعدة أصحاب حسابات واتساب المحظورة",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://wfixerx.com/بحث?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })}</script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingButtons />
  </body>
</html>
