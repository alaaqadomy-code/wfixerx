---
import BaseLayout from '../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
---

<BaseLayout
  title="الصفحة غير موجودة — WFixerX"
  description="الصفحة التي تبحث عنها غير موجودة. ارجع للرئيسية أو تواصل معنا."
>
  <div class="min-h-[60vh] flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-md">
      <div class="text-8xl font-black text-[#1A3C6E]/10 mb-4 select-none">404</div>
      <h1 class="text-3xl font-bold text-[#0A1628] mb-4">الصفحة غير موجودة</h1>
      <p class="text-gray-500 mb-8 leading-relaxed">
        الصفحة التي تبحث عنها ربما حُذفت أو نُقلت. جرّب العودة للرئيسية.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="btn-wa">العودة للرئيسية</a>
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-outline">تواصل معنا</a>
      </div>

      <div class="mt-12 pt-8 border-t border-gray-100">
        <p class="text-sm text-gray-400 mb-4">صفحات قد تهمك</p>
        <div class="flex flex-wrap gap-2 justify-center">
          {[
            { href: "/فك-حظر-واتساب/", title: "فك حظر واتساب" },
            { href: "/حظر-واتساب-للاعمال/", title: "حظر الأعمال" },
            { href: "/مدونة/", title: "المدونة" },
            { href: "/من-نحن/", title: "من نحن" },
          ].map(l => (
            <a href={l.href} class="text-sm text-[#1A3C6E] border border-[#1A3C6E]/30 px-3 py-1 rounded-full hover:bg-[#1A3C6E]/5 transition-colors">{l.title}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
