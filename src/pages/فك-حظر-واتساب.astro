---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppBanScreen from '../components/WhatsAppBanScreen.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "كيف تفك حظر واتساب خطوة بخطوة؟",
    "description": "دليل تفصيلي لفك حظر واتساب — من تحديد نوع الحظر إلى تقديم طلب المراجعة الرسمي",
    "totalTime": "PT45M",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "حدّد نوع الحظر",
        "text": "افتح واتساب وراجع الرسالة: عداد وقت = حظر مؤقت. رسالة 'لا يمكن لهذا الحساب' = حظر نهائي."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "الحظر المؤقت — انتظر",
        "text": "أغلق التطبيق تماماً وانتظر 24 إلى 72 ساعة دون فتحه. لا تعيد التثبيت ولا تحاول تجاوز الحظر."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "الحظر النهائي — اضغط طلب مراجعة",
        "text": "ابحث عن زر 'طلب مراجعة' داخل شاشة الحظر في التطبيق، أو ادخل على support.whatsapp.com وقدّم طلبك."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "اكتب رسالة المراجعة",
        "text": "اشرح وضعك باختصار واحترافية. لا تكرر الطلب بنفس الكلمات إذا رُفض سابقاً."
      },
      {
        "@type": "HowToStep",
        "position": 5,
        "name": "انتظر الرد أو احصل على مساعدة",
        "text": "قد يأخذ الرد من أيام إلى أسابيع. إذا رُفض الطلب أو صعب عليك الصياغة، تواصل مع WFixerX."
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "فك حظر واتساب — الدليل الشامل 2026",
    "description": "دليل شامل لفك حظر واتساب، يشمل أنواع الحظر وطرق الحل وكيفية تقديم طلب المراجعة الرسمي.",
    "author": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "publisher": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "dateModified": "2026-10-13",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل يمكن فك حظر واتساب بشكل نهائي؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم، في كثير من الحالات يمكن رفع الحظر عبر تقديم طلب مراجعة رسمي. النجاح يعتمد على سبب الحظر وتفاصيل الحساب." }
      },
      {
        "@type": "Question",
        "name": "كم تستغرق عملية فك الحظر؟",
        "acceptedAnswer": { "@type": "Answer", "text": "الحظر المؤقت يُرفع خلال 24-72 ساعة. طلب المراجعة قد يأخذ من أيام إلى أسابيع حسب استجابة واتساب." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://wfixerx.com" },
      { "@type": "ListItem", "position": 2, "name": "فك حظر واتساب", "item": "https://wfixerx.com/فك-حظر-واتساب/" }
    ]
  }
]);
---

<BaseLayout
  title="فك حظر واتساب — الدليل الشامل 2026"
  description="كيف تفك حظر واتساب؟ دليل شامل لجميع أنواع الحظر: المؤقت، النهائي، والمشدد. مع طريقة تقديم طلب المراجعة الرسمي."
  schema={schema}
>

  <!-- Breadcrumb -->
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#25D366] transition-colors">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">فك حظر واتساب</li>
    </ol>
  </nav>

  <!-- Hero -->
  <header class="bg-gradient-to-b from-[#07111f] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-xs font-medium text-[#25D366] bg-[#25D366]/10 px-3 py-1 rounded-full border border-[#25D366]/20">وقت القراءة: 8 دقائق</span>
        <span class="text-xs text-white/35">آخر تحديث: أكتوبر 2026</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight mb-6">
        فك حظر واتساب — الدليل الشامل 2026
      </h1>
      <p class="text-lg text-white/70 leading-relaxed max-w-3xl">
        إذا كان حسابك على واتساب محظوراً وتبحث عن طريقة للحل، هذا الدليل يشرح لك بالتفصيل: أنواع الحظر، أسبابه، وخطوات فكّه — سواء كنت ستحاول بمفردك أو تحتاج مساعدة متخصصة.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="flex justify-center mb-10">
      <WhatsAppBanScreen type="final" />
    </div>

    <!-- Quick Answer Box -->
    <div class="quick-answer mb-10">
      <p class="text-xs font-semibold text-[#25D366] uppercase tracking-wider mb-2">الجواب السريع</p>
      <h2 class="text-xl font-bold text-white mb-3">كيف تفك حظر واتساب؟</h2>
      <ol class="space-y-1 text-white/75">
        <li><strong>1.</strong> تحقق من نوع الحظر — مؤقت أم دائم.</li>
        <li><strong>2.</strong> إذا مؤقت: أوقف استخدام التطبيق وانتظر من 24 إلى 72 ساعة.</li>
        <li><strong>3.</strong> إذا دائم: اضغط على زر "طلب مراجعة" داخل التطبيق أو زر support.whatsapp.com.</li>
        <li><strong>4.</strong> إذا رُفض الطلب أو لم يظهر زر المراجعة: تواصل مع WFixerX للمساعدة.</li>
      </ol>
    </div>

    <!-- Section 1 -->
    <h2 class="text-2xl font-bold text-white mt-10 mb-4">ما هو حظر واتساب؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">
      حظر واتساب هو: قرار تتخذه شركة WhatsApp LLC لمنع حساب معين من استخدام التطبيق — بشكل مؤقت أو دائم — بسبب انتهاك شروط الاستخدام. يؤثر الحظر على الرقم ذاته وليس الجهاز.
    </p>

    <!-- Table: Types of bans -->
    <h2 class="text-2xl font-bold text-white mt-10 mb-4">أنواع حظر واتساب</h2>
    <div class="overflow-x-auto rounded-2xl border border-white/10 mb-6">
      <table class="w-full text-sm">
        <thead class="bg-white/5 border-b border-white/10">
          <tr>
            <th class="px-4 py-3 text-right font-semibold text-white/70">نوع الحظر</th>
            <th class="px-4 py-3 text-right font-semibold text-white/70">المدة</th>
            <th class="px-4 py-3 text-right font-semibold text-white/70">العلامة</th>
            <th class="px-4 py-3 text-right font-semibold text-white/70">الحل</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/8">
          <tr>
            <td class="px-4 py-3 font-medium text-white">مؤقت</td>
            <td class="px-4 py-3 text-white/60">24 ساعة — أسبوع</td>
            <td class="px-4 py-3 text-white/60">عداد وقت ظاهر</td>
            <td class="px-4 py-3 text-green-400 font-medium">انتظر تلقائياً</td>
          </tr>
          <tr class="bg-white/2">
            <td class="px-4 py-3 font-medium text-white">مشدد</td>
            <td class="px-4 py-3 text-white/60">أسابيع — أشهر</td>
            <td class="px-4 py-3 text-white/60">حظر متكرر</td>
            <td class="px-4 py-3 text-orange-400 font-medium">طلب مراجعة + تغيير السلوك</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium text-white">نهائي</td>
            <td class="px-4 py-3 text-white/60">دائم حتى الاسترداد</td>
            <td class="px-4 py-3 text-white/60">رسالة "لا يمكن"</td>
            <td class="px-4 py-3 text-red-400 font-medium">طلب مراجعة رسمي</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Section 2: Reasons -->
    <h2 class="text-2xl font-bold text-white mt-10 mb-4">أسباب حظر واتساب</h2>
    <p class="text-white/70 leading-relaxed mb-3">تحظر واتساب الحسابات للأسباب التالية:</p>
    <ul class="space-y-2 text-white/70 mb-6">
      {[
        "إرسال رسائل جماعية لأشخاص لا يعرفونك (سبام).",
        "استخدام نسخ غير رسمية من واتساب (GB WhatsApp أو نسخ معدّلة).",
        "تلقّي تقارير متكررة من مستخدمين آخرين.",
        "انتهاك شروط الاستخدام بأي شكل.",
        "استخدام روبوتات أو برامج أتمتة.",
        "الإفراط في إنشاء مجموعات أو إضافة أشخاص دون إذنهم.",
      ].map(reason => (
        <li class="flex items-start gap-3">
          <span class="w-5 h-5 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" aria-hidden="true">!</span>
          {reason}
        </li>
      ))}
    </ul>

    <!-- Section 3: Steps -->
    <h2 class="text-2xl font-bold text-white mt-10 mb-4">خطوات فك حظر واتساب — التفصيل الكامل</h2>

    <h3 class="text-lg font-bold text-[#25D366] mt-6 mb-3">أولاً: إذا كان الحظر مؤقتاً</h3>
    <ol class="space-y-3 text-white/70 mb-6">
      <li class="flex gap-3"><span class="w-7 h-7 rounded-full bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30 flex items-center justify-center text-sm font-bold shrink-0">١</span><span>أغلق تطبيق واتساب تماماً — لا تفتحه.</span></li>
      <li class="flex gap-3"><span class="w-7 h-7 rounded-full bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30 flex items-center justify-center text-sm font-bold shrink-0">٢</span><span>انتظر المدة الظاهرة على الشاشة (24 ساعة أو أكثر).</span></li>
      <li class="flex gap-3"><span class="w-7 h-7 rounded-full bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30 flex items-center justify-center text-sm font-bold shrink-0">٣</span><span>بعد انتهاء المدة، افتح التطبيق — يجب أن يعمل مجدداً.</span></li>
      <li class="flex gap-3"><span class="w-7 h-7 rounded-full bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30 flex items-center justify-center text-sm font-bold shrink-0">٤</span><span>تجنب السبب الأصلي للحظر حتى لا تُحظر مجدداً.</span></li>
    </ol>

    <h3 class="text-lg font-bold text-white/80 mt-6 mb-3">ثانياً: إذا كان الحظر نهائياً</h3>
    <ol class="space-y-3 text-white/70 mb-6">
      <li class="flex gap-3"><span class="w-7 h-7 rounded-full bg-white/10 text-white border border-white/20 flex items-center justify-center text-sm font-bold shrink-0">١</span><span>افتح واتساب وستظهر رسالة "لا يمكن لهذا الحساب استخدام واتساب بعد الآن".</span></li>
      <li class="flex gap-3"><span class="w-7 h-7 rounded-full bg-white/10 text-white border border-white/20 flex items-center justify-center text-sm font-bold shrink-0">٢</span><span>ابحث عن زر "طلب مراجعة" في نفس الشاشة واضغط عليه.</span></li>
      <li class="flex gap-3"><span class="w-7 h-7 rounded-full bg-white/10 text-white border border-white/20 flex items-center justify-center text-sm font-bold shrink-0">٣</span><span>اكتب رسالة احترافية تشرح وضعك — بدون إفراط في التبرير.</span></li>
      <li class="flex gap-3"><span class="w-7 h-7 rounded-full bg-white/10 text-white border border-white/20 flex items-center justify-center text-sm font-bold shrink-0">٤</span><span>انتظر رد واتساب — قد يأخذ من أيام إلى أسابيع.</span></li>
    </ol>

    <!-- In-article CTA -->
    <div class="bg-gradient-to-l from-[#1A3C6E] to-[#0A1628] rounded-2xl p-6 my-8 text-white">
      <p class="font-semibold text-lg mb-2">لم تنجح بمفردك؟</p>
      <p class="text-white/70 text-sm mb-4">WFixerX تساعدك في إعداد طلب مراجعة احترافي يرفع فرص القبول.</p>
      <div class="flex flex-wrap gap-3">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">
          تواصل عبر واتساب
        </a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">
          أو تلغرام
        </a>
      </div>
    </div>

    <!-- Section 4: When Review is Rejected -->
    <h2 class="text-2xl font-bold text-white mt-10 mb-4">ماذا لو رُفض طلب المراجعة؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">
      رفض الطلب لا يعني نهاية الطريق. يمكن إعادة التقديم، لكن بطريقة مختلفة ومدروسة. المشكلة الأكثر شيوعاً أن معظم الناس يُقدّمون طلبات ضعيفة أو مكررة مما يقلل الفرص.
    </p>
    <ul class="space-y-2 text-white/70 mb-4">
      <li class="flex items-start gap-3"><span class="text-[#25D366] font-bold shrink-0">✓</span>انتظر فترة قبل إعادة التقديم (أسبوع على الأقل).</li>
      <li class="flex items-start gap-3"><span class="text-[#25D366] font-bold shrink-0">✓</span>غيّر صياغة رسالتك — لا تكرر نفس الكلمات.</li>
      <li class="flex items-start gap-3"><span class="text-[#25D366] font-bold shrink-0">✓</span>ركّز على الاستخدام المشروع للحساب وأهميته.</li>
      <li class="flex items-start gap-3"><span class="text-[#25D366] font-bold shrink-0">✓</span>تواصل مع WFixerX للحصول على مساعدة متخصصة في صياغة الطلب.</li>
    </ul>

    <!-- Section 5: When to seek help -->
    <h2 class="text-2xl font-bold text-white mt-10 mb-4">متى تحتاج مساعدة متخصصة؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">
      في هذه الحالات، من الأفضل الاستعانة بخدمة متخصصة مثل WFixerX:
    </p>
    <ul class="space-y-2 text-white/70 mb-4">
      <li class="flex items-start gap-3"><span class="text-orange-400 shrink-0">→</span>طلب المراجعة لا يظهر في التطبيق.</li>
      <li class="flex items-start gap-3"><span class="text-orange-400 shrink-0">→</span>رُفض طلبك أكثر من مرة.</li>
      <li class="flex items-start gap-3"><span class="text-orange-400 shrink-0">→</span>حسابك لنشاط تجاري وكل يوم يكلفك.</li>
      <li class="flex items-start gap-3"><span class="text-orange-400 shrink-0">→</span>لا تعرف سبب الحظر ولا كيف تصيغ طلباً مناسباً.</li>
    </ul>

    <!-- Topic Cluster Hub -->
    <h2 class="text-2xl font-bold text-white mt-12 mb-2">دليل حظر واتساب — جميع المواضيع</h2>
    <p class="text-white/50 text-sm mb-8">كل ما تحتاج معرفته منظّم في ثلاثة محاور</p>

    <div class="space-y-8">
      <!-- Cluster 1: أنواع الحظر -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-8 rounded-lg bg-[#25D366]/15 border border-[#25D366]/30 flex items-center justify-center text-[#25D366] text-sm font-bold">١</span>
          <h3 class="text-lg font-bold text-white">أنواع الحظر ومدده</h3>
        </div>
        <div class="grid sm:grid-cols-2 gap-3">
          {[
            { href: "/مدونة/أنواع-حظر-واتساب/", title: "أنواع حظر واتساب — الدليل الشامل" },
            { href: "/مدونة/فرق-حظر-واتساب-مؤقت-ونهائي/", title: "الفرق بين الحظر المؤقت والنهائي" },
            { href: "/مدونة/حظر-واتساب-24-ساعة/", title: "حظر واتساب 24 ساعة" },
            { href: "/مدونة/واتساب-محظور-7-أيام/", title: "واتساب محظور 7 أيام" },
            { href: "/مدونة/حظر-واتساب-مشدد/", title: "حظر واتساب المشدد" },
            { href: "/مدونة/واتساب-محظور-نهائياً/", title: "واتساب محظور نهائياً — هل يُسترد؟" },
            { href: "/مدونة/مدة-حظر-واتساب/", title: "مدة حظر واتساب" },
            { href: "/مدونة/كم-مدة-حظر-واتساب/", title: "كم مدة حظر واتساب؟" },
            { href: "/مدونة/علامات-حظر-واتساب/", title: "علامات حظر واتساب" },
            { href: "/مدونة/ماذا-تفعل-عند-حظر-واتساب-فجأة/", title: "ماذا تفعل عند الحظر فجأة؟" },
          ].map(link => (
            <a href={link.href} class="glass-dark rounded-xl px-4 py-3 border border-white/10 hover:border-[#25D366]/40 transition-colors group flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]/60 shrink-0"></span>
              <p class="text-sm font-medium text-white/75 group-hover:text-white transition-colors">{link.title}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Cluster 2: أسباب الحظر -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-8 rounded-lg bg-orange-500/15 border border-orange-500/30 flex items-center justify-center text-orange-400 text-sm font-bold">٢</span>
          <h3 class="text-lg font-bold text-white">أسباب الحظر والوقاية</h3>
        </div>
        <div class="grid sm:grid-cols-2 gap-3">
          {[
            { href: "/مدونة/أسباب-حظر-واتساب/", title: "أسباب حظر واتساب — الأكثر شيوعاً" },
            { href: "/مدونة/حظر-واتساب-بسبب-نسخة-معدلة/", title: "الحظر بسبب نسخة معدّلة" },
            { href: "/مدونة/حظر-واتساب-بسبب-الرسائل-الجماعية/", title: "الحظر بسبب الرسائل الجماعية" },
            { href: "/مدونة/حظر-واتساب-بسبب-الإبلاغ/", title: "الحظر بسبب الإبلاغ" },
            { href: "/مدونة/حظر-رقم-واتساب/", title: "حظر رقم واتساب — الفرق عن حظر الحساب" },
            { href: "/مدونة/كيف-تتجنب-حظر-واتساب/", title: "كيف تتجنب حظر واتساب — 10 قواعد" },
          ].map(link => (
            <a href={link.href} class="glass-dark rounded-xl px-4 py-3 border border-white/10 hover:border-orange-500/40 transition-colors group flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400/60 shrink-0"></span>
