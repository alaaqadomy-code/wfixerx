<BaseLayout title="واجهة واتساب الرسمية للأعمال — متى تحتاجها فعلاً؟" description="تطبيق واتساب للأعمال أم الواجهة الرسمية؟ الفرق في حدود الإرسال والحملات ومسار المراجعة، ومتى يكون الانتقال ضرورة لا ترقية، وكيف يحميك من الحظر المتكرر." schema={schema}>

  <nav class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
