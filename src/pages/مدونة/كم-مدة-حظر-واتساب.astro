      <div class="grid sm:grid-cols-2 gap-3">
        {[
          { href: "/فك-حظر-واتساب/", title: "دليل فك حظر واتساب الشامل" },
          { href: "/مدونة/حظر-واتساب-24-ساعة/", title: "حظر واتساب 24 ساعة — ماذا تفعل" },
