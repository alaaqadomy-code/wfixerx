---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const faqs = [
        { q: "أين أجد رابط طلب مراجعة واتساب؟", a: "رابط طلب مراجعة واتساب يظهر داخل التطبيق في رسالة الحظر. إذا لم يظهر، يمكن التقديم عبر موقع support.whatsapp.com." },
        { q: "هل يوجد رابط رسمي واحد لطلب المراجعة؟", a: "القناة الرسمية هي زر «طلب مراجعة» داخل التطبيق، وبديله موقع support.whatsapp.com وحده. لا يوجد نموذج رسمي آخر ولا رابط مختصر ولا صفحة وسيطة. أي رابط يُرسل إليك في رسالة أو يظهر في نتيجة بحث بعنوان مختلف عن هذا النطاق فهو صفحة احتيال تهدف إلى أخذ رمز التحقق. تحقق من شريط العنوان قبل كتابة أي شيء." },
        { q: "ماذا أفعل إذا رُفض طلب مراجعة واتساب؟", a: "إذا رُفض طلبك، انتظر بضعة أيام ثم أعد التقديم برسالة مختلفة. إذا تكرر الرفض، استشر متخصصاً لتقييم الحالة وإعداد طلب أفضل." },
        { q: "هل أستطيع تقديم طلب مراجعة من جهاز آخر؟", a: "نعم، يمكن تقديم الطلب من جهاز آخر عبر موقع support.whatsapp.com طالما تملك الرقم المحظور." },
        { q: "لماذا لا يظهر زر طلب المراجعة في تطبيقي؟", a: "غياب الزر غالباً دليل على نوع الحظر لا على خطأ تقني. فمع الحظر المؤقت يظهر عداد تنازلي بلا زر، لأن المدة تنتهي وحدها ولا شيء للمراجعة. وقد يغيب الزر أيضاً في إصدار قديم من التطبيق، فحدّثه من المتجر الرسمي، أو إن كنت تستخدم نسخة معدّلة فهي لا تعرضه أصلاً. وفي كل الحالات يبقى موقع support.whatsapp.com متاحاً من أي متصفح." },
      ];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "رابط طلب مراجعة واتساب — أين تجده وكيف تستخدمه",
    "description": "أين تجد رابط طلب مراجعة واتساب؟ دليل خطوة بخطوة لتقديم طلب مراجعة ناجح وما تفعله إذا رُفض الطلب.",
    "author": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "publisher": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "datePublished": "2026-10-13",
    "dateModified": "2026-10-13",
    "inLanguage": "ar",
    "url": "https://wfixerx.com/مدونة/رابط-طلب-مراجعة-واتساب/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.filter(f => !f.noSchema).map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
]);
---

<BaseLayout title="رابط طلب مراجعة واتساب — أين تجده وكيف تستخدمه" description="أين تجد رابط طلب مراجعة واتساب؟ دليل خطوة بخطوة لتقديم طلب مراجعة ناجح وما تكتبه وما تفعله إذا رُفض الطلب." schema={schema}>

  <nav class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#25D366]">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li><a href="/مدونة/" class="hover:text-[#25D366]">المدونة</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">رابط طلب مراجعة واتساب</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-[#040b18] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs text-white/40 mb-4">أكتوبر 2026 · وقت القراءة: 5 دقائق</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6">رابط طلب مراجعة واتساب — أين تجده وكيف تستخدمه</h1>
      <p class="text-lg text-white/60 leading-relaxed">
        حسابك محظور وتبحث عن رابط طلب مراجعة واتساب؟ هذا الرابط هو خط التواصل الرسمي الوحيد مع واتساب لطلب رفع الحظر. سواء كان يظهر داخل التطبيق أو كنت تبحث عنه خارجياً — هذا الدليل يشرح بالتفصيل أين تجده، ماذا تكتب، وما تفعله إذا رُفض طلبك.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <!-- Quick Answer -->
    <div class="relative rounded-2xl overflow-hidden border border-[#25D366]/20 bg-gradient-to-br from-[#0a1628] to-[#041a0c] p-7 mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-9 h-9 bg-gradient-to-br from-[#25D366] to-[#1de9b6] rounded-xl flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p class="text-xs font-semibold text-[#25D366] uppercase tracking-wider">إجابة مباشرة</p>
      </div>
      <h2 class="text-xl font-bold text-white mb-3">أين أجد رابط طلب مراجعة واتساب؟</h2>
      <p class="text-white/70 leading-relaxed">رابط طلب مراجعة واتساب يظهر مباشرةً داخل التطبيق في رسالة الحظر — ابحث عن زر أو رابط "طلب المراجعة". إذا لم يظهر داخل التطبيق، يمكنك التقديم عبر الموقع الرسمي support.whatsapp.com من أي جهاز آخر باستخدام رقمك المحظور.</p>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">أين يظهر رابط طلب المراجعة؟</h2>
    <p class="text-white/70 leading-relaxed mb-6">
      واتساب توفر رابط أو زر طلب المراجعة في مكانين رئيسيين. كلاهما رسمي ويؤدي لنفس النتيجة:
    </p>

    <div class="grid sm:grid-cols-2 gap-4 mb-8">
      <div class="bg-[#0a1628] border border-[#25D366]/20 rounded-2xl p-6">
        <div class="w-10 h-10 bg-[#25D366]/10 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-[#25D366]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-base font-bold text-white mb-2">داخل التطبيق</h3>
        <p class="text-white/60 text-sm leading-relaxed">عند فتح واتساب تظهر رسالة الحظر. ابحث عن زر "طلب المراجعة" أو رابط "اتصل بنا" في أسفل الرسالة. هذا الخيار متاح في حالات الحظر المشدد في الغالب.</p>
      </div>
      <div class="bg-[#0a1628] border border-[#25D366]/20 rounded-2xl p-6">
        <div class="w-10 h-10 bg-[#25D366]/10 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-[#25D366]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
        </div>
        <h3 class="text-base font-bold text-white mb-2">عبر الموقع الرسمي</h3>
        <p class="text-white/60 text-sm leading-relaxed">توجّه إلى support.whatsapp.com من أي متصفح على أي جهاز. هذا الخيار متاح حتى لو لم يظهر زر المراجعة داخل التطبيق، وهو الحل عند الحظر النهائي.</p>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">ماذا تكتب في طلب المراجعة؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">
      رسالة طلب المراجعة هي فرصتك الوحيدة للتواصل مع فريق واتساب. اجعلها مختصرة ومهنية وصادقة. إليك الإطار المثالي للرسالة:
    </p>

    <div class="bg-[#0a1628] border border-white/8 rounded-2xl p-6 mb-8">
      <h3 class="text-base font-bold text-[#25D366] mb-4">إطار رسالة المراجعة المثالية</h3>
      <ul class="space-y-3">
        {[
          { label: "التعريف بنفسك", text: "ذكر رقم هاتفك مع رمز الدولة، والمدة التي تستخدم فيها واتساب." },
          { label: "شرح المشكلة بإيجاز", text: "أخبرهم أن حسابك تم إيقافه وأنك تود معرفة السبب وإصلاح الأمر." },
          { label: "نفي الانتهاك أو الاعتراف وتصحيحه", text: "إذا لم تكن تعلم السبب، أكّد ذلك. إذا كنت تعلم، أكد أنك أصلحت المشكلة." },
          { label: "الالتزام بالسياسات", text: "أكد رغبتك في الامتثال الكامل لشروط استخدام واتساب." },
          { label: "طلب واضح", text: "اطلب صراحةً إعادة تفعيل الحساب أو الحصول على توضيح." },
        ].map(item => (
          <li class="flex gap-3">
            <span class="text-[#25D366] mt-0.5 shrink-0">▸</span>
            <div>
              <span class="font-semibold text-white text-sm">{item.label}: </span>
              <span class="text-white/60 text-sm">{item.text}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Mid CTA -->
    <div class="bg-gradient-to-br from-[#0d2844] to-[#041a0c] rounded-2xl p-6 my-10 border border-[#25D366]/15 text-center">
      <p class="font-semibold text-white mb-2">تحتاج مساعدة متخصصة؟</p>
      <p class="text-white/50 text-sm mb-4">تواصل معنا وسنساعدك في تقييم حالتك مجاناً</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تواصل عبر تلغرام</a>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">ماذا تفعل إذا رُفض طلب المراجعة؟</h2>
    <p class="text-white/70 leading-relaxed mb-6">
      رفض الطلب ليس نهاية الطريق. هناك خطوات منطقية يمكن اتخاذها بعد الرفض:
    </p>

    <ol class="space-y-4 mb-8">
      {[
        { title: "انتظر على الأقل 3 أيام", desc: "لا تعيد التقديم فوراً. انتظر فترة كافية قبل أي محاولة جديدة." },
        { title: "غيّر صياغة رسالتك", desc: "لا ترسل نفس الرسالة مرتين. اعمل على تحسينها وتوضيح نقاط مختلفة." },
        { title: "جرّب القناة الأخرى", desc: "إذا جربت عبر التطبيق، جرّب عبر الموقع الرسمي، والعكس صحيح." },
        { title: "استشر متخصصاً", desc: "إذا تكرر الرفض، هذا مؤشر أن الحالة تحتاج تقييماً متخصصاً لمعرفة الأسباب الحقيقية والخطوات المناسبة." },
      ].map((step, i) => (
        <li class="flex gap-4 bg-[#0a1628] border border-white/8 rounded-xl p-4">
          <span class="w-7 h-7 rounded-full bg-[#25D366]/20 text-[#25D366] flex items-center justify-center font-bold shrink-0 mt-0.5 text-sm">{i + 1}</span>
          <div>
            <p class="font-bold text-white text-sm mb-1">{step.title}</p>
            <p class="text-white/60 text-sm leading-relaxed">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- FAQ Section -->
    <h2 class="text-2xl font-bold text-white mt-12 mb-6">أسئلة شائعة</h2>
    <div class="space-y-3">
      {faqs.map(item => (
        <details class="bg-[#0a1628] border border-white/8 rounded-xl overflow-hidden">
          <summary class="p-4 font-semibold text-white cursor-pointer hover:bg-white/5 transition-colors">{item.q}</summary>
          <p class="px-4 pb-4 text-white/60 text-sm leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>

    <!-- Internal Links -->
    <div class="mt-12 pt-8 border-t border-white/8">
      <h3 class="text-lg font-bold text-white mb-4">مقالات ذات صلة</h3>
      <div class="grid sm:grid-cols-2 gap-3">
        {[
          { href: "/طلب-مراجعة-واتساب/", title: "دليل طلب مراجعة واتساب الشامل" },
          { href: "/فك-حظر-واتساب/", title: "دليل فك حظر واتساب" },
          { href: "/خدمة-فك-حظر-واتساب/", title: "خدمة فك حظر واتساب" },
          { href: "/مدونة/دعم-واتساب-لفك-الحظر/", title: "دعم واتساب لفك الحظر" },
        ].map(link => (
          <a href={link.href} class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group">
            <p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">{link.title} ←</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Final CTA -->
    <div class="bg-gradient-to-br from-[#0d2844] to-[#041a0c] rounded-2xl p-6 mt-10 border border-[#25D366]/15 text-center">
      <p class="font-semibold text-white mb-2">رُفض طلبك ولا تعرف ماذا تفعل؟</p>
      <p class="text-white/50 text-sm mb-4">تواصل معنا وسنساعدك في إعداد طلب مراجعة أقوى</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تواصل عبر تلغرام</a>
      </div>
    </div>

  </article>
</BaseLayout>
