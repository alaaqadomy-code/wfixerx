---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "حظر واتساب المشدد — ما هو وكيف تفكه",
    "description": "شرح مفصل لحظر واتساب المشدد: علاماته، أسبابه، وكيفية رفعه عبر طلب المراجعة الرسمي.",
    "author": { "@type": "Organization", "name": "WFixerX" },
    "dateModified": "2026-10-13",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "ما الفرق بين الحظر المؤقت والمشدد في واتساب؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "الحظر المؤقت يُرفع تلقائياً بعد 24-72 ساعة. الحظر المشدد يستمر لفترة أطول ويحتاج طلب مراجعة رسمي. الحظر النهائي لا يمكن رفعه بطلب مراجعة عادي."
        }
      },
      {
        "@type": "Question",
        "name": "كم يستغرق رفع الحظر المشدد؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "واتساب لا تُحدد مدة ثابتة. في الغالب تتراوح بين أسبوع وعدة أسابيع بعد تقديم طلب المراجعة."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://wfixerx.com" },
      { "@type": "ListItem", "position": 2, "name": "المدونة", "item": "https://wfixerx.com/مدونة/" },
      { "@type": "ListItem", "position": 3, "name": "حظر واتساب المشدد", "item": "https://wfixerx.com/مدونة/حظر-واتساب-مشدد/" }
    ]
  }
]);
---

<BaseLayout
  title="حظر واتساب المشدد — ما هو وكيف تفكه"
  description="تعرّف على حظر واتساب المشدد: علاماته وأسبابه وكيفية تقديم طلب مراجعة ناجح لاسترداد حسابك."
  schema={schema}
>

  <nav class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-gray-400 flex-wrap">
      <li><a href="/" class="hover:text-[#1A3C6E]">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li><a href="/مدونة/" class="hover:text-[#1A3C6E]">المدونة</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-gray-700 font-medium">حظر واتساب المشدد</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-red-50 to-white py-12 px-4 sm:px-6 border-b border-gray-100">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs text-gray-400 mb-4">أكتوبر 2026 · وقت القراءة: 5 دقائق</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-[#0A1628] leading-tight mb-6">
        حظر واتساب المشدد — ما هو وكيف تفكه
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        الحظر المشدد أصعب من الحظر العادي ولا يُرفع تلقائياً — لكنه ليس نهائياً في كل الحالات. هذه المقالة تشرح ما يميّزه وكيف تتعامل معه.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="quick-answer mb-10">
      <p class="text-xs font-semibold text-[#1A3C6E] uppercase tracking-wider mb-2">الجواب السريع</p>
      <h2 class="text-xl font-bold text-[#0A1628] mb-3">ما هو حظر واتساب المشدد وكيف يُفك؟</h2>
      <p class="text-gray-700">حظر واتساب المشدد هو تقييد موسّع يستمر لأسابيع ولا يُرفع تلقائياً. يحدث عادةً بعد تكرار المخالفات أو استخدام نسخ معدّلة. للتعامل معه: <strong>1.</strong> توقف عن أي نشاط مخالف. <strong>2.</strong> قدّم طلب مراجعة رسمي. <strong>3.</strong> انتظر الرد وتواصل مع متخصص إذا احتجت مساعدة.</p>
    </div>

    <h2 class="text-2xl font-bold text-[#0A1628] mt-10 mb-4">ما هو حظر واتساب المشدد؟</h2>
    <p class="text-gray-700 leading-relaxed mb-6">
      حظر واتساب المشدد هو نوع متقدم من الحظر يقع بين الحظر المؤقت (24-72 ساعة) والحظر النهائي. يعني أن واتساب رصدت مخالفات متكررة أو جدية في استخدام الحساب وقررت تعليقه لفترة طويلة مع إمكانية المراجعة.
    </p>

    <h2 class="text-2xl font-bold text-[#0A1628] mt-10 mb-4">مقارنة أنواع الحظر</h2>
    <div class="overflow-x-auto mb-8">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="bg-[#0A1628] text-white">
            <th class="p-3 text-right font-semibold">النوع</th>
            <th class="p-3 text-right font-semibold">المدة</th>
            <th class="p-3 text-right font-semibold">الحل</th>
            <th class="p-3 text-right font-semibold">الصعوبة</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-200 bg-green-50">
            <td class="p-3 font-medium">مؤقت</td>
            <td class="p-3">24-72 ساعة</td>
            <td class="p-3">انتظار</td>
            <td class="p-3 text-green-700 font-medium">سهل</td>
          </tr>
          <tr class="border-b border-gray-200 bg-orange-50">
            <td class="p-3 font-medium">مشدد</td>
            <td class="p-3">أسابيع</td>
            <td class="p-3">طلب مراجعة</td>
            <td class="p-3 text-orange-700 font-medium">متوسط</td>
          </tr>
          <tr class="border-b border-gray-200 bg-red-50">
            <td class="p-3 font-medium">نهائي</td>
            <td class="p-3">دائم</td>
            <td class="p-3">مراجعة قانونية / مساعدة متخصصة</td>
            <td class="p-3 text-red-700 font-medium">صعب</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-[#0A1628] mt-10 mb-4">علامات الحظر المشدد</h2>
    <ul class="space-y-3 text-gray-700 mb-8">
      {[
        "تظهر رسالة الحظر مع عدّاد يمتد لأسبوع أو أكثر.",
        'ظهور رسالة "هذا الحساب لا يمكنه استخدام واتساب" بدون عدّاد.',
        "عدم استجابة التطبيق رغم إعادة التثبيت.",
        "استمرار الحظر بعد انتهاء المدة المذكورة.",
        "رفض طلب المراجعة الأول مع إمكانية إعادة التقديم.",
      ].map(s => (
        <li class="flex items-start gap-3">
          <span class="text-red-500 font-bold shrink-0 mt-0.5">!</span>
          {s}
        </li>
      ))}
    </ul>

    <h2 class="text-2xl font-bold text-[#0A1628] mt-10 mb-4">أسباب الحظر المشدد</h2>
    <ul class="space-y-2 text-gray-700 mb-8">
      {[
        "تكرار الحظر المؤقت عدة مرات خلال فترة قصيرة.",
        "استخدام نسخ معدّلة (GB WhatsApp) لفترة طويلة.",
        "تلقي عدد كبير من التقارير من مستخدمين مختلفين.",
        "إرسال محتوى مخالف بشكل موثّق.",
        "نشاط مشبوه (استخدام من عدة أجهزة في نفس الوقت).",
      ].map(c => (
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-orange-400 shrink-0 mt-2"></span>
          {c}
        </li>
      ))}
    </ul>

    <h2 class="text-2xl font-bold text-[#0A1628] mt-10 mb-6">خطوات رفع الحظر المشدد</h2>
    <ol class="space-y-4 mb-8">
      {[
        {
          title: "أوقف كل نشاط مخالف فوراً",
          desc: "إذا كنت تستخدم نسخة معدّلة، احذفها واحذف ملفاتها. إذا كنت ترسل رسائل جماعية، أوقف ذلك تماماً."
        },
        {
          title: "اضغط على 'طلب المراجعة' داخل التطبيق",
          desc: "إذا ظهر الزر، استخدمه. أدخل رقم الهاتف بدقة مع رمز الدولة."
        },
        {
          title: "اكتب رسالة مراجعة احترافية",
          desc: "اشرح أنك لم تنتهك السياسات عمداً، أو أن المشكلة حُلّت. كن صادقاً ومختصراً."
        },
        {
          title: "جرّب عبر support.whatsapp.com",
          desc: "إذا لم تظهر خيار المراجعة داخل التطبيق، توجّه لموقع الدعم الرسمي وقدّم طلباً هناك."
        },
        {
          title: "انتظر الرد — قد يستغرق أسبوعين",
          desc: "واتساب لا تُخبرك بمدة محددة. لا تقدّم طلبات متكررة — هذا يؤخر الرد."
        },
      ].map((step, i) => (
        <li class="flex gap-4">
          <span class="w-8 h-8 rounded-full bg-[#1A3C6E] text-white flex items-center justify-center font-bold shrink-0 mt-0.5 text-sm">{i + 1}</span>
          <div>
            <p class="font-bold text-[#0A1628] mb-1">{step.title}</p>
            <p class="text-gray-600 text-sm leading-relaxed">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 mb-8">
      <p class="font-bold text-amber-800 mb-2">تنبيه مهم</p>
      <p class="text-amber-700 text-sm leading-relaxed">لا تشارك أبداً كلمة مرورك أو رمز التحقق (OTP) مع أي شخص يدّعي قدرته على فك الحظر. WFixerX لا تطلب هذه المعلومات أبداً.</p>
    </div>

    <div class="bg-[#0A1628] rounded-2xl p-6 text-white text-center mb-10">
      <p class="font-semibold mb-2">حظرك مشدد ولم تنجح وحدك؟</p>
      <p class="text-white/60 text-sm mb-5">نساعدك في إعداد طلب مراجعة احترافي يرفع فرص النجاح</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تلغرام</a>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-[#0A1628] mb-4">الأسئلة الشائعة</h2>
    <div class="space-y-3 mb-10">
      {[
        {
          q: "ما الفرق بين الحظر المؤقت والمشدد في واتساب؟",
          a: "الحظر المؤقت يُرفع تلقائياً بعد 24-72 ساعة. الحظر المشدد يستمر لأسابيع ويحتاج طلب مراجعة رسمي. الحظر النهائي لا يمكن رفعه بطلب مراجعة عادي."
        },
        {
          q: "كم يستغرق رفع الحظر المشدد؟",
          a: "واتساب لا تُحدد مدة ثابتة. في الغالب تتراوح بين أسبوع وعدة أسابيع بعد تقديم طلب المراجعة."
        },
        {
          q: "هل يمكن رفع الحظر المشدد من أول محاولة؟",
          a: "نعم، إذا كانت رسالة المراجعة مقنعة والحالة قابلة للحل. لكن البعض يحتاج أكثر من محاولة."
        },
      ].map(item => (
        <details class="bg-gray-50 border border-gray-200 rounded-xl overflow-hidden">
          <summary class="p-4 font-semibold text-[#0A1628] cursor-pointer hover:bg-gray-100 transition-colors">{item.q}</summary>
          <p class="px-4 pb-4 text-gray-600 text-sm leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>

    <div class="grid sm:grid-cols-3 gap-4">
      {[
        { href: "/فك-حظر-واتساب/", title: "دليل فك الحظر الشامل" },
        { href: "/طلب-مراجعة-واتساب/", title: "كيفية طلب المراجعة" },
        { href: "/مدونة/أسباب-حظر-واتساب/", title: "أسباب الحظر" },
      ].map(link => (
        <a href={link.href} class="bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-[#1A3C6E] hover:bg-blue-50 transition-colors group">
          <p class="font-semibold text-[#0A1628] text-sm group-hover:text-[#1A3C6E]">{link.title} ←</p>
        </a>
      ))}
    </div>

  </article>
</BaseLayout>
