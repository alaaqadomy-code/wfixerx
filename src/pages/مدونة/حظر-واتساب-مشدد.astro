const TG_LINK = "https://t.me/+962795827790";

const faqs = [
        {
          q: "ما الفرق بين الحظر المؤقت والمشدد في واتساب؟",
          a: "الحظر المؤقت يُرفع تلقائياً بعد 24-72 ساعة. الحظر المشدد يستمر لأسابيع ويحتاج طلب مراجعة رسمي. الحظر النهائي لا يمكن رفعه بطلب مراجعة عادي."
        },
        {
          q: "كم يستغرق رفع الحظر المشدد؟",
          a: "واتساب لا تُحدد مدة ثابتة. في الغالب تتراوح بين أسبوع وعدة أسابيع بعد تقديم طلب المراجعة."
        },
        {
          q: "هل يمكن رفع الحظر المشدد من أول محاولة؟",
          a: "نعم، إذا كانت رسالة المراجعة مقنعة والحالة قابلة للحل. لكن البعض يحتاج أكثر من محاولة."
        },
        {
          q: "هل الحظر المشدد دائم؟",
          a: "لا، الحظر المشدد ليس دائماً في معظم الحالات. يمكن رفعه بطلب مراجعة رسمي وانتظار قرار فريق واتساب."
        },
        {
          q: "ماذا أفعل إذا رفض واتساب طلب المراجعة؟",
          a: "إذا رُفض الطلب، يمكن إعادة التقديم بعد فترة مع تقديم تفاصيل إضافية. يمكن أيضاً التواصل مع متخصصين في استرداد الحسابات للمساعدة."
        },
  { q: "هل أقدّم طلب مراجعة الحظر المشدد فوراً أم أنتظر؟", a: "قدّمه بعد أن تعالج السبب لا قبله. احذف النسخة المعدّلة أو أوقف أداة الإرسال أولاً، ثم اكتب طلباً واحداً يذكر ما غيّرته. التقديم المتعجل قبل المعالجة يضيّع فرصة الطلب الأول." },
  { q: "هل يمكنني استخدام واتساب ويب لتجاوز الحظر المشدد؟", a: "لا. واتساب ويب والأجهزة المرتبطة امتداد للحساب نفسه وليست حساباً مستقلاً، فلا تتجاوز الحظر الواقع على الرقم. ومحاولة الالتفاف عليه بأي وسيلة، بجهاز آخر أو تطبيق آخر، قد تُقرأ إصراراً على المخالفة وتضعف طلب المراجعة." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "حظر واتساب المشدد — ما هو وكيف تفكه",
    "description": "شرح مفصل لحظر واتساب المشدد: علاماته، أسبابه، وكيفية رفعه عبر طلب المراجعة الرسمي.",
