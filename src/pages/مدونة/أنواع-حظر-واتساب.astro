---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const faqs = [
        { q: "ما هي أنواع حظر واتساب؟", a: "أنواع حظر واتساب الرئيسية هي: المؤقت (24-72 ساعة)، المشدد (أسابيع)، النهائي (دائم)، وحظر الأعمال. كل نوع له علامات وخطوات تعامل مختلفة." },
        { q: "ما الفرق بين الحظر المؤقت والنهائي؟", a: "الحظر المؤقت يُرفع تلقائياً خلال 24-72 ساعة. الحظر النهائي لا يُرفع تلقائياً ولا عداد له ويحتاج طلب مراجعة أو تدخلاً متخصصاً." },
        { q: "هل حظر واتساب بزنس مختلف عن الحظر العادي؟", a: "نعم، حظر واتساب بزنس له آليات مختلفة بسبب طبيعة الاستخدام التجاري. يتطلب إثبات امتثال إضافي لسياسات البزنس." },
        { q: "كيف أعرف نوع حظري في واتساب؟", a: "انظر إلى رسالة الحظر: إذا كان هناك عداد فهو مؤقت، إذا كان هناك زر مراجعة فهو مشدد، وإذا لم يكن هناك أي منهما فهو نهائي في الغالب." },
        { q: "أي أنواع الحظر يمكن فكه؟", a: "الحظر المؤقت يُفك تلقائياً. الحظر المشدد قابل للفك بطلب مراجعة. الحظر النهائي أصعب لكن بعض حالاته قابلة للمعالجة. حظر الأعمال يتطلب إثبات الامتثال." },
  { q: "أي نوع حظر هو الأخطر؟", a: "الأخطر ليس النهائي بل المشدد الذي يُهمَل. فالحظر المؤقت ينتهي وحده، والنهائي واضح ويدفع صاحبه إلى التصرف فوراً. أما المشدد فلا عداد له فيظنّه صاحبه مؤقتاً وينتظر أسابيع بلا فائدة، وفي أثناء ذلك تضيع أفضل أوقات تقديم طلب المراجعة. وقد يتحول إلى نهائي إن تكرر السلوك. فالقاعدة: غياب العداد يعني أن الانتظار ليس خطتك." },
  { q: "هل يختلف نوع الحظر بين الأندرويد والآيفون؟", a: "لا. الحظر قرار يُتخذ على رقمك في سجلات واتساب لا على نظام تشغيل جهازك، وأنواعه ومدده ومسار المراجعة واحدة في الأندرويد والآيفون. ما يختلف فعلاً هو موضع النسخ الاحتياطي: Google Drive في الأندرويد وiCloud في الآيفون، ولهذا لا تنتقل المحادثات تلقائياً بين النظامين. وتسجيل الرقم المحظور على جهاز بنظام آخر لا يتجاوز الحظر." },
  { q: "هل حظر حساب الأعمال نوع مختلف؟", a: "نعم، وله مساره الخاص. حسابات الأعمال تخضع لسياسات تجارية إضافية، ويسبق تقييدها غالباً هبوط في تقييم جودة الحساب، وقد يُقيَّد الكتالوج وحده دون الحساب كله. ومراجعة حسابات واجهة واتساب الرسمية للأعمال تُدار من لوحة إدارة الحساب التجاري لا من زر داخل التطبيق، وقد يُطلب فيها ما يثبت نشاط النشاط التجاري." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "أنواع حظر واتساب — مقارنة شاملة بين المؤقت والمشدد والنهائي",
    "description": "تعرف على جميع أنواع حظر واتساب: المؤقت والمشدد والنهائي وحظر الأعمال. جدول مقارنة شامل وكيف تتعامل مع كل نوع.",
    "author": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "publisher": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "datePublished": "2026-10-13",
    "dateModified": "2026-10-13",
    "inLanguage": "ar",
    "url": "https://wfixerx.com/مدونة/أنواع-حظر-واتساب/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.filter(f => !f.noSchema).map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
]);
---

<BaseLayout title="أنواع حظر واتساب — مقارنة شاملة بين المؤقت والمشدد والنهائي" description="تعرف على جميع أنواع حظر واتساب: المؤقت والمشدد والنهائي وحظر الأعمال. جدول مقارنة شامل وكيف تتعامل مع كل نوع." schema={schema}>

  <nav class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#25D366]">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li><a href="/مدونة/" class="hover:text-[#25D366]">المدونة</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">أنواع حظر واتساب</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-[#040b18] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs text-white/40 mb-4">أكتوبر 2026 · وقت القراءة: 7 دقائق</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6">أنواع حظر واتساب — مقارنة شاملة بين المؤقت والمشدد والنهائي</h1>
      <p class="text-lg text-white/60 leading-relaxed">
        ليس كل حظر في واتساب متساوياً. هناك أنواع مختلفة تماماً في طبيعتها وشدتها وطريقة التعامل معها. معرفة نوع حظرك بدقة هي الخطوة الأولى والأهم نحو الحل الصحيح. هذه المقالة تقدم مقارنة شاملة لجميع أنواع الحظر المعروفة مع جدول مرجعي سهل الاستخدام.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <!-- Quick Answer -->
    <div class="relative rounded-2xl overflow-hidden border border-[#25D366]/20 bg-gradient-to-br from-[#0a1628] to-[#041a0c] p-7 mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-9 h-9 bg-gradient-to-br from-[#25D366] to-[#1de9b6] rounded-xl flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p class="text-xs font-semibold text-[#25D366] uppercase tracking-wider">إجابة مباشرة</p>
      </div>
      <h2 class="text-xl font-bold text-white mb-3">ما هي أنواع حظر واتساب؟</h2>
      <p class="text-white/70 leading-relaxed">أنواع حظر واتساب الرئيسية هي: الحظر المؤقت (24-72 ساعة ويُرفع تلقائياً)، الحظر المشدد (أسابيع ويحتاج طلب مراجعة)، الحظر النهائي (دائم ويحتاج تدخلاً متخصصاً في أغلب الأحيان)، وحظر حساب الأعمال (يتطلب إثبات الامتثال). كل نوع له علامات مميزة وطريقة تعامل مختلفة.</p>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">جدول مقارنة أنواع حظر واتساب</h2>

    <div class="overflow-x-auto mb-10">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-[#0a1628] border border-white/10">
            <th class="p-3 text-right text-white font-bold">النوع</th>
            <th class="p-3 text-right text-white font-bold">المدة</th>
            <th class="p-3 text-right text-white font-bold">عداد زمني</th>
            <th class="p-3 text-right text-white font-bold">الحل</th>
            <th class="p-3 text-right text-white font-bold">الصعوبة</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border border-white/8 bg-[#0a1628]">
            <td class="p-3 text-[#25D366] font-medium">مؤقت خفيف</td>
            <td class="p-3 text-white/70">24 ساعة</td>
            <td class="p-3 text-[#25D366]">نعم</td>
            <td class="p-3 text-white/70">انتظار</td>
            <td class="p-3"><span class="text-xs bg-green-500/20 text-green-400 px-2 py-0.5 rounded-full">سهل</span></td>
          </tr>
          <tr class="border border-white/8 bg-[#0d1e30]">
            <td class="p-3 text-yellow-400 font-medium">مؤقت متوسط</td>
            <td class="p-3 text-white/70">72 ساعة — أسبوع</td>
            <td class="p-3 text-[#25D366]">نعم</td>
            <td class="p-3 text-white/70">انتظار + إصلاح السلوك</td>
            <td class="p-3"><span class="text-xs bg-green-500/20 text-green-400 px-2 py-0.5 rounded-full">سهل</span></td>
          </tr>
          <tr class="border border-white/8 bg-[#0a1628]">
            <td class="p-3 text-orange-400 font-medium">مشدد</td>
            <td class="p-3 text-white/70">أسابيع</td>
            <td class="p-3 text-orange-400">لا دائماً</td>
            <td class="p-3 text-white/70">طلب مراجعة</td>
            <td class="p-3"><span class="text-xs bg-orange-500/20 text-orange-400 px-2 py-0.5 rounded-full">متوسط</span></td>
          </tr>
          <tr class="border border-white/8 bg-[#0d1e30]">
            <td class="p-3 text-red-400 font-medium">نهائي</td>
            <td class="p-3 text-white/70">دائم</td>
            <td class="p-3 text-red-400">لا</td>
            <td class="p-3 text-white/70">مراجعة + متخصص</td>
            <td class="p-3"><span class="text-xs bg-red-500/20 text-red-400 px-2 py-0.5 rounded-full">صعب</span></td>
          </tr>
          <tr class="border border-white/8 bg-[#0a1628]">
            <td class="p-3 text-blue-400 font-medium">أعمال (بزنس)</td>
            <td class="p-3 text-white/70">متغير</td>
            <td class="p-3 text-blue-400">متغير</td>
            <td class="p-3 text-white/70">إثبات الامتثال</td>
            <td class="p-3"><span class="text-xs bg-blue-500/20 text-blue-400 px-2 py-0.5 rounded-full">متوسط-صعب</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">شرح تفصيلي لكل نوع</h2>

    <!-- Type 1 -->
    <div class="bg-[#0a1628] border border-[#25D366]/20 rounded-2xl p-6 mb-4">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-3 h-3 rounded-full bg-[#25D366] shrink-0"></span>
        <h3 class="text-lg font-bold text-[#25D366]">الحظر المؤقت (24-72 ساعة)</h3>
      </div>
      <p class="text-white/70 text-sm leading-relaxed mb-3">أخف أنواع الحظر. يظهر عداد ينقص الوقت المتبقي. يُرفع تلقائياً عند انتهاء المدة. يحدث عادةً بعد إرسال رسائل متكررة لأشخاص لا يعرفونك أو تلقي تقارير محدودة.</p>
      <p class="font-medium text-white text-sm">الإجراء: <span class="text-white/60 font-normal">انتظر بهدوء وتوقف عن السلوك الذي سبب الحظر.</span></p>
    </div>

    <!-- Type 2 -->
    <div class="bg-[#0a1628] border border-orange-500/20 rounded-2xl p-6 mb-4">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-3 h-3 rounded-full bg-orange-400 shrink-0"></span>
        <h3 class="text-lg font-bold text-orange-400">الحظر المشدد (أسابيع)</h3>
      </div>
      <p class="text-white/70 text-sm leading-relaxed mb-3">يحدث بعد تكرار الحظر المؤقت أو بعد انتهاكات أكثر جدية. لا ينتهي تلقائياً في الغالب. يحتاج تقديم طلب مراجعة رسمي. مدته تتراوح بين أسبوع وعدة أسابيع بعد تقديم طلب ناجح.</p>
      <p class="font-medium text-white text-sm">الإجراء: <span class="text-white/60 font-normal">قدّم طلب مراجعة احترافياً عبر التطبيق أو support.whatsapp.com.</span></p>
    </div>

    <!-- Type 3 -->
    <div class="bg-[#0a1628] border border-red-500/20 rounded-2xl p-6 mb-4">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-3 h-3 rounded-full bg-red-400 shrink-0"></span>
        <h3 class="text-lg font-bold text-red-400">الحظر النهائي (دائم)</h3>
      </div>
      <p class="text-white/70 text-sm leading-relaxed mb-3">أشد أنواع الحظر. لا عداد، لا رفع تلقائي. يحدث بعد انتهاكات جسيمة متكررة أو استخدام نسخ معدلة لفترة طويلة. بعض الحالات قابلة للمعالجة لكنها تحتاج جهداً أكبر وخبرة متخصصة.</p>
      <p class="font-medium text-white text-sm">الإجراء: <span class="text-white/60 font-normal">قيّم الحالة بدقة قبل أي خطوة، واستشر متخصصاً إذا لزم الأمر.</span></p>
    </div>

    <!-- Type 4 -->
    <div class="bg-[#0a1628] border border-blue-500/20 rounded-2xl p-6 mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-3 h-3 rounded-full bg-blue-400 shrink-0"></span>
        <h3 class="text-lg font-bold text-blue-400">حظر حساب الأعمال (واتساب بزنس)</h3>
      </div>
      <p class="text-white/70 text-sm leading-relaxed mb-3">حسابات واتساب بزنس لها سياسات إضافية خاصة بالاستخدام التجاري. يمكن حظرها بسبب انتهاك سياسات الرسائل الترويجية أو الإرسال الجماعي غير المصرّح به. الحل يتطلب إثبات الامتثال لسياسات واتساب بزنس.</p>
      <p class="font-medium text-white text-sm">الإجراء: <span class="text-white/60 font-normal">راجع سياسات واتساب بزنس وقدّم إثباتاً بالامتثال في طلب المراجعة.</span></p>
    </div>

    <!-- Mid CTA -->
    <div class="bg-gradient-to-br from-[#0d2844] to-[#041a0c] rounded-2xl p-6 my-10 border border-[#25D366]/15 text-center">
      <p class="font-semibold text-white mb-2">تحتاج مساعدة متخصصة؟</p>
      <p class="text-white/50 text-sm mb-4">تواصل معنا وسنساعدك في تقييم حالتك مجاناً</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تواصل عبر تلغرام</a>
      </div>
    </div>

    <!-- FAQ Section -->
    <h2 class="text-2xl font-bold text-white mt-12 mb-6">أسئلة شائعة</h2>
    <div class="space-y-3">
      {faqs.map(item => (
        <details class="bg-[#0a1628] border border-white/8 rounded-xl overflow-hidden">
          <summary class="p-4 font-semibold text-white cursor-pointer hover:bg-white/5 transition-colors">{item.q}</summary>
          <p class="px-4 pb-4 text-white/60 text-sm leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>

    <!-- Internal Links -->
    <div class="mt-12 pt-8 border-t border-white/8">
      <h3 class="text-lg font-bold text-white mb-4">مقالات ذات صلة</h3>
      <div class="grid sm:grid-cols-2 gap-3">
        {[
          { href: "/فك-حظر-واتساب/", title: "دليل فك حظر واتساب الشامل" },
          { href: "/حظر-واتساب/", title: "صفحة حظر واتساب" },
          { href: "/مدونة/كم-مدة-حظر-واتساب/", title: "كم مدة حظر واتساب؟" },
          { href: "/مدونة/حظر-واتساب-مشدد/", title: "حظر واتساب المشدد" },
        ].map(link => (
          <a href={link.href} class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group">
            <p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">{link.title} ←</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Final CTA -->
    <div class="bg-gradient-to-br from-[#0d2844] to-[#041a0c] rounded-2xl p-6 mt-10 border border-[#25D366]/15 text-center">
      <p class="font-semibold text-white mb-2">لا تعرف نوع حظرك؟</p>
      <p class="text-white/50 text-sm mb-4">تواصل معنا وسنساعدك في التشخيص والحل المناسب</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تواصل عبر تلغرام</a>
      </div>
    </div>

  </article>
</BaseLayout>
