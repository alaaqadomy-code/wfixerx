<BaseLayout title="استرجاع حساب واتساب بدون رقم — ما الممكن حقاً وما المستحيل؟" description="فقدت شريحتك أو رقمك القديم مغلق؟ الحقيقة الكاملة عن استرجاع حساب واتساب بدون الوصول للرقم: الحالات الممكنة عبر استعادة الشريحة أو النسخة الاحتياطية، والمستحيلة فعلاً." schema={schema}>

  <nav class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
