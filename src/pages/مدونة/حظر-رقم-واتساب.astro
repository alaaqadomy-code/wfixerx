---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const faqs = [
        { q: "هل حظر واتساب يطال الرقم أم الجهاز؟", a: "حظر واتساب يطال الرقم في المقام الأول. لكن عند استخدام نسخ معدلة، قد يُحظر الجهاز أيضاً بشكل مستقل عن الرقم." },
        { q: "هل يمكن استخدام رقم جديد على نفس الجهاز المحظور؟", a: "إذا كان الحظر على الرقم فقط، يمكن نظرياً استخدام رقم جديد على نفس الجهاز. لكن هذا قد يُعرّض الرقم الجديد للحظر إذا لم تُعالج المشكلة الأصلية." },
        { q: "هل تغيير الجهاز يفك الحظر؟", a: "تغيير الجهاز لا يفك حظر الرقم. إذا حُظر رقمك، فالحظر يتبع الرقم وليس الجهاز. الحل الحقيقي هو معالجة حظر الرقم." },
        { q: "ماذا أفعل إذا حُظر رقمي في واتساب؟", a: "الخطوة الأولى هي تقديم طلب مراجعة عبر التطبيق أو موقع support.whatsapp.com. إذا لم تنجح وحدك، استعن بمتخصص." },
        { q: "كيف أعرف إذا كان جهازي محظوراً في واتساب؟", a: "إذا رفض واتساب تسجيل أي رقم جديد على جهازك رغم أن الأرقام نفسها تعمل على أجهزة أخرى، فهذا مؤشر على حظر الجهاز." },
  { q: "هل يُرفع الحظر إذا نقلت الشريحة إلى هاتف آخر؟", a: "لا. الحظر مثبَّت على الرقم في سجلات واتساب، فينتقل مع الشريحة إلى أي جهاز تضعها فيه، وتظهر الرسالة نفسها عند التسجيل. وتبديل الهاتف أو تهيئته أو تغيير رقم IMEI لا يغيّر شيئاً، ومحاولات التجاوز هذه قد تُسجَّل كمخالفة جديدة فتزيد الحالة سوءاً. المسار الوحيد يبقى طلب المراجعة على الرقم نفسه." },
  { q: "ماذا لو كان الرقم مسجلاً باسم شخص آخر؟", a: "تقديم طلب المراجعة لا يحتاج إلى من تُسجَّل الشريحة باسمه، لأنك تقدّمه من الهاتف الذي يعمل عليه الرقم. لكن إن ضاعت الشريحة أو احتجت بديلاً من المشغّل فصاحب الهوية المسجلة هو وحده من يطلبه. وفي دول الخليج التي تربط الشرائح بالبصمة يصبح هذا شرطاً لا حيلة فيه. فإن كان الرقم باسم صاحب عمل أو قريب، فرتّب الأمر معه مبكراً، أو انقل حسابك إلى رقم باسمك من إعدادات واتساب ما دام الرقم الحالي يعمل." },
  { q: "هل أستعيد الرقم إذا أعاد المشغّل بيعه لشخص آخر؟", a: "إن أُغلق خطك مدة طويلة فقد يعيد المشغّل الرقم إلى التداول ويمنحه لمشترك جديد. وعندها يستطيع المالك الجديد تسجيل واتساب عليه بعد وصول رمز التحقق إليه، وتفقد أنت حسابه وما فيه. وهذا من أوضح الأسباب لعدم ترك رقم مرتبط بحسابك مغلقاً شهوراً، ولنقل الحساب إلى رقم تملكه فعلاً قبل التخلي عن القديم." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "حظر رقم واتساب — الفرق بين حظر الرقم وحظر الجهاز",
    "description": "ما الفرق بين حظر رقم واتساب وحظر الجهاز؟ كيف تعرف ما الذي حُظر وما الخطوات الصحيحة في كل حالة.",
    "author": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "publisher": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "datePublished": "2026-10-13",
    "dateModified": "2026-10-13",
    "inLanguage": "ar",
    "url": "https://wfixerx.com/مدونة/حظر-رقم-واتساب/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.filter(f => !f.noSchema).map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
]);
---

<BaseLayout title="حظر رقم واتساب — الفرق بين حظر الرقم وحظر الجهاز" description="ما الفرق بين حظر رقم واتساب وحظر الجهاز؟ كيف تعرف ما الذي حُظر وما الخطوات الصحيحة للتعامل مع كل حالة." schema={schema}>

  <nav class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#25D366]">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li><a href="/مدونة/" class="hover:text-[#25D366]">المدونة</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">حظر رقم واتساب</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-[#040b18] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs text-white/40 mb-4">أكتوبر 2026 · وقت القراءة: 6 دقائق</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6">حظر رقم واتساب — الفرق بين حظر الرقم وحظر الجهاز</h1>
      <p class="text-lg text-white/60 leading-relaxed">
        عندما يُحظر حسابك على واتساب، السؤال المهم هو: هل حُظر رقمك أم جهازك أم كلاهما؟ الإجابة تحدد تماماً الخطوات التالية التي يجب اتخاذها. كثيرون يغيّرون أجهزتهم أو أرقامهم اعتقاداً أن ذلك سيحل المشكلة، لكن هذا قد لا يفيد أو يزيد الوضع سوءاً. هذا الدليل يوضح الفرق ويساعدك على اتخاذ القرار الصحيح.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <!-- Quick Answer -->
    <div class="relative rounded-2xl overflow-hidden border border-[#25D366]/20 bg-gradient-to-br from-[#0a1628] to-[#041a0c] p-7 mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-9 h-9 bg-gradient-to-br from-[#25D366] to-[#1de9b6] rounded-xl flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p class="text-xs font-semibold text-[#25D366] uppercase tracking-wider">إجابة مباشرة</p>
      </div>
      <h2 class="text-xl font-bold text-white mb-3">ما الفرق بين حظر رقم واتساب وحظر الجهاز؟</h2>
      <p class="text-white/70 leading-relaxed">حظر الرقم يعني أن رقم هاتفك المحدد مُوقف من قبل واتساب — يحدث هذا في معظم حالات الحظر. حظر الجهاز أكثر ندرة ويعني أن الجهاز نفسه ممنوع من تسجيل أرقام جديدة — يحدث عادةً بعد استخدام نسخ معدلة. الغالبية العظمى من حالات الحظر هي حظر رقم وليس جهاز.</p>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">حظر الرقم مقابل حظر الجهاز — المقارنة الكاملة</h2>

    <div class="overflow-x-auto mb-10">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-[#0a1628] border border-white/10">
            <th class="p-4 text-right text-white font-bold">المعيار</th>
            <th class="p-4 text-right text-white font-bold">حظر الرقم</th>
            <th class="p-4 text-right text-white font-bold">حظر الجهاز</th>
          </tr>
        </thead>
        <tbody>
          {[
            ["الشيوع", "شائع جداً", "نادر نسبياً"],
            ["سبب الحظر", "انتهاك شروط الاستخدام", "غالباً نسخ معدلة"],
            ["تغيير الجهاز يحل المشكلة؟", "لا", "قد يساعد جزئياً"],
            ["رقم جديد على نفس الجهاز؟", "قد يعمل مؤقتاً", "لن يعمل"],
            ["الحل الفعلي", "طلب مراجعة للرقم", "إعادة ضبط + طلب مراجعة"],
          ].map(row => (
            <tr class="border border-white/8 bg-[#0a1628] even:bg-[#0d1e30]">
              <td class="p-3 text-white font-medium">{row[0]}</td>
              <td class="p-3 text-white/70">{row[1]}</td>
              <td class="p-3 text-white/70">{row[2]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">كيف تعرف إذا كان رقمك أم جهازك محظوراً؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">
      اختبار بسيط يحدد المشكلة في دقائق: جرّب نفس رقمك على جهاز آخر. هذا الاختبار يعطيك إجابة واضحة:
    </p>

    <div class="grid sm:grid-cols-2 gap-4 mb-8">
      <div class="bg-[#0a1628] border border-white/8 rounded-2xl p-5">
        <h3 class="text-base font-bold text-yellow-400 mb-3">إذا ظهر الحظر على الجهازين</h3>
        <p class="text-white/70 text-sm leading-relaxed mb-3">هذا يعني أن رقمك محظور. الجهاز ليس مشكلة — المشكلة في الرقم ذاته. تغيير الجهاز لن يحل شيئاً.</p>
        <p class="text-[#25D366] text-sm font-medium">الحل: طلب مراجعة للرقم</p>
      </div>
      <div class="bg-[#0a1628] border border-white/8 rounded-2xl p-5">
        <h3 class="text-base font-bold text-orange-400 mb-3">إذا عمل الرقم على الجهاز الآخر</h3>
        <p class="text-white/70 text-sm leading-relaxed mb-3">هذا يشير لمشكلة في الجهاز أو في إعداداته. قد تحتاج إعادة ضبط مصنع أو تحديث التطبيق.</p>
        <p class="text-[#25D366] text-sm font-medium">الحل: إعادة ضبط الجهاز + تطبيق رسمي</p>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">الأخطاء الشائعة عند حظر الرقم</h2>
    <p class="text-white/70 leading-relaxed mb-4">
      هذه الأخطاء يقع فيها كثيرون وقد تحوّل الحظر المؤقت لمشكلة أكبر:
    </p>

    <ul class="space-y-3 mb-8">
      {[
        { error: "إنشاء رقم جديد على نفس الجهاز", why: "الرقم الجديد سيحمل نفس بصمة الجهاز وقد يُحظر هو الآخر إذا لم تُعالج السبب الأصلي." },
        { error: "تغيير الجهاز مع الاحتفاظ بنفس الرقم المحظور", why: "الحظر يتبع الرقم لا الجهاز. تغيير الجهاز لن يرفع حظر الرقم." },
        { error: "محاولة تجاوز الحظر بتطبيقات ثالثة", why: "هذا ينتهك شروط الاستخدام مجدداً ويزيد من صعوبة الحل الرسمي لاحقاً." },
        { error: "تجاهل المشكلة والانتظار فقط", why: "الحظر المشدد والنهائي لا يُرفعان تلقائياً. الانتظار بدون فعل قد يضيع الفرصة." },
      ].map(item => (
        <li class="bg-[#0a1628] border border-red-500/20 rounded-xl p-4">
          <p class="font-semibold text-red-400 text-sm mb-1">خطأ: {item.error}</p>
          <p class="text-white/60 text-sm">{item.why}</p>
        </li>
      ))}
    </ul>

    <!-- Mid CTA -->
    <div class="bg-gradient-to-br from-[#0d2844] to-[#041a0c] rounded-2xl p-6 my-10 border border-[#25D366]/15 text-center">
      <p class="font-semibold text-white mb-2">تحتاج مساعدة متخصصة؟</p>
      <p class="text-white/50 text-sm mb-4">تواصل معنا وسنساعدك في تقييم حالتك مجاناً</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تواصل عبر تلغرام</a>
      </div>
    </div>

    <!-- FAQ Section -->
    <h2 class="text-2xl font-bold text-white mt-12 mb-6">أسئلة شائعة</h2>
    <div class="space-y-3">
      {faqs.map(item => (
        <details class="bg-[#0a1628] border border-white/8 rounded-xl overflow-hidden">
          <summary class="p-4 font-semibold text-white cursor-pointer hover:bg-white/5 transition-colors">{item.q}</summary>
          <p class="px-4 pb-4 text-white/60 text-sm leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>

    <!-- Internal Links -->
    <div class="mt-12 pt-8 border-t border-white/8">
      <h3 class="text-lg font-bold text-white mb-4">مقالات ذات صلة</h3>
      <div class="grid sm:grid-cols-2 gap-3">
        {[
          { href: "/فك-حظر-واتساب/", title: "دليل فك حظر واتساب الشامل" },
          { href: "/استرجاع-حساب-واتساب/", title: "استرجاع حساب واتساب" },
          { href: "/مدونة/أسباب-حظر-واتساب/", title: "أسباب حظر واتساب" },
          { href: "/مدونة/أنواع-حظر-واتساب/", title: "أنواع حظر واتساب" },
        ].map(link => (
          <a href={link.href} class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group">
            <p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">{link.title} ←</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Final CTA -->
    <div class="bg-gradient-to-br from-[#0d2844] to-[#041a0c] rounded-2xl p-6 mt-10 border border-[#25D366]/15 text-center">
      <p class="font-semibold text-white mb-2">لا تعرف ما المحظور — رقمك أم جهازك؟</p>
      <p class="text-white/50 text-sm mb-4">تواصل معنا وسنساعدك في تشخيص المشكلة بدقة</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تواصل عبر تلغرام</a>
      </div>
    </div>

  </article>
</BaseLayout>
