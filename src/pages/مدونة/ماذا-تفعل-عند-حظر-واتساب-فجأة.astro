---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "ماذا تفعل عند حظر واتساب فجأة — دليل الإجراءات الفورية",
    "description": "تم حظر حسابك فجأة؟ هذا الدليل يوضح الخطوات التي يجب اتخاذها فوراً لزيادة فرص استرداد حسابك.",
    "author": { "@type": "Organization", "name": "WFixerX" },
    "dateModified": "2026-10-13",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://wfixerx.com" },
      { "@type": "ListItem", "position": 2, "name": "المدونة", "item": "https://wfixerx.com/مدونة/" },
      { "@type": "ListItem", "position": 3, "name": "ماذا تفعل عند حظر واتساب فجأة", "item": "https://wfixerx.com/مدونة/ماذا-تفعل-عند-حظر-واتساب-فجأة/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "ماذا أفعل عند حظر واتساب فجأة؟", "acceptedAnswer": { "@type": "Answer", "text": "الخطوات الأولى: 1. لا تحذف التطبيق. 2. ابحث عن زر طلب المراجعة داخل التطبيق. 3. قدّم الطلب فوراً. 4. انتظر الرد مع تجنب أي نشاط إضافي." } },
      { "@type": "Question", "name": "لماذا يتم حظر واتساب بدون سبب واضح؟", "acceptedAnswer": { "@type": "Answer", "text": "أحياناً يبدو الحظر مفاجئاً لكنه في الغالب يعود لسبب ما — تقارير متراكمة، استخدام نسخة معدّلة، أو تعديل في سياسات واتساب طال حسابك." } },
      { "@type": "Question", "name": "هل حذف واتساب وإعادة تثبيته يحل الحظر؟", "acceptedAnswer": { "@type": "Answer", "text": "لا، حذف التطبيق وإعادة تثبيته لا يرفع الحظر. الحظر مرتبط برقم هاتفك في خوادم واتساب وليس بالتطبيق المثبّت على جهازك." } }
    ]
  }
]);
---

<BaseLayout
  title="ماذا تفعل عند حظر واتساب فجأة — دليل الإجراءات الفورية"
  description="حُظر حسابك فجأة بلا سبب واضح؟ خطوات الساعة الأولى بالترتيب: صوّر الرسالة، شخّص النوع، أوقف ما سبّبه، وقدّم طلباً واحداً مدروساً. وثلاثة أشياء لا تفعلها لئلا يصبح الحظر دائماً."
  schema={schema}
>

  <nav class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#25D366] transition-colors">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li><a href="/مدونة/" class="hover:text-[#25D366] transition-colors">المدونة</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">ماذا تفعل عند حظر واتساب فجأة</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-[#07111f] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs text-white/40 mb-4">أكتوبر 2026 · وقت القراءة: 5 دقائق</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6">
        ماذا تفعل عند حظر واتساب فجأة — دليل الإجراءات الفورية
      </h1>
      <p class="text-lg text-white/70 leading-relaxed">
        فتحت واتساب ووجدت حسابك محظوراً فجأة؟ الدقائق الأولى مهمة. هذا الدليل يوضح بالضبط ما تفعله الآن.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="quick-answer mb-10">
      <p class="text-xs font-semibold text-[#25D366] uppercase tracking-wider mb-2">الجواب السريع</p>
      <h2 class="text-xl font-bold text-white mb-3">ماذا أفعل فوراً عند حظر واتساب؟</h2>
      <p class="text-white/75"><strong class="text-white">لا تحذف التطبيق.</strong> ابحث عن زر "طلب المراجعة" داخل رسالة الحظر. إذا لم يظهر، انتقل لـ support.whatsapp.com وقدّم طلباً هناك. انتظر — لا تُرسل طلبات متعددة في نفس اليوم.</p>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">ما الذي يجب عدم فعله فوراً</h2>
    <p class="text-white/70 leading-relaxed mb-4">قبل الحديث عن ما تفعله، من المهم معرفة الأخطاء الشائعة التي تُعقّد الوضع:</p>
    <div class="space-y-3 mb-8">
      {[
        { mistake: "حذف التطبيق وإعادة تثبيته", why: "لن يحل الحظر وقد تضيع خيار المراجعة الظاهر حالياً" },
        { mistake: "إرسال طلبات مراجعة متعددة في يوم واحد", why: "هذا يُثير الشك ويؤخر الرد" },
        { mistake: "شراء تطبيقات تدّعي فك الحظر", why: "لا يوجد تطبيق يفك الحظر — هذه عمليات احتيال" },
        { mistake: "استخدام الحساب المحظور من جهاز آخر", why: "لن ينجح — الحظر على الرقم وليس الجهاز" },
        { mistake: "تغيير رقمك فوراً", why: "أنت تخسر كل محادثاتك ومجموعاتك قبل محاولة الاسترداد" },
      ].map(item => (
        <div class="bg-red-950/20 border border-red-500/15 rounded-xl p-4 flex gap-3">
          <span class="text-red-400 font-bold shrink-0 mt-0.5">✗</span>
          <div>
            <p class="font-semibold text-white text-sm">{item.mistake}</p>
            <p class="text-white/55 text-xs mt-0.5">{item.why}</p>
          </div>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">الخطوات الصحيحة — بالترتيب</h2>
    <ol class="space-y-5 mb-8">
      {[
        {
          title: "اقرأ رسالة الحظر بعناية",
          desc: "هل يظهر عداد وقت؟ هذا حظر مؤقت. هل تظهر رسالة بدون عداد؟ قد يكون مشدداً أو نهائياً. هل يظهر زر 'طلب المراجعة'؟ هذا خيارك الأول.",
          time: "فوراً"
        },
        {
          title: "اضغط 'طلب المراجعة' إذا ظهر",
          desc: "أدخل رقمك بدقة مع رمز الدولة. اكتب رسالة مختصرة تشرح أنك لم تخالف الشروط عمداً أو أن المشكلة حُلّت.",
          time: "دقيقة 1-3"
        },
        {
          title: "جرّب support.whatsapp.com",
          desc: "إذا لم يظهر الزر داخل التطبيق، انتقل لموقع دعم واتساب من متصفح هاتفك وقدّم طلباً مع نفس التفاصيل.",
          time: "دقيقة 5-10"
        },
        {
          title: "أبلّغ جهات اتصالك المهمة",
          desc: "أخبر الأشخاص المهمين في حياتك أو عملك عن الوضع وزودهم بوسيلة تواصل بديلة مؤقتاً.",
          time: "خلال ساعة"
        },
        {
          title: "انتظر 24-48 ساعة",
          desc: "لا تتصرف بتسرع. معظم طلبات المراجعة يُردّ عليها خلال 24-72 ساعة. الانتظار جزء من العملية.",
          time: "24-72 ساعة"
        },
      ].map((step, i) => (
        <li class="flex gap-4">
          <div class="flex flex-col items-center shrink-0">
            <span class="w-9 h-9 rounded-full bg-[#25D366]/15 text-[#25D366] flex items-center justify-center font-bold text-sm border border-[#25D366]/30">{i + 1}</span>
            {i < 4 && <div class="w-0.5 h-5 bg-white/10 mt-1"></div>}
          </div>
          <div class="pb-4">
            <div class="flex items-center gap-2 mb-1">
              <p class="font-bold text-white">{step.title}</p>
              <span class="text-xs text-[#25D366] bg-[#25D366]/10 px-2 py-0.5 rounded-full">{step.time}</span>
            </div>
            <p class="text-white/65 text-sm leading-relaxed">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">حظر بدون سبب واضح — هل هذا ممكن؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">
      كثيرون يقولون "محظور بدون سبب". الحقيقة أن واتساب نادراً تحظر بشكل عشوائي. لكن هناك أسباب قد لا تنتبه لها:
    </p>
    <ul class="space-y-2 text-white/70 mb-8">
      {[
        "تقارير كيدية من أشخاص يريدون الإيذاء.",
        "نسخة معدّلة كنت تستخدمها سابقاً وربما نسيتها.",
        "تغيير مفاجئ في سياسات واتساب طال نشاطاً قديماً.",
        "خطأ في النظام الآلي — وهذا يُرفع عادةً بطلب مراجعة بسيط.",
        "مشاركتك في مجموعة كانت تضم أشخاصاً يقومون بنشاط مخالف.",
      ].map(c => (
        <li class="flex items-start gap-3">
          <span class="text-white/40 font-bold shrink-0 mt-0.5">←</span>
          {c}
        </li>
      ))}
    </ul>

    <div class="glass-dark rounded-2xl p-6 mt-8 text-center border border-white/10">
      <p class="font-semibold text-white mb-2">لم تنجح المراجعة أو تريد مساعدة أسرع؟</p>
      <p class="text-white/55 text-sm mb-5">نساعدك في تقييم وضعك وإيجاد أفضل خطوة تالية</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تلغرام</a>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">الأسئلة الشائعة</h2>
    <div class="space-y-3">
      {[
        {
          q: "ماذا أفعل عند حظر واتساب فجأة؟",
          a: "الخطوات الأولى: 1. لا تحذف التطبيق. 2. ابحث عن زر طلب المراجعة داخل التطبيق. 3. قدّم الطلب فوراً. 4. انتظر الرد مع تجنب أي نشاط إضافي."
        },
        {
          q: "لماذا يتم حظر واتساب بدون سبب واضح؟",
          a: "أحياناً يبدو الحظر مفاجئاً لكنه في الغالب يعود لسبب ما — تقارير متراكمة، استخدام نسخة معدّلة، أو تعديل في سياسات واتساب طال حسابك."
        },
        {
          q: "هل حذف واتساب وإعادة تثبيته يحل الحظر؟",
          a: "لا، حذف التطبيق وإعادة تثبيته لا يرفع الحظر. الحظر مرتبط برقم هاتفك في خوادم واتساب وليس بالتطبيق المثبّت على جهازك."
        }
      ].map(faq => (
        <details class="glass-dark rounded-xl border border-white/10 overflow-hidden">
          <summary class="px-5 py-4 font-semibold text-white cursor-pointer flex items-center justify-between gap-3">
            <span>{faq.q}</span>
            <span class="text-white/40 shrink-0 text-lg">+</span>
          </summary>
          <div class="px-5 pb-4 text-white/65 leading-relaxed text-sm">{faq.a}</div>
        </details>
      ))}
    </div>

    <div class="grid sm:grid-cols-3 gap-4 mt-12">
      {[
        { href: "/فك-حظر-واتساب/", title: "دليل فك الحظر الشامل" },
        { href: "/مدونة/علامات-حظر-واتساب/", title: "علامات حظر واتساب" },
        { href: "/طلب-مراجعة-واتساب/", title: "طلب مراجعة واتساب" },
      ].map(link => (
        <a href={link.href} class="glass-dark rounded-xl p-4 border border-white/10 hover:border-[#25D366]/40 transition-colors group">
          <p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366] transition-colors">{link.title} ←</p>
        </a>
      ))}
    </div>

  </article>
</BaseLayout>
