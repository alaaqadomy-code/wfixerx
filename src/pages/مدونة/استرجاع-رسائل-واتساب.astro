<BaseLayout title="استرجاع رسائل واتساب المحذوفة — كل الطرق الممكنة بصدق" description="هل يمكن استرجاع رسائل واتساب المحذوفة؟ الطرق الحقيقية عبر النسخة الاحتياطية على أندرويد وآيفون، وحدود كل طريقة، وتحذير من تطبيقات الاسترجاع الاحتيالية." schema={schema}>

  <nav class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
