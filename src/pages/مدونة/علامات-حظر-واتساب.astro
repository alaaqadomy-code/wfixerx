---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";

const faqs = [
        {
          q: "كيف أعرف أن حساب واتساب الخاص بي محظور؟",
          a: "العلامة الأساسية: ظهور رسالة 'يتعذر على هذا الحساب استخدام واتساب' عند فتح التطبيق. قد يظهر أيضاً عداد وقت أو خيار 'طلب مراجعة'."
        },
        {
          q: "هل يمكن أن يكون حظر واتساب جزئياً؟",
          a: "نعم، الحظر الجزئي يمنع إرسال الرسائل فقط مع إمكانية الاستقبال أحياناً. أما الحظر الكامل فيمنع أي استخدام للحساب."
        },
        {
          q: "ماذا تعني رسالة 'انتظر قبل إرسال الرسائل'؟",
          a: "هذه رسالة تحذيرية قبل الحظر الفعلي. واتساب تُنبّهك أن نشاطك مشبوه. توقف فوراً عن الرسائل الجماعية وأي نشاط غير طبيعي."
        },
  { q: "كيف أفرّق بين حظر من واتساب وحظر شخص لي؟", a: "الفارق واضح إن عرفت ما تنظر إليه. حين تحظرك واتساب يتوقف الحساب كله: لا ترسل ولا تستقبل من أي أحد، وتظهر رسالة صريحة عند فتح التطبيق. وحين يحظرك شخص واحد فحسابك سليم تماماً ويعمل مع الجميع، وتختفي عنك صورته وحالة «آخر ظهور» وتبقى علامة صح واحدة على رسائلك إليه وحده. فإن كان كل شيء طبيعياً مع غيره فالمشكلة ليست حظر حساب." },
  { q: "هل انقطاع الاتصال علامة حظر؟", a: "غالباً لا. أكثر ما يُظن حظراً هو مشكلة شبكة أو خلل عام في خدمة واتساب. العلامة الفارقة هي الرسالة المكتوبة: الحظر يُعلن عن نفسه بنص صريح أو بعداد تنازلي. أما بقاء الرسائل على علامة الساعة، أو تعليق كلمة «جارٍ الاتصال»، فيعني غالباً انقطاع إنترنت أو تقييد خلفية التطبيق في إعدادات الهاتف أو عطلاً مؤقتاً لدى الشركة. تحقق من ذلك قبل أن تستنتج الحظر." },
  { q: "هل تظهر علامات قبل الحظر؟", a: "أحياناً، ومن انتبه إليها نجا. أكثرها دلالة: ارتفاع عدد من يغادر مجموعاتك أو يحجبك، أو تحذير داخل التطبيق عن مخالفة الشروط، أو هبوط تقييم الجودة في حساب الأعمال من أخضر إلى أصفر أو أحمر، أو توقف وصول رسائلك إلى أرقام معيّنة دون غيرها. هذه إنذارات مبكرة؛ عالج سببها فوراً فهي أرخص بكثير من معالجة الحظر بعد وقوعه." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "علامات حظر واتساب — كيف تعرف أن حسابك محظور؟",
    "description": "العلامات الواضحة التي تدل على حظر واتساب: الرسائل التي تظهر، الأعراض المختلفة، والفرق بين الحظر الكامل والجزئي.",
    "author": { "@type": "Organization", "name": "WFixerX" },
    "dateModified": "2026-10-13",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://wfixerx.com" },
      { "@type": "ListItem", "position": 2, "name": "المدونة", "item": "https://wfixerx.com/مدونة/" },
      { "@type": "ListItem", "position": 3, "name": "علامات حظر واتساب", "item": "https://wfixerx.com/مدونة/علامات-حظر-واتساب/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.filter(f => !f.noSchema).map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
]);
---

<BaseLayout
  title="علامات حظر واتساب — كيف تعرف أن حسابك محظور؟"
  description="العلامات الواضحة التي تدل على حظر واتساب: الرسائل التي تظهر، الأعراض المختلفة، والفرق بين الحظر الكامل والجزئي."
  schema={schema}
>

  <nav class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#25D366] transition-colors">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li><a href="/مدونة/" class="hover:text-[#25D366] transition-colors">المدونة</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">علامات حظر واتساب</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-[#07111f] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs text-white/40 mb-4">أكتوبر 2026 · وقت القراءة: 4 دقائق</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6">
        علامات حظر واتساب — كيف تعرف أن حسابك محظور؟
      </h1>
      <p class="text-lg text-white/70 leading-relaxed">
        أحياناً لا يكون الحظر واضحاً تماماً. هذا الدليل يشرح كل العلامات الدالة على حظر واتساب، من الأوضح للأخفى، وكيف تميّز بين أنواعه.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="quick-answer mb-10">
      <p class="text-xs font-semibold text-[#25D366] uppercase tracking-wider mb-2">الجواب السريع</p>
      <h2 class="text-xl font-bold text-white mb-3">كيف أعرف أن حساب واتساب محظور؟</h2>
      <p class="text-white/75">العلامة الأساسية: ظهور رسالة <strong class="text-white">"يتعذر على هذا الحساب استخدام واتساب"</strong> أو <strong class="text-white">"لا يمكن لهذا الحساب استخدام واتساب"</strong> عند فتح التطبيق. قد يظهر أيضاً عداد وقت أو خيار "طلب مراجعة".</p>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-6">العلامات الأساسية لحظر واتساب</h2>

    <div class="space-y-4 mb-10">
      {[
        {
          title: "رسالة الحظر الصريحة",
          desc: 'تظهر عند فتح التطبيق: "يتعذر على هذا الحساب استخدام واتساب" أو "لا يمكن لهذا الحساب استخدام واتساب". هذه العلامة الأوضح والأكثر تأكيداً للحظر.',
          type: "مؤكد",
          color: "red"
        },
        {
          title: "عداد الوقت التنازلي",
          desc: "يظهر مع رسالة الحظر عداد يوضح المدة المتبقية. هذا يعني حظراً مؤقتاً — كلما كان العداد أطول، كان الحظر أشد.",
          type: "حظر مؤقت",
          color: "orange"
        },
        {
          title: "ظهور زر 'طلب المراجعة'",
          desc: "يظهر هذا الزر مع رسالة الحظر في بعض الحالات. وجوده علامة إيجابية تعني أن الحساب قابل للاسترداد.",
          type: "يمكن حله",
          color: "green"
        },
        {
          title: "عدم إمكانية إرسال الرسائل فقط",
          desc: "في الحظر الجزئي، تستطيع الاستقبال لكن لا تستطيع الإرسال. هذا نوع خاص من الحظر يستهدف إرسال الرسائل الجماعية.",
          type: "حظر جزئي",
          color: "orange"
        },
        {
          title: "فشل التحقق برقم الهاتف",
          desc: "إذا حذفت التطبيق وأعدت تثبيته وفشل التحقق برمز SMS، قد يكون الرقم محظوراً من تسجيل حسابات جديدة.",
          type: "حظر الرقم",
          color: "red"
        },
      ].map(sign => (
        <div class={`rounded-xl p-5 border flex gap-4 ${sign.color === 'red' ? 'bg-red-950/30 border-red-500/20' : sign.color === 'orange' ? 'bg-orange-950/30 border-orange-500/20' : 'bg-green-950/20 border-green-500/20'}`}>
          <div class={`px-2 py-1 rounded-lg text-xs font-bold shrink-0 mt-0.5 h-fit ${sign.color === 'red' ? 'bg-red-900/50 text-red-300' : sign.color === 'orange' ? 'bg-orange-900/50 text-orange-300' : 'bg-green-900/50 text-green-300'}`}>{sign.type}</div>
          <div>
            <h3 class="font-bold text-white mb-1">{sign.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{sign.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">علامات التحذير قبل الحظر</h2>
    <p class="text-white/70 leading-relaxed mb-4">واتساب أحياناً تُحذّرك قبل الحظر الفعلي. انتبه لهذه العلامات:</p>
    <ul class="space-y-3 text-white/70 mb-8">
      {[
        { sign: "رسالة 'انتظر قبل إرسال المزيد من الرسائل'", meaning: "نشاطك مشبوه — أوقف الرسائل الجماعية فوراً" },
        { sign: "بطء غير معتاد في إرسال الرسائل", meaning: "قد يكون التطبيق يقيّد نشاطك بشكل تدريجي" },
        { sign: "عدم ظهور علامة القراءة الزرقاء لفترة طويلة", meaning: "قد يكون الطرف الآخر حظرك شخصياً (ليس من واتساب)" },
        { sign: "رسائل تُرسل بعلامة ساعة دون تأكيد", meaning: "مشكلة في الاتصال — لكن إذا تكررت بدون سبب تقني قد تكون تقييداً" },
      ].map(item => (
        <li class="flex items-start gap-3 p-3 bg-yellow-950/20 rounded-xl border border-yellow-500/15">
          <span class="text-yellow-400 shrink-0 font-bold mt-0.5">⚠</span>
          <div>
            <span class="font-semibold text-white text-sm">{item.sign}</span>
            <br />
            <span class="text-white/60 text-sm">{item.meaning}</span>
          </div>
        </li>
      ))}
    </ul>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">الفرق بين حظر واتساب وحالات أخرى</h2>
    <div class="overflow-x-auto mb-8 rounded-xl border border-white/10">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-white/5 border-b border-white/10">
            <th class="p-3 text-right font-semibold text-white/70">الحالة</th>
            <th class="p-3 text-right font-semibold text-white/70">السبب المحتمل</th>
            <th class="p-3 text-right font-semibold text-white/70">الحل</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/8">
          <tr>
            <td class="p-3 text-white/80">لا يمكن إرسال رسائل لشخص معين</td>
            <td class="p-3 text-white/60">الشخص حظرك شخصياً</td>
            <td class="p-3 text-white/60">ليس حظراً من واتساب</td>
          </tr>
          <tr>
            <td class="p-3 text-white/80">التطبيق لا يعمل</td>
            <td class="p-3 text-white/60">مشكلة إنترنت أو تحديث</td>
            <td class="p-3 text-white/60">أعد التشغيل أو حدّث</td>
          </tr>
          <tr>
            <td class="p-3 text-white/80">رسالة "لا يمكن لهذا الحساب"</td>
            <td class="p-3 text-white/60">حظر من واتساب</td>
            <td class="p-3 text-[#25D366]">طلب مراجعة</td>
          </tr>
          <tr>
            <td class="p-3 text-white/80">عداد وقت في التطبيق</td>
            <td class="p-3 text-white/60">حظر مؤقت</td>
            <td class="p-3 text-[#25D366]">انتظار + مراجعة</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">ماذا تفعل فور اكتشاف الحظر؟</h2>
    <ol class="space-y-4 mb-8">
      {[
        "لا تحذف التطبيق وتعيد تثبيته — هذا لن يحل الحظر وقد يُضيع خيار المراجعة.",
        "ابحث عن زر 'طلب المراجعة' في الرسالة التي تظهر لك.",
        "إذا لم يظهر الزر، انتقل لـ support.whatsapp.com من متصفحك.",
        "قدّم طلب مراجعة مع شرح واضح لوضعك.",
        "انتظر 24-48 ساعة قبل المتابعة — لا تُرسل طلبات متعددة.",
      ].map((step, i) => (
        <li class="flex items-start gap-3">
          <span class="w-7 h-7 rounded-full bg-[#25D366]/15 text-[#25D366] flex items-center justify-center font-bold shrink-0 text-sm">{i + 1}</span>
          <span class="text-white/70 leading-relaxed">{step}</span>
        </li>
      ))}
    </ol>

    <div class="glass-dark rounded-2xl p-6 mt-8 text-center border border-white/10">
      <p class="font-semibold text-white mb-2">تأكدت من الحظر وتريد المساعدة؟</p>
      <p class="text-white/55 text-sm mb-4">تواصل معنا — نساعدك في تقييم وضعك والخطوات التالية</p>
      <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">الأسئلة الشائعة</h2>
    <div class="space-y-3">
      {faqs.map(faq => (
        <details class="glass-dark rounded-xl border border-white/10 overflow-hidden">
          <summary class="px-5 py-4 font-semibold text-white cursor-pointer flex items-center justify-between gap-3">
            <span>{faq.q}</span>
            <span class="text-white/40 shrink-0 text-lg">+</span>
          </summary>
          <div class="px-5 pb-4 text-white/65 leading-relaxed text-sm">{faq.a}</div>
        </details>
      ))}
    </div>

    <div class="grid sm:grid-cols-2 gap-4 mt-12">
      {[
        { href: "/فك-حظر-واتساب/", title: "دليل فك الحظر الشامل" },
        { href: "/مدونة/ماذا-تفعل-عند-حظر-واتساب-فجأة/", title: "ماذا تفعل عند الحظر فجأة؟" },
        { href: "/مدونة/أسباب-حظر-واتساب/", title: "أسباب حظر واتساب" },
        { href: "/مدونة/أنواع-حظر-واتساب/", title: "أنواع حظر واتساب" },
      ].map(link => (
        <a href={link.href} class="glass-dark rounded-xl p-4 border border-white/10 hover:border-[#25D366]/40 transition-colors group">
          <p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366] transition-colors">{link.title} ←</p>
        </a>
      ))}
    </div>

  </article>
</BaseLayout>
