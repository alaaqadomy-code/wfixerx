---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "كم مدة حظر واتساب؟ — جميع أنواع الحظر وأوقاتها",
    "description": "كم تستغرق مدة حظر واتساب؟ الجواب يعتمد على نوع الحظر. هذا الدليل يشرح مدة كل نوع وكيف تُقصّرها.",
    "author": { "@type": "Organization", "name": "WFixerX" },
    "dateModified": "2026-10-13",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://wfixerx.com" },
      { "@type": "ListItem", "position": 2, "name": "المدونة", "item": "https://wfixerx.com/مدونة/" },
      { "@type": "ListItem", "position": 3, "name": "مدة حظر واتساب", "item": "https://wfixerx.com/مدونة/مدة-حظر-واتساب/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "كم تستغرق مدة حظر واتساب؟", "acceptedAnswer": { "@type": "Answer", "text": "مدة حظر واتساب تعتمد على النوع: حظر مؤقت 24 ساعة إلى 72 ساعة، حظر مشدد أسبوع إلى عدة أسابيع، حظر نهائي غير محدد المدة ويحتاج مراجعة." } },
      { "@type": "Question", "name": "هل يمكن تقصير مدة حظر واتساب؟", "acceptedAnswer": { "@type": "Answer", "text": "في الحظر المؤقت، المدة ثابتة ولا يمكن تقصيرها. في الحظر المشدد، تقديم طلب مراجعة فعّال قد يُعجّل الرفع. الحظر النهائي يحتاج مراجعة نشطة." } },
      { "@type": "Question", "name": "هل حظر واتساب دائم؟", "acceptedAnswer": { "@type": "Answer", "text": "الحظر النهائي قد يكون دائماً في حالات المخالفات الجسيمة. لكن كثير من الحظر يمكن رفعه بطلب مراجعة، سواء أكان مؤقتاً أم مشدداً أم حتى بعض أنواع النهائي." } }
    ]
  }
]);
---

<BaseLayout
  title="كم مدة حظر واتساب؟ — جميع أنواع الحظر وأوقاتها"
  description="كم تستغرق مدة حظر واتساب؟ الجواب يعتمد على نوع الحظر. هذا الدليل يشرح مدة كل نوع وكيف تُقصّرها."
  schema={schema}
>

  <nav class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#25D366] transition-colors">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li><a href="/مدونة/" class="hover:text-[#25D366] transition-colors">المدونة</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">مدة حظر واتساب</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-[#07111f] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs text-white/40 mb-4">أكتوبر 2026 · وقت القراءة: 4 دقائق</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6">
        كم مدة حظر واتساب؟ — جميع أنواع الحظر وأوقاتها
      </h1>
      <p class="text-lg text-white/70 leading-relaxed">
        سؤال بسيط لكن إجابته تعتمد على نوع الحظر. حظر 24 ساعة مختلف تماماً عن حظر الأسبوع، وكلاهما مختلف عن الحظر النهائي.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="quick-answer mb-10">
      <p class="text-xs font-semibold text-[#25D366] uppercase tracking-wider mb-2">الجواب السريع</p>
      <h2 class="text-xl font-bold text-white mb-3">كم تستغرق مدة حظر واتساب؟</h2>
      <p class="text-white/75">مدة الحظر تعتمد على نوعه: <strong class="text-white">حظر مؤقت:</strong> 24 ساعة إلى 72 ساعة يُرفع تلقائياً. <strong class="text-white">حظر مشدد:</strong> أسبوع إلى عدة أسابيع ويحتاج طلب مراجعة. <strong class="text-white">حظر نهائي:</strong> غير محدود ويحتاج تدخلاً.</p>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-6">جدول مدد الحظر حسب النوع</h2>
    <div class="overflow-x-auto mb-8 rounded-xl border border-white/10">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-white/5 border-b border-white/10">
            <th class="p-4 text-right font-semibold text-white/70">نوع الحظر</th>
            <th class="p-4 text-right font-semibold text-white/70">المدة</th>
            <th class="p-4 text-right font-semibold text-white/70">يُرفع تلقائياً</th>
            <th class="p-4 text-right font-semibold text-white/70">الحل</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/8">
          <tr>
            <td class="p-4 text-white/80 font-medium">حظر مؤقت خفيف</td>
            <td class="p-4 text-green-400 font-medium">24 ساعة</td>
            <td class="p-4 text-green-400">نعم</td>
            <td class="p-4 text-white/60">انتظار</td>
          </tr>
          <tr>
            <td class="p-4 text-white/80 font-medium">حظر مؤقت متوسط</td>
            <td class="p-4 text-yellow-400 font-medium">48-72 ساعة</td>
            <td class="p-4 text-yellow-400">غالباً</td>
            <td class="p-4 text-white/60">انتظار + مراجعة</td>
          </tr>
          <tr>
            <td class="p-4 text-white/80 font-medium">حظر مشدد أسبوعي</td>
            <td class="p-4 text-orange-400 font-medium">7 أيام</td>
            <td class="p-4 text-orange-400">أحياناً</td>
            <td class="p-4 text-white/60">طلب مراجعة</td>
          </tr>
          <tr>
            <td class="p-4 text-white/80 font-medium">حظر مشدد طويل</td>
            <td class="p-4 text-orange-400 font-medium">أسابيع - شهور</td>
            <td class="p-4 text-orange-400">نادراً</td>
            <td class="p-4 text-white/60">مراجعة نشطة</td>
          </tr>
          <tr>
            <td class="p-4 text-white/80 font-medium">حظر نهائي</td>
            <td class="p-4 text-red-400 font-medium">دائم</td>
            <td class="p-4 text-red-400">لا</td>
            <td class="p-4 text-white/60">تدخل متخصص</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">كيف تعرف نوع الحظر بالنظر للرسالة؟</h2>
    <div class="space-y-3 mb-8">
      {[
        {
          msg: "ظهور عداد وقت قصير (ساعات)",
          type: "حظر مؤقت خفيف — ينتهي تلقائياً",
          color: "green"
        },
        {
          msg: "ظهور عداد وقت طويل (أيام)",
          type: "حظر مشدد — قدّم طلب مراجعة",
          color: "orange"
        },
        {
          msg: "رسالة بدون عداد وقت مع زر مراجعة",
          type: "حظر مشدد أو بداية نهائي — اعمل بسرعة",
          color: "orange"
        },
        {
          msg: "رسالة بدون عداد ولا زر مراجعة",
          type: "حظر نهائي — يحتاج تدخل",
          color: "red"
        },
      ].map(item => (
        <div class={`rounded-xl p-4 border flex gap-3 items-start ${item.color === 'green' ? 'bg-green-950/20 border-green-500/20' : item.color === 'orange' ? 'bg-orange-950/20 border-orange-500/20' : 'bg-red-950/20 border-red-500/20'}`}>
          <span class={`text-xs font-bold px-2 py-1 rounded-lg shrink-0 ${item.color === 'green' ? 'bg-green-900/40 text-green-400' : item.color === 'orange' ? 'bg-orange-900/40 text-orange-400' : 'bg-red-900/40 text-red-400'}`}>
            {item.color === 'green' ? '✓' : item.color === 'orange' ? '⚠' : '✗'}
          </span>
          <div>
            <p class="font-semibold text-white text-sm">{item.msg}</p>
            <p class="text-white/55 text-xs mt-0.5">{item.type}</p>
          </div>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">هل يمكن تقصير مدة الحظر؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">
      في الحظر المؤقت (24-72 ساعة): <strong class="text-white">لا</strong>، المدة ثابتة ومبرمجة في النظام. الانتظار هو الحل الوحيد.
    </p>
    <p class="text-white/70 leading-relaxed mb-4">
      في الحظر المشدد: <strong class="text-white">ربما</strong>. تقديم طلب مراجعة احترافي وصادق قد يُعجّل قرار رفع الحظر قبل انتهاء المدة المذكورة.
    </p>
    <p class="text-white/70 leading-relaxed mb-8">
      في الحظر النهائي: <strong class="text-white">يحتاج تدخل</strong>. لا توجد مدة ثابتة — هذا يعتمد على نشاط المراجعة والدعم.
    </p>

    <div class="glass-dark rounded-2xl p-6 mt-8 text-center border border-white/10">
      <p class="font-semibold text-white mb-2">حظرك أطول من المتوقع؟</p>
      <p class="text-white/55 text-sm mb-4">تواصل معنا — نساعدك في تقييم وضعك وتسريع الاسترداد</p>
      <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">الأسئلة الشائعة</h2>
    <div class="space-y-3">
      {[
        {
          q: "كم تستغرق مدة حظر واتساب؟",
          a: "مدة حظر واتساب تعتمد على النوع: حظر مؤقت 24 ساعة إلى 72 ساعة، حظر مشدد أسبوع إلى عدة أسابيع، حظر نهائي غير محدد المدة ويحتاج مراجعة."
        },
        {
          q: "هل يمكن تقصير مدة حظر واتساب؟",
          a: "في الحظر المؤقت، المدة ثابتة ولا يمكن تقصيرها. في الحظر المشدد، تقديم طلب مراجعة فعّال قد يُعجّل الرفع. الحظر النهائي يحتاج مراجعة نشطة."
        },
        {
          q: "هل حظر واتساب دائم؟",
          a: "الحظر النهائي قد يكون دائماً في حالات المخالفات الجسيمة. لكن كثير من الحظر يمكن رفعه بطلب مراجعة، سواء أكان مؤقتاً أم مشدداً أم حتى بعض أنواع النهائي."
        }
      ].map(faq => (
        <details class="glass-dark rounded-xl border border-white/10 overflow-hidden">
          <summary class="px-5 py-4 font-semibold text-white cursor-pointer flex items-center justify-between gap-3">
            <span>{faq.q}</span>
            <span class="text-white/40 shrink-0 text-lg">+</span>
          </summary>
          <div class="px-5 pb-4 text-white/65 leading-relaxed text-sm">{faq.a}</div>
        </details>
      ))}
    </div>

    <div class="grid sm:grid-cols-3 gap-4 mt-12">
      {[
        { href: "/فك-حظر-واتساب/", title: "دليل فك الحظر الشامل" },
        { href: "/مدونة/حظر-واتساب-مشدد/", title: "حظر واتساب المشدد" },
        { href: "/مدونة/واتساب-محظور-7-أيام/", title: "واتساب محظور 7 أيام" },
      ].map(link => (
        <a href={link.href} class="glass-dark rounded-xl p-4 border border-white/10 hover:border-[#25D366]/40 transition-colors group">
          <p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366] transition-colors">{link.title} ←</p>
        </a>
      ))}
    </div>

  </article>
</BaseLayout>
