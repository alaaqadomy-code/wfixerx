          <tr class="border border-white/8 bg-[#0a1628]"><td class="p-4 text-white font-medium">عداد زمني (ساعات أو أيام)</td><td class="p-4 text-white/60">حظر مؤقت</td><td class="p-4 text-white/60">انتظر انتهاء العداد دون محاولات تسجيل</td></tr>
          <tr class="border border-white/8 bg-[#0d1e30]"><td class="p-4 text-white font-medium">رقمك محظور مع زر طلب مراجعة</td><td class="p-4 text-white/60">حظر مشدد</td><td class="p-4 text-white/60">قدّم طلب مراجعة واحداً من التطبيق</td></tr>
          <tr class="border border-white/8 bg-[#0a1628]"><td class="p-4 text-white font-medium">لا يمكن لهذا الحساب استخدام واتساب</td><td class="p-4 text-white/60">حظر قد يكون نهائياً</td><td class="p-4 text-white/60">اطلب تقييم الحالة قبل أي إجراء</td></tr>
          <tr class="border border-white/8 bg-[#0d1e30]"><td class="p-4 text-white font-medium">حسابك مقيد حالياً</td><td class="p-4 text-white/60">تقييد ميزات وليس حظراً كاملاً</td><td class="p-4 text-white/60">التزم بالقواعد وانتظر انتهاء التقييد</td></tr>
        </tbody>
      </table>
