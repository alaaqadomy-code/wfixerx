---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";

const faqs = [
        {
          q: "هل يمكن رفع حظر واتساب بعد استخدام نسخة معدّلة؟",
          a: "نعم في كثير من الحالات، خاصةً إذا كان الحظر الأول. الشرط: احذف النسخة المعدّلة تماماً، نزّل التطبيق الرسمي، وقدّم طلب مراجعة."
        },
        {
          q: "كيف تكشف واتساب النسخ المعدّلة؟",
          a: "واتساب تكشف النسخ المعدّلة من خلال التوقيع الرقمي للتطبيق، بروتوكول الاتصال المختلف، وبعض الخصائص التقنية الفريدة لكل نسخة معدّلة."
        },
        {
          q: "ما هي أكثر النسخ المعدّلة التي تسبب الحظر؟",
          a: "أكثر النسخ المعدّلة المعروفة: GB WhatsApp، WhatsApp Plus، WhatsApp Gold، FMWhatsApp. جميعها تخالف شروط الخدمة وتُعرّض حسابك للحظر."
        },
  { q: "كيف تكتشف واتساب أني أستخدم نسخة معدّلة؟", a: "لا يحتاج الأمر إلى تحليل سلوكك. التطبيق الرسمي يحمل توقيعاً رقمياً وبصمة محددة، والنسخ المعدّلة تتصل بخوادم واتساب بتوقيع مختلف وبطلبات لا تطابق ما يرسله التطبيق الأصلي. فتُعرف من أول اتصال تقريباً. ولهذا يصل الحظر بسرعة لمن ثبّت نسخة معدّلة حتى لو لم يرسل رسالة واحدة ولم يُبلّغ عنه أحد." },
  { q: "إذا حذفت النسخة المعدّلة هل يُرفع الحظر تلقائياً؟", a: "لا يُرفع وحده، لكن حذفها شرط لا يصحّ الطلب بدونه. الترتيب الصحيح: احذف النسخة المعدّلة نهائياً من الجهاز، ثم ثبّت واتساب الرسمي من المتجر الرسمي، ثم قدّم طلب المراجعة واذكر فيه صراحةً أنك أزلت التطبيق غير الرسمي وانتقلت إلى النسخة الرسمية ولن تعود. تقديم الطلب والنسخة المعدّلة ما زالت على الجهاز يُضعف فرصتك كثيراً." },
  { q: "هل يمكن نقل محادثاتي من النسخة المعدّلة إلى الرسمية؟", a: "النسخ المعدّلة تحفظ المحادثات في مجلد خاص بها على الجهاز بأسماء مختلفة عن مجلد واتساب الرسمي، ولا توجد طريقة رسمية مدعومة لنقلها. وقد ينجح نسخ مجلد النسخ الاحتياطي يدوياً قبل إلغاء التثبيت، لكنه غير مضمون ويختلف بحسب النسخة. والأهم: لا تحذف النسخة المعدّلة قبل أخذ نسخة من مجلدها إن كانت محادثاتك تهمّك." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "حظر واتساب بسبب نسخة معدّلة — كيف تسترد حسابك؟",
    "description": "تم حظر واتساب بسبب استخدام نسخة معدّلة؟ هذا الدليل يشرح سبب الحظر وكيف تسترد حسابك وما الخطوات الصحيحة.",
    "author": { "@type": "Organization", "name": "WFixerX" },
    "dateModified": "2026-10-13",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://wfixerx.com" },
      { "@type": "ListItem", "position": 2, "name": "المدونة", "item": "https://wfixerx.com/مدونة/" },
      { "@type": "ListItem", "position": 3, "name": "حظر واتساب بسبب نسخة معدّلة", "item": "https://wfixerx.com/مدونة/حظر-واتساب-بسبب-نسخة-معدلة/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.filter(f => !f.noSchema).map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
]);
---

<BaseLayout
  title="حظر واتساب بسبب نسخة معدّلة — كيف تسترد حسابك؟"
  description="تم حظر واتساب بسبب استخدام نسخة معدّلة؟ هذا الدليل يشرح سبب الحظر وكيف تسترد حسابك والخطوات الصحيحة."
  schema={schema}
>

  <nav class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#25D366] transition-colors">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li><a href="/مدونة/" class="hover:text-[#25D366] transition-colors">المدونة</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">حظر واتساب بسبب نسخة معدّلة</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-[#07111f] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs text-white/40 mb-4">أكتوبر 2026 · وقت القراءة: 5 دقائق</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6">
        حظر واتساب بسبب نسخة معدّلة — كيف تسترد حسابك؟
      </h1>
      <p class="text-lg text-white/70 leading-relaxed">
        استخدام نسخة معدّلة هو السبب الأول لحظر واتساب في العالم العربي. إذا وجدت نفسك في هذا الوضع، هذا الدليل يشرح لك بالضبط ما تفعله.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="quick-answer mb-10">
      <p class="text-xs font-semibold text-[#25D366] uppercase tracking-wider mb-2">الجواب السريع</p>
      <h2 class="text-xl font-bold text-white mb-3">تم الحظر بسبب نسخة معدّلة — ماذا تفعل؟</h2>
      <p class="text-white/75"><strong class="text-white">الخطوات الفورية:</strong> 1. احذف النسخة المعدّلة وكل ملفاتها. 2. نزّل التطبيق الرسمي من Google Play أو App Store. 3. قدّم طلب مراجعة. 4. اذكر في رسالتك أنك حذفت النسخة المعدّلة وعدت للتطبيق الرسمي.</p>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">لماذا تحظر واتساب بسبب النسخ المعدّلة؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">
      واتساب تكشف النسخ المعدّلة من خلال عدة طرق تقنية — التوقيع الرقمي للتطبيق مختلف عن التطبيق الرسمي، وبروتوكول الاتصال بخوادم واتساب يكون مختلفاً أيضاً.
    </p>
    <p class="text-white/70 leading-relaxed mb-4">
      الأهم من الكشف التقني هو أن النسخ المعدّلة تخالف اتفاقية الاستخدام بشكل صريح. واتساب لديها حق قانوني وتقني لحظر أي حساب يستخدمها.
    </p>

    <h2 class="text-2xl font-bold text-white mt-10 mb-6">النسخ المعدّلة الأكثر شيوعاً التي تسبب الحظر</h2>
    <div class="grid sm:grid-cols-2 gap-4 mb-8">
      {[
        { name: "GB WhatsApp", risk: "حظر شبه مؤكد" },
        { name: "WhatsApp Plus", risk: "حظر شبه مؤكد" },
        { name: "FMWhatsApp", risk: "خطر عالٍ" },
        { name: "WhatsApp Gold", risk: "خطر عالٍ" },
        { name: "OGWhatsApp", risk: "خطر متوسط-عالٍ" },
        { name: "أي نسخة من مصادر غير رسمية", risk: "خطر متوسط" },
      ].map(app => (
        <div class="bg-red-950/20 border border-red-500/20 rounded-xl p-4 flex items-center justify-between gap-3">
          <span class="font-bold text-white text-sm">{app.name}</span>
          <span class="text-xs bg-red-900/50 text-red-300 px-2 py-1 rounded-full font-medium">{app.risk}</span>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-6">خطوات استرداد الحساب بعد حظر النسخة المعدّلة</h2>
    <ol class="space-y-5 mb-8">
      {[
        {
          title: "احذف النسخة المعدّلة كلياً",
          desc: "لا يكفي إلغاء تثبيتها — احذف ملفاتها من مجلد WhatsApp في تطبيق الملفات أيضاً. بعض النسخ تترك ملفات حتى بعد الحذف."
        },
        {
          title: "نزّل التطبيق الرسمي",
          desc: "من Google Play (أندرويد) أو App Store (آيفون) فقط. لا تثق بأي رابط تنزيل خارجي حتى لو ادّعى أنه رسمي."
        },
        {
          title: "قدّم طلب مراجعة",
          desc: "داخل التطبيق إذا ظهر الخيار، أو عبر support.whatsapp.com. في رسالتك: اذكر أنك حذفت النسخة المعدّلة وعدت للتطبيق الرسمي وأنك ملتزم بالشروط."
        },
        {
          title: "انتظر الرد",
          desc: "قد يستغرق من يوم لأسبوعَين. لا تُرسل طلبات متكررة."
        },
        {
          title: "إذا رُفض الطلب",
          desc: "يمكن إعادة المحاولة بعد أسبوع. إذا استمر الرفض، تواصل معنا لتقييم خياراتك."
        },
      ].map((step, i) => (
        <li class="flex gap-4">
          <span class="w-9 h-9 rounded-full bg-[#25D366]/15 text-[#25D366] flex items-center justify-center font-bold shrink-0 mt-0.5 text-sm border border-[#25D366]/30">{i + 1}</span>
          <div>
            <p class="font-bold text-white mb-1">{step.title}</p>
            <p class="text-white/65 text-sm leading-relaxed">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">هل طلب المراجعة ينجح دائماً بعد النسخة المعدّلة؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">ليس دائماً، لكن نسبة النجاح أعلى في هذه الحالات:</p>
    <ul class="space-y-2 text-white/70 mb-8">
      {[
        "إذا كان هذا أول حظر للحساب.",
        "إذا كان الحساب قديماً ونشطاً (أكثر من 6 أشهر).",
        "إذا لم تكن هناك مخالفات أخرى مسجّلة على الحساب.",
        "إذا كانت رسالة المراجعة احترافية وصادقة.",
      ].map(c => (
        <li class="flex items-start gap-3">
          <span class="text-[#25D366] font-bold shrink-0 mt-0.5">✓</span>
          {c}
        </li>
      ))}
    </ul>

    <div class="glass-dark rounded-2xl p-6 mt-8 text-center border border-white/10">
      <p class="font-semibold text-white mb-2">رُفض طلب مراجعتك؟</p>
      <p class="text-white/55 text-sm mb-4">نساعدك في تقييم الوضع وإيجاد أفضل مسار للاسترداد</p>
      <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">الأسئلة الشائعة</h2>
    <div class="space-y-3">
      {faqs.map(faq => (
        <details class="glass-dark rounded-xl border border-white/10 overflow-hidden">
          <summary class="px-5 py-4 font-semibold text-white cursor-pointer flex items-center justify-between gap-3">
            <span>{faq.q}</span>
            <span class="text-white/40 shrink-0 text-lg">+</span>
          </summary>
          <div class="px-5 pb-4 text-white/65 leading-relaxed text-sm">{faq.a}</div>
        </details>
      ))}
    </div>

    <div class="grid sm:grid-cols-3 gap-4 mt-12">
      {[
        { href: "/فك-حظر-واتساب/", title: "دليل فك الحظر الشامل" },
        { href: "/مدونة/أسباب-حظر-واتساب/", title: "أسباب حظر واتساب" },
        { href: "/مدونة/كيف-تتجنب-حظر-واتساب/", title: "كيف تتجنب الحظر" },
      ].map(link => (
        <a href={link.href} class="glass-dark rounded-xl p-4 border border-white/10 hover:border-[#25D366]/40 transition-colors group">
          <p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366] transition-colors">{link.title} ←</p>
        </a>
      ))}
    </div>

  </article>
</BaseLayout>
