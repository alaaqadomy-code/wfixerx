---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "الفرق بين حظر واتساب المؤقت والنهائي — كيف تعرف نوعك؟",
    "description": "ما الفرق بين حظر واتساب المؤقت والنهائي؟ كيف تعرف أيهما أصابك؟ وما الحل المناسب لكل نوع؟",
    "author": { "@type": "Organization", "name": "WFixerX" },
    "dateModified": "2026-10-13",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://wfixerx.com" },
      { "@type": "ListItem", "position": 2, "name": "المدونة", "item": "https://wfixerx.com/مدونة/" },
      { "@type": "ListItem", "position": 3, "name": "الفرق بين حظر واتساب المؤقت والنهائي", "item": "https://wfixerx.com/مدونة/فرق-حظر-واتساب-مؤقت-ونهائي/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "ما الفرق بين حظر واتساب المؤقت والنهائي؟", "acceptedAnswer": { "@type": "Answer", "text": "الحظر المؤقت: يُعرض مع عداد وقت وينتهي تلقائياً خلال 24-72 ساعة. الحظر النهائي: يُعرض بدون عداد وقت، ولا يُرفع تلقائياً، ويحتاج تدخل بطلب مراجعة أو مساعدة متخصصة." } },
      { "@type": "Question", "name": "هل يمكن رفع الحظر النهائي عن واتساب؟", "acceptedAnswer": { "@type": "Answer", "text": "نعم، بعض أنواع الحظر النهائي يمكن رفعها بطلب مراجعة ناجح. النجاح يعتمد على تاريخ الحساب وسبب الحظر وجودة طلب المراجعة." } },
      { "@type": "Question", "name": "كيف أعرف إذا كان حظري مؤقتاً أو نهائياً؟", "acceptedAnswer": { "@type": "Answer", "text": "افتح واتساب — إذا ظهر عداد وقت فالحظر مؤقت. إذا ظهرت رسالة بدون عداد فالحظر نهائي. وجود زر 'طلب المراجعة' مع الحظر النهائي علامة جيدة." } }
    ]
  }
]);
---

<BaseLayout
  title="الفرق بين حظر واتساب المؤقت والنهائي — كيف تعرف نوعك؟"
  description="ما الفرق بين حظر واتساب المؤقت والنهائي؟ كيف تعرف أيهما أصابك؟ وما الحل المناسب لكل نوع؟"
  schema={schema}
>

  <nav class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#25D366] transition-colors">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li><a href="/مدونة/" class="hover:text-[#25D366] transition-colors">المدونة</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">الفرق بين حظر واتساب المؤقت والنهائي</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-[#07111f] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs text-white/40 mb-4">أكتوبر 2026 · وقت القراءة: 5 دقائق</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6">
        الفرق بين حظر واتساب المؤقت والنهائي — كيف تعرف نوعك؟
      </h1>
      <p class="text-lg text-white/70 leading-relaxed">
        ليس كل حظر واتساب متساوياً. معرفة نوع الحظر تُحدّد خطوتك التالية — وتُجنّبك إضاعة الوقت في الحل الخاطئ.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="quick-answer mb-10">
      <p class="text-xs font-semibold text-[#25D366] uppercase tracking-wider mb-2">الجواب السريع</p>
      <h2 class="text-xl font-bold text-white mb-3">كيف أعرف نوع حظري؟</h2>
      <p class="text-white/75"><strong class="text-white">الحظر المؤقت:</strong> يظهر عداد وقت (ساعات أو أيام) وينتهي تلقائياً. <strong class="text-white">الحظر النهائي:</strong> لا يوجد عداد، والرسالة تقول "لا يمكن لهذا الحساب..." بدون وقت محدد. الحل في كل الحالات: طلب مراجعة أسرع من الانتظار.</p>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-6">مقارنة شاملة: حظر مؤقت مقابل نهائي</h2>
    <div class="overflow-x-auto mb-8 rounded-xl border border-white/10">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-white/5 border-b border-white/10">
            <th class="p-4 text-right font-semibold text-white/70">المعيار</th>
            <th class="p-4 text-right font-semibold text-green-400">حظر مؤقت</th>
            <th class="p-4 text-right font-semibold text-red-400">حظر نهائي</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/8">
          {[
            ["عداد الوقت", "✓ يظهر (ساعات/أيام)", "✗ لا يظهر"],
            ["رُفع تلقائياً؟", "نعم — تلقائياً", "لا — يحتاج تدخل"],
            ["زر طلب المراجعة", "أحياناً يظهر", "يظهر في الغالب"],
            ["شدة المخالفة", "خفيفة - متوسطة", "متوسطة - جسيمة"],
            ["الاسترداد بالمراجعة", "سهل جداً", "ممكن حسب الحالة"],
            ["المدة المعتادة", "24 ساعة - أسبوع", "غير محدودة"],
          ].map(([m, temp, perm]) => (
            <tr>
              <td class="p-4 text-white/70 font-medium">{m}</td>
              <td class="p-4 text-green-400">{temp}</td>
              <td class="p-4 text-red-400">{perm}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">علامات الحظر المؤقت</h2>
    <div class="space-y-3 mb-8">
      {[
        "يظهر عداد وقت واضح مع رسالة الحظر (مثلاً: 'محظور لمدة 24 ساعة')",
        "الحساب يعمل تلقائياً بعد انتهاء المدة",
        "يمكن استقبال المكالمات أحياناً حتى خلال الحظر",
        "الرسائل الواردة تصل لكن لا يمكن الرد",
        "سبب الحظر عادةً أوضح (رسائل كثيرة، إبلاغات خفيفة)",
      ].map(s => (
        <div class="flex items-start gap-3 p-3 bg-green-950/20 rounded-xl border border-green-500/15">
          <span class="text-green-400 font-bold shrink-0 mt-0.5">✓</span>
          <span class="text-white/70 text-sm">{s}</span>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">علامات الحظر النهائي</h2>
    <div class="space-y-3 mb-8">
      {[
        "لا يوجد عداد وقت — رسالة 'لا يمكن لهذا الحساب استخدام واتساب'",
        "لا يُرفع الحظر مهما انتظرت",
        "لا يمكن إجراء أو استقبال مكالمات",
        "رسائلك لا تصل وتبقى برمز ساعة واحدة",
        "يظهر زر 'طلب مراجعة' — هذا خيارك الأول",
      ].map(s => (
        <div class="flex items-start gap-3 p-3 bg-red-950/20 rounded-xl border border-red-500/15">
          <span class="text-red-400 font-bold shrink-0 mt-0.5">✗</span>
          <span class="text-white/70 text-sm">{s}</span>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">ماذا تفعل في كل حالة؟</h2>
    <div class="grid sm:grid-cols-2 gap-4 mb-8">
      <div class="glass-dark rounded-xl p-5 border border-green-500/20">
        <p class="font-bold text-green-400 mb-3">الحظر المؤقت</p>
        <ol class="space-y-2 text-white/65 text-sm">
          {["انتظر انتهاء المدة", "قدّم طلب مراجعة إذا أردت تسريع الرفع", "راجع سبب الحظر حتى لا يتكرر", "استخدم التطبيق الرسمي فقط"].map((s, i) => (
            <li class="flex gap-2"><span class="text-green-400 font-bold shrink-0">{i+1}.</span>{s}</li>
          ))}
        </ol>
      </div>
      <div class="glass-dark rounded-xl p-5 border border-red-500/20">
        <p class="font-bold text-red-400 mb-3">الحظر النهائي</p>
        <ol class="space-y-2 text-white/65 text-sm">
          {["اضغط زر 'طلب المراجعة' فوراً", "اكتب رسالة احترافية وصادقة", "انتظر 24-72 ساعة للرد", "إذا رُفض، تواصل معنا لتقييم الوضع"].map((s, i) => (
            <li class="flex gap-2"><span class="text-red-400 font-bold shrink-0">{i+1}.</span>{s}</li>
          ))}
        </ol>
      </div>
    </div>

    <div class="glass-dark rounded-2xl p-6 mt-8 text-center border border-white/10">
      <p class="font-semibold text-white mb-2">غير متأكد من نوع حظرك؟</p>
      <p class="text-white/55 text-sm mb-5">أرسل لنا صورة من رسالة الحظر وسنقيّم وضعك فوراً</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تلغرام</a>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-6">الأسئلة الشائعة</h2>
    <div class="space-y-3">
      {[
        { q: "ما الفرق بين حظر واتساب المؤقت والنهائي؟", a: "الحظر المؤقت: يُعرض مع عداد وقت وينتهي تلقائياً خلال 24-72 ساعة. الحظر النهائي: يُعرض بدون عداد وقت، ولا يُرفع تلقائياً، ويحتاج تدخل بطلب مراجعة أو مساعدة متخصصة." },
        { q: "هل يمكن رفع الحظر النهائي عن واتساب؟", a: "نعم، بعض أنواع الحظر النهائي يمكن رفعها بطلب مراجعة ناجح. النجاح يعتمد على تاريخ الحساب وسبب الحظر وجودة طلب المراجعة." },
        { q: "كيف أعرف إذا كان حظري مؤقتاً أو نهائياً؟", a: "افتح واتساب — إذا ظهر عداد وقت فالحظر مؤقت. إذا ظهرت رسالة بدون عداد فالحظر نهائي. وجود زر 'طلب المراجعة' مع الحظر النهائي علامة جيدة." }
      ].map(faq => (
        <details class="glass-dark rounded-xl border border-white/10 overflow-hidden">
          <summary class="px-5 py-4 font-semibold text-white cursor-pointer flex items-center justify-between gap-3">
            <span>{faq.q}</span>
            <span class="text-white/40 shrink-0 text-lg">+</span>
          </summary>
          <div class="px-5 pb-4 text-white/65 leading-relaxed text-sm">{faq.a}</div>
        </details>
      ))}
    </div>

    <div class="grid sm:grid-cols-2 gap-4 mt-12">
      {[
        { href: "/فك-حظر-واتساب/", title: "دليل فك الحظر الشامل" },
        { href: "/مدونة/أنواع-حظر-واتساب/", title: "أنواع حظر واتساب" },
        { href: "/مدونة/حظر-واتساب-24-ساعة/", title: "حظر واتساب 24 ساعة" },
        { href: "/مدونة/حظر-واتساب-مشدد/", title: "حظر واتساب المشدد" },
      ].map(link => (
        <a href={link.href} class="glass-dark rounded-xl p-4 border border-white/10 hover:border-[#25D366]/40 transition-colors group">
          <p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366] transition-colors">{link.title} ←</p>
        </a>
      ))}
    </div>

  </article>
</BaseLayout>
