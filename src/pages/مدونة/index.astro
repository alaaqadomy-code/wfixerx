---
import BaseLayout from '../../layouts/BaseLayout.astro';

// المقالات تُكتشف تلقائياً من ملفات هذا المجلد وقت البناء:
// أي ملف مقال جديد يُضاف إلى src/pages/مدونة/ يظهر هنا دون تعديل يدوي.
// العنوان والوصف يُقرآن من وسم <BaseLayout title= description=>، ووقت القراءة من سطر
// "وقت القراءة"، والتاريخ من datePublished (أو dateModified) في الـ schema.
const files = import.meta.glob("./*.astro", { query: "?raw", import: "default", eager: true });

// وسوم مميزة اختيارية حسب الـ slug
const TAGS = {
  "الدليل-الشامل-لفك-حظر-واتساب": "الدليل الشامل",
  "أسباب-حظر-واتساب": "الأكثر قراءةً",
  "ماذا-تفعل-عند-حظر-واتساب-فجأة": "مهم",
};
// مقالات تُثبّت في أعلى القائمة بالترتيب
const PINNED = ["الدليل-الشامل-لفك-حظر-واتساب"];

const MONTHS = ["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"];
const attr = (tag, re) => (tag.match(re) || [])[1] || "";

const posts = Object.entries(files)
  .filter(([path]) => !path.endsWith("/index.astro"))
  .map(([path, raw]) => {
    const slug = path.replace(/^\.\//, "").replace(/\.astro$/, "");
    const layoutTag = (raw.match(/<BaseLayout\b[\s\S]*?>/) || [""])[0];
    const title = attr(layoutTag, /\stitle="([^"]*)"/);
    const desc = attr(layoutTag, /\sdescription="([^"]*)"/);
    const readTime = ((raw.match(/وقت القراءة:\s*([^<\n]+)/) || [])[1] || "").trim();
    const iso = (raw.match(/"datePublished":\s*"(\d{4}-\d{2}-\d{2})"/) || raw.match(/"dateModified":\s*"(\d{4}-\d{2}-\d{2})"/) || [])[1] || "";
    const date = iso ? `${MONTHS[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}` : "";
    return { slug, title, desc, readTime, iso, date, tag: TAGS[slug] || "" };
  })
  .filter((p) => p.title)
  .sort((a, b) => {
    const pa = PINNED.indexOf(a.slug), pb = PINNED.indexOf(b.slug);
    if (pa !== -1 || pb !== -1) return (pa === -1 ? 99 : pa) - (pb === -1 ? 99 : pb);
    return b.iso.localeCompare(a.iso) || a.title.localeCompare(b.title, "ar");
  });
---

<BaseLayout
  title="مدونة WFixerX — كل ما تحتاجه عن حظر واتساب"
  description="ثلاثة وخمسون دليلاً مجانياً عن حظر واتساب: الأنواع والمدد والأسباب، طلب المراجعة، رسائل الخطأ الحرفية، حسابات الأعمال، والنسخ الاحتياطي والحماية."
>

  <header class="bg-gradient-to-b from-[#07111f] to-[#060d1a] py-14 px-4 sm:px-6 text-center border-b border-white/8">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">مدونة WFixerX</h1>
      <p class="text-white/60 text-lg mb-6">كل ما تحتاجه عن حظر واتساب — شرح بسيط ودقيق</p>
      <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2 text-sm text-white/50">
        <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
        {posts.length} مقالة شاملة
      </div>
    </div>
  </header>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="space-y-4">
      {posts.map(post => (
        <a href={`/مدونة/${post.slug}/`} class="glass-dark block rounded-2xl p-5 border border-white/10 hover:border-[#25D366]/30 transition-all group">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-xs text-white/30">{post.date}</span>
            <span class="w-1 h-1 rounded-full bg-white/20" aria-hidden="true"></span>
            <span class="text-xs text-white/30">{post.readTime}</span>
            {post.tag && (
              <span class="text-xs bg-[#25D366]/15 text-[#25D366] px-2 py-0.5 rounded-full border border-[#25D366]/20 font-medium">{post.tag}</span>
            )}
          </div>
          <h2 class="text-base sm:text-lg font-bold text-white/85 mb-2 group-hover:text-white transition-colors leading-snug">{post.title}</h2>
          <p class="text-white/45 text-sm leading-relaxed">{post.desc}</p>
          <div class="mt-3 flex items-center gap-1 text-[#25D366]/70 text-sm font-medium group-hover:text-[#25D366] transition-colors">
            اقرأ المقال
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="rotate-180" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 glass-dark rounded-2xl p-6 text-center border border-white/10">
      <p class="font-semibold text-white mb-2">واجهت مشكلة لم تجد جوابها في المدونة؟</p>
      <p class="text-white/50 text-sm mb-4">تواصل معنا مباشرةً — نجيب على كل الأسئلة</p>
      <a href="https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%B9%D9%86%D8%AF%D9%8A%20%D8%B3%D8%A4%D8%A7%D9%84%20%D8%AD%D9%88%D9%84%20%D8%AD%D8%B8%D8%B1%20%D9%88%D8%A7%D8%AA%D8%B3%D8%A7%D8%A8" target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
    </div>
  </div>
</BaseLayout>
