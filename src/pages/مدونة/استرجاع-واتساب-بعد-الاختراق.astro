<BaseLayout title="استرجاع واتساب بعد الاختراق أو التهكير: الخطوات العاجلة" description="تم اختراق حسابك على واتساب؟ دليل عملي لاسترجاعه بالتسجيل برمز التحقق، وإخراج المخترق، وتفعيل التحقق بخطوتين، وحماية رقمك في السعودية والإمارات والخليج." schema={schema}>

  <nav class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
