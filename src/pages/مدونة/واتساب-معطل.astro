<BaseLayout title="واتساب معطل — هل العطل منك أم من الخوادم أم حسابك؟ شخّص بدقة" description="واتساب معطل ولا يرسل ولا يستقبل؟ خطوات تشخيص تفصل بين عطل خوادم واتساب العالمي، ومشكلة هاتفك أو شبكتك، وحالة حسابك المحظور أو المقيد، مع حل كل مسار." schema={schema}>

  <nav class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
