---
import BaseLayout from '../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";

const faqs = [
  {
    cat: "الحظر العام",
    items: [
      { q: "كيف أعرف إذا كان حسابي محظوراً نهائياً؟", a: "إذا ظهرت رسالة 'لا يمكن لهذا الحساب استخدام واتساب بعد الآن' فالحظر نهائي. إذا ظهر عداد وقت فالحظر مؤقت." },
      { q: "كم مدة حظر واتساب؟", a: "الحظر المؤقت يستمر من 24 ساعة إلى أسبوع. الحظر المشدد أسابيع. الحظر النهائي لا يُرفع تلقائياً — يحتاج طلب مراجعة." },
      { q: "لماذا تم حظر واتساب دون سبب واضح؟", a: "في معظم الحالات يكون السبب تقارير من مستخدمين آخرين، أو إرسال رسائل جماعية، أو استخدام نسخ معدّلة من التطبيق." },
      { q: "هل يمكن حذف الحساب المحظور وإنشاء حساب جديد؟", a: "نعم، يمكنك استخدام رقم هاتف مختلف لإنشاء حساب جديد. لكن إذا كنت تريد نفس الرقم القديم، يجب محاولة رفع الحظر." },
    ]
  },
  {
    cat: "طلب المراجعة",
    items: [
      { q: "أين يوجد رابط طلب مراجعة واتساب؟", a: "الرابط الرسمي هو support.whatsapp.com — أو اضغط على زر 'طلب مراجعة' الظاهر في شاشة الحظر داخل التطبيق." },
      { q: "ماذا أكتب في طلب المراجعة؟", a: "اشرح استخدامك المشروع للحساب، أكد أنك لم تنتهك الشروط عن قصد، واطلب المراجعة بلهجة هادئة ومهنية." },
      { q: "كم مرة يمكن تقديم طلب المراجعة؟", a: "يمكن تقديم أكثر من طلب، لكن انتظر أسبوعاً على الأقل بين كل محاولة، وغيّر صياغة الرسالة في كل مرة." },
      { q: "ماذا يعني 'طلب المراجعة غير متاح'؟", a: "يعني أن واتساب لم تفعّل زر المراجعة لحالتك بعد. جرّب عبر support.whatsapp.com مباشرة، أو انتظر أسبوعاً وأعد المحاولة." },
    ]
  },
  {
    cat: "خدمة WFixerX",
    items: [
      { q: "هل تطلبون كلمة المرور أو رمز التحقق؟", a: "لا، أبداً. WFixerX لا تطلب كلمة المرور أو رمز OTP بأي شكل. أي طلب لهذه البيانات هو احتيال." },
      { q: "هل تضمنون فك الحظر؟", a: "لا. النتيجة النهائية قرار واتساب وليست بيدنا. نضمن أننا سنبذل أقصى جهد ونقدم طلباً احترافياً يزيد من فرص القبول." },
      { q: "كم تكلف الخدمة؟", a: "السعر يختلف حسب نوع الحظر ومستوى التعقيد. التقييم الأولي مجاني — تواصل معنا لتعرف التفاصيل." },
      { q: "هل تعملون مع حسابات Business؟", a: "نعم، حسابات Business تحصل على أولوية قصوى لأن كل يوم تأخير يعني خسارة تجارية." },
    ]
  },
  {
    cat: "الأمان والخصوصية",
    items: [
      { q: "هل مشاركة معلوماتي مع WFixerX آمنة؟", a: "نعم. لا نطلب بيانات سرية أبداً. نحتاج فقط وصف المشكلة ونوع الحساب. لا نشارك معلوماتك مع أي جهة." },
      { q: "ما الفرق بين WFixerX وخدمات أخرى غير موثوقة؟", a: "WFixerX لا تطلب كلمة مرور ولا رمز تحقق ولا تضمن نتائج مستحيلة. إذا طلبت أي خدمة هذه البيانات، هذا علامة احتيال." },
    ]
  }
];

const schemaFaqs = faqs.flatMap(c => c.items).map(f => ({
  "@type": "Question",
  "name": f.q,
  "acceptedAnswer": { "@type": "Answer", "text": f.a }
}));

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": schemaFaqs
});
---

<BaseLayout
  title="الأسئلة الشائعة — فك حظر واتساب | WFixerX"
  description="أسئلة حظر واتساب وأجوبتها: الأنواع والمدد، طلب المراجعة وصيغته، رسالة «لا يمكن لهذا الحساب»، حسابات الأعمال، ولماذا لا تشارك رمز التحقق أبداً."
  schema={schema}
>

  <header class="bg-gradient-to-b from-[#07111f] to-[#060d1a] py-12 px-4 sm:px-6 text-center border-b border-white/8">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">الأسئلة الشائعة</h1>
      <p class="text-white/55 text-lg">إجابات على أكثر الأسئلة تكراراً حول حظر واتساب وخدمة WFixerX</p>
    </div>
  </header>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    {faqs.map(section => (
      <div class="mb-10">
        <h2 class="text-xl font-bold text-white mb-4 pb-2 border-b border-white/10">{section.cat}</h2>
        <div class="space-y-3">
          {section.items.map(faq => (
            <details class="glass-dark border border-white/10 rounded-2xl overflow-hidden group">
              <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-white/5 transition-colors">
                <span class="font-semibold text-white text-base">{faq.q}</span>
                <svg class="w-5 h-5 text-white/40 group-open:rotate-180 transition-transform shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-5 pb-5 text-white/65 text-sm leading-relaxed border-t border-white/8 pt-4">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}

    <div class="bg-[#0A1628] rounded-2xl p-8 text-center text-white mt-8">
      <h2 class="text-xl font-bold mb-3">لم تجد إجابتك؟</h2>
      <p class="text-white/60 mb-6">تواصل معنا مباشرة</p>
      <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa pulse-glow">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        تواصل عبر واتساب
      </a>
    </div>
  </div>

    <div class="wf-crawl-links max-w-5xl mx-auto px-4 sm:px-6 mt-12 pt-8 border-t border-white/8">
      <h2 class="text-lg font-bold text-white mb-4">أدلة تفصيلية لكل سؤال</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/مدونة/كم-مدة-حظر-واتساب/" class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group"><p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">كم مدة حظر واتساب؟ ←</p></a>
        <a href="/مدونة/واتساب-محظور-7-أيام/" class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group"><p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">واتساب محظور 7 أيام ←</p></a>
        <a href="/مدونة/مشكلة-الواتس-اب-اليوم/" class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group"><p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">هل واتساب معطل اليوم؟ ←</p></a>
        <a href="/مدونة/واتساب-ويب-لا-يعمل/" class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group"><p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">واتساب ويب لا يعمل ←</p></a>
        <a href="/مدونة/رمز-تحقق-واتساب/" class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group"><p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">رمز التحقق: لا تشاركه أبداً ←</p></a>
        <a href="/مدونة/استخدام-واتساب-على-جهازين/" class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group"><p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">واتساب على جهازين بلا حظر ←</p></a>
        <a href="/مدونة/واتساب-معطل/" class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group"><p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">واتساب معطل: منك أم من الخوادم؟ ←</p></a>
      </div>
    </div>
</BaseLayout>
