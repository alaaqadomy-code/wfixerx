---
import BaseLayout from '../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "حظر واتساب — الأنواع والأسباب وكيف تتعامل معه",
    "description": "دليل شامل عن حظر واتساب: أنواع الحظر، أسبابه، مدته، وكيفية التعامل مع كل نوع.",
    "author": { "@type": "Organization", "name": "WFixerX" },
    "dateModified": "2026-10-13",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "ما هو حظر واتساب؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "حظر واتساب هو تقييد تفرضه شركة WhatsApp على حساب انتهك شروط الاستخدام. يمنع صاحبه من إرسال أو استقبال الرسائل. ثلاثة أنواع رئيسية: مؤقت (24-72 ساعة)، مشدد (أسابيع)، ونهائي (دائم)."
        }
      },
      {
        "@type": "Question",
        "name": "كم مدة حظر واتساب؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "مدة حظر واتساب تعتمد على نوعه: المؤقت 24-72 ساعة يُرفع تلقائياً. المشدد أسابيع ويحتاج طلب مراجعة. النهائي دائم ولا يُرفع تلقائياً."
        }
      },
      {
        "@type": "Question",
        "name": "هل يمكن فك حظر واتساب؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "نعم، يمكن فك حظر واتساب في كثير من الحالات. الحظر المؤقت يُرفع وحده. الحظر المشدد يُرفع عبر طلب مراجعة. الحظر النهائي يحتاج متابعة متخصصة."
        }
      },
      {
        "@type": "Question",
        "name": "لماذا يُحظر حساب واتساب؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "أسباب حظر واتساب: استخدام نسخ معدّلة (GB WhatsApp)، إرسال رسائل جماعية، تلقي كثير من التقارير، استخدام برامج أتمتة، أو نشر محتوى مخالف."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://wfixerx.com" },
      { "@type": "ListItem", "position": 2, "name": "حظر واتساب", "item": "https://wfixerx.com/حظر-واتساب/" }
    ]
  }
]);
---

<BaseLayout
  title="حظر واتساب — الأنواع والأسباب وكيف تتعامل معه"
  description="دليل شامل عن حظر واتساب: ما هو، أنواع الحظر، أسبابه، كم يستمر، وكيف تتعامل مع كل نوع لاسترداد حسابك."
  schema={schema}
>

  <nav class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#1A3C6E]">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">حظر واتساب</li>
    </ol>
  </nav>

  <header class="hero-glow py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-block bg-red-500/20 text-red-300 text-sm px-3 py-1 rounded-full mb-6 font-medium">
        مشكلة شائعة في 10 دول عربية
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold text-white leading-tight mb-6">
        حظر واتساب
        <span class="block text-[#25D366] mt-2">الدليل الشامل 2026</span>
      </h1>
      <p class="text-lg sm:text-xl text-white/70 leading-relaxed mb-10 max-w-2xl mx-auto">
        كل ما تحتاج معرفته عن حظر واتساب — أنواعه، أسبابه، مدته، وكيف تتعامل معه
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تواصل عبر تلغرام</a>
      </div>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="quick-answer mb-10">
      <p class="text-xs font-semibold text-[#1A3C6E] uppercase tracking-wider mb-2">الجواب السريع</p>
      <h2 class="text-xl font-bold text-white mb-3">ما هو حظر واتساب؟</h2>
      <p class="text-white/70">حظر واتساب هو تقييد تفرضه شركة WhatsApp على حساب انتهك شروط الاستخدام، يمنعه من إرسال أو استقبال الرسائل. ثلاثة أنواع رئيسية: <strong>مؤقت</strong> (24-72 ساعة، يُرفع وحده)، <strong>مشدد</strong> (أسابيع، يحتاج مراجعة)، <strong>نهائي</strong> (دائم، يحتاج متابعة متخصصة).</p>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-6">أنواع حظر واتساب</h2>

    <div class="grid sm:grid-cols-3 gap-4 mb-10">
      {[
        {
          title: "الحظر المؤقت",
          duration: "24-72 ساعة",
          desc: "يُرفع تلقائياً. لا تحتاج أي إجراء سوى الانتظار.",
          color: "green",
          icon: "⏱️"
        },
        {
          title: "الحظر المشدد",
          duration: "أسابيع",
          desc: "يحتاج طلب مراجعة رسمي لرفعه.",
          color: "orange",
          icon: "⚠️"
        },
        {
          title: "الحظر النهائي",
          duration: "دائم",
          desc: "لا يُرفع تلقائياً. يحتاج متابعة متخصصة.",
          color: "red",
          icon: "🔒"
        }
      ].map(t => (
        <div class={`rounded-2xl p-5 border-2 ${t.color === 'green' ? 'border-green-700/40 bg-green-900/20' : t.color === 'orange' ? 'border-orange-700/40 bg-orange-900/20' : 'border-red-700/40 bg-red-900/20'}`}>
          <div class="text-3xl mb-3">{t.icon}</div>
          <h3 class={`font-bold text-lg mb-1 ${t.color === 'green' ? 'text-green-300' : t.color === 'orange' ? 'text-orange-300' : 'text-red-300'}`}>{t.title}</h3>
          <p class={`text-sm font-semibold mb-2 ${t.color === 'green' ? 'text-green-400' : t.color === 'orange' ? 'text-orange-400' : 'text-red-400'}`}>المدة: {t.duration}</p>
          <p class={`text-sm ${t.color === 'green' ? 'text-green-300/80' : t.color === 'orange' ? 'text-orange-200' : 'text-red-300/80'}`}>{t.desc}</p>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-6">أسباب حظر واتساب</h2>
    <div class="grid sm:grid-cols-2 gap-4 mb-10">
      {[
        { title: "نسخ معدّلة", desc: "GB WhatsApp وغيرها — السبب الأكثر شيوعاً للحظر النهائي" },
        { title: "رسائل جماعية (سبام)", desc: "إرسال نفس الرسالة لعدد كبير دون معرفة مسبقة" },
        { title: "تقارير المستخدمين", desc: "البلاغات تتراكم وتؤدي لقرار تلقائي" },
        { title: "برامج الأتمتة", desc: "أي برنامج يدير واتساب خارج API الرسمي" },
        { title: "محتوى مخالف", desc: "مواد محظورة تؤدي لحظر فوري ونهائي" },
        { title: "إضافة بلا إذن", desc: "إضافة أشخاص لمجموعات ويبلغون عنك باستمرار" },
      ].map(c => (
        <div class="glass-dark border border-white/10 rounded-xl p-4">
          <h3 class="font-bold text-white mb-1">{c.title}</h3>
          <p class="text-white/55 text-sm">{c.desc}</p>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-6">كيف تتعامل مع حظر واتساب؟</h2>
    <ol class="space-y-4 mb-10">
      {[
        { step: "حدّد نوع الحظر", desc: "هل يظهر عداد وقت؟ هل الرسالة تقول 'لا يمكن استخدام واتساب'؟ هذا يحدد المسار." },
        { step: "أوقف السلوك المخالف", desc: "إذا كنت تستخدم نسخة معدّلة أو تُرسل جماعياً — أوقف فوراً." },
        { step: "للحظر المؤقت: انتظر", desc: "لا تفتح التطبيق خلال مدة الحظر. سيُرفع تلقائياً." },
        { step: "للحظر المشدد: قدّم مراجعة", desc: "اضغط 'طلب مراجعة' أو توجّه لـ support.whatsapp.com." },
        { step: "للحظر النهائي: اطلب مساعدة", desc: "تواصل معنا لتقييم الحالة ومعرفة الخيارات المتاحة." },
      ].map((s, i) => (
        <li class="flex gap-4 glass-dark border border-white/10 rounded-xl p-4">
          <span class="w-8 h-8 bg-[#1A3C6E] text-white rounded-full flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">{i + 1}</span>
          <div>
            <p class="font-bold text-white mb-1">{s.step}</p>
            <p class="text-white/65 text-sm">{s.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="bg-[#0A1628] rounded-2xl p-6 text-white text-center mb-10">
      <p class="font-bold text-xl mb-2">حسابك محظور الآن؟</p>
      <p class="text-white/60 text-sm mb-5">تواصل معنا وسنساعدك في تقييم الحالة ومعرفة أفضل خطوة</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">تلغرام</a>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mb-6">الأسئلة الشائعة عن حظر واتساب</h2>
    <div class="space-y-3 mb-10">
      {[
        {
          q: "كم مدة حظر واتساب؟",
          a: "مدة حظر واتساب تعتمد على نوعه: المؤقت 24-72 ساعة يُرفع تلقائياً. المشدد أسابيع ويحتاج طلب مراجعة. النهائي دائم ولا يُرفع تلقائياً."
        },
        {
          q: "هل يمكن فك حظر واتساب؟",
          a: "نعم، في كثير من الحالات. الحظر المؤقت يُرفع وحده. الحظر المشدد يُرفع عبر طلب مراجعة. الحظر النهائي يحتاج متابعة متخصصة ولا ضمان في جميع الحالات."
        },
        {
          q: "هل أحتاج كلمة مرور لفك الحظر؟",
          a: "لا. لا توجد خدمة موثوقة تحتاج كلمة مرورك أو رمز التحقق (OTP) لفك الحظر. WFixerX لا تطلب هذه المعلومات أبداً."
        },
        {
          q: "ماذا أفعل إذا رُفض طلب المراجعة؟",
          a: "يمكن إعادة التقديم بعد فترة مع رسالة مختلفة. في الحالات الصعبة، يساعد متخصص في تحليل الوضع وتقديم طلب أفضل."
        },
      ].map(item => (
        <details class="glass-dark border border-white/10 rounded-xl overflow-hidden">
          <summary class="p-4 font-semibold text-white cursor-pointer hover:bg-white/5 transition-colors">{item.q}</summary>
          <p class="px-4 pb-4 text-white/65 text-sm leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">اقرأ شاشتك أولاً: جدول تشخيص سريع</h2>
    <p class="text-white/70 leading-relaxed mb-5">
      كل ما يلي يبدأ من سؤال واحد: ماذا يقول النص على شاشتك حرفياً؟ لا تعتمد على ما تتذكره ولا على ما قاله لك
      أحد، فالصيغة نفسها هي التشخيص. قارن ما تراه بهذا الجدول وستعرف نوعك ومسارك في ثانية:
    </p>
    <div class="overflow-x-auto mb-6">
      <table class="w-full text-right border-collapse text-sm">
        <thead>
          <tr class="border-b border-white/15">
            <th class="py-3 px-3 text-white font-bold">ما يظهر لك</th>
            <th class="py-3 px-3 text-white font-bold">النوع</th>
            <th class="py-3 px-3 text-white font-bold">خطوتك التالية</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-white/8">
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold align-top">عدّاد ساعات أو أيام</th>
            <td class="py-3 px-3 text-white/70 align-top">مؤقت</td>
            <td class="py-3 px-3 text-white/70 align-top">انتظر وعالج السبب. <a href="/مدونة/كم-مدة-حظر-واتساب/" class="text-[#25D366] hover:underline">المدد</a></td>
          </tr>
          <tr class="border-b border-white/8">
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold align-top">«حسابك مقيد حالياً»</th>
            <td class="py-3 px-3 text-white/70 align-top">تقييد لا حظر</td>
            <td class="py-3 px-3 text-white/70 align-top">أوقف نمط الإرسال فوراً. <a href="/مدونة/واتساب-مقيد/" class="text-[#25D366] hover:underline">الشرح</a></td>
          </tr>
          <tr class="border-b border-white/8">
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold align-top">«محظور 7 أيام» أو أكثر</th>
            <td class="py-3 px-3 text-white/70 align-top">مشدد</td>
            <td class="py-3 px-3 text-white/70 align-top">إنذار أخير. <a href="/مدونة/واتساب-محظور-7-أيام/" class="text-[#25D366] hover:underline">كيف تتعامل</a></td>
          </tr>
          <tr class="border-b border-white/8">
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold align-top">«لا يمكن لهذا الحساب…»</th>
            <td class="py-3 px-3 text-white/70 align-top">نهائي</td>
            <td class="py-3 px-3 text-white/70 align-top">طلب مراجعة واحد مدروس. <a href="/طلب-مراجعة-واتساب/" class="text-[#25D366] hover:underline">الصيغة</a></td>
          </tr>
          <tr class="border-b border-white/8">
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold align-top">التطبيق لا يفتح أصلاً</th>
            <td class="py-3 px-3 text-white/70 align-top">عطل لا حظر</td>
            <td class="py-3 px-3 text-white/70 align-top">شخّص الجهاز والشبكة. <a href="/مدونة/واتساب-معطل/" class="text-[#25D366] hover:underline">الحلول</a></td>
          </tr>
          <tr>
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold align-top">حسابك يعمل وشخص لا يستلم</th>
            <td class="py-3 px-3 text-white/70 align-top">حظر شخصي</td>
            <td class="py-3 px-3 text-white/70 align-top">لا حل تقني: القرار لصاحب الحساب. <a href="/مدونة/حظر-رقم-واتساب/" class="text-[#25D366] hover:underline">الفرق</a></td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">ثلاثة أخطاء تجعل الحظر دائماً</h2>
    <div class="space-y-3 mb-6">
      <div class="bg-red-900/15 border border-red-500/25 rounded-xl p-5">
        <h3 class="font-bold text-white mb-1 text-base">تثبيت نسخة معدّلة لتجاوز الحظر</h3>
        <p class="text-white/60 text-sm leading-relaxed">أسرع طريق لتحويل حظر مؤقت إلى نهائي. النسخ المعدّلة تُكتشف تقنياً، والانتهاك الموثّق لا ينفع معه استئناف. <a href="/مدونة/حظر-واتساب-الذهبي/" class="text-[#25D366] hover:underline">تفاصيل الواتس الذهبي</a>.</p>
      </div>
      <div class="bg-red-900/15 border border-red-500/25 rounded-xl p-5">
        <h3 class="font-bold text-white mb-1 text-base">الانتقال إلى رقم جديد قبل التشخيص</h3>
        <p class="text-white/60 text-sm leading-relaxed">إن كان السبب نمط استخدامك فالرقم الجديد سيُحظر بنفسه خلال أيام، وتخسر الرقم الأول ومحادثاتك بلا مقابل. <a href="/مدونة/هل-يمكن-استخدام-رقم-آخر-بعد-حظر-واتساب/" class="text-[#25D366] hover:underline">اقرأ هذا أولاً</a>.</p>
      </div>
      <div class="bg-red-900/15 border border-red-500/25 rounded-xl p-5">
        <h3 class="font-bold text-white mb-1 text-base">تقديم طلبات مراجعة متكررة</h3>
        <p class="text-white/60 text-sm leading-relaxed">طلب واحد مدروس أفضل من خمسة متعجلة. التكرار يُقرأ إلحاحاً آلياً وقد يُغلق حالتك بلا مراجعة بشرية.</p>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">كيف تتجنب الحظر من أساسه؟</h2>
    <ul class="space-y-2 mb-6 text-white/70">
      <li class="flex gap-2"><span class="text-[#25D366] shrink-0">•</span> استخدم التطبيق الرسمي من المتجر فقط، واحذف أي نسخة معدّلة أو أداة إرسال آلي نهائياً.</li>
      <li class="flex gap-2"><span class="text-[#25D366] shrink-0">•</span> لا ترسل إلى أرقام لم تتواصل معك أولاً، ولا تشترِ قوائم أرقام أبداً.</li>
      <li class="flex gap-2"><span class="text-[#25D366] shrink-0">•</span> تدرّج في حجم الإرسال بدل القفزات الموسمية المفاجئة.</li>
      <li class="flex gap-2"><span class="text-[#25D366] shrink-0">•</span> فعّل التحقق بخطوتين الآن لا بعد المشكلة. <a href="/مدونة/التحقق-بخطوتين-واتساب/" class="text-[#25D366] hover:underline">كيف</a></li>
      <li class="flex gap-2"><span class="text-[#25D366] shrink-0">•</span> احفظ نسخة احتياطية دورية، فما ليس فيها لا يُستعاد. <a href="/مدونة/نسخ-احتياطي-واتساب/" class="text-[#25D366] hover:underline">الطريقة</a></li>
      <li class="flex gap-2"><span class="text-[#25D366] shrink-0">•</span> للنشاط التجاري: اجعل الاشتراك طوعياً وإلغاءه سهلاً. <a href="/حظر-واتساب-للاعمال/" class="text-[#25D366] hover:underline">دليل الأعمال</a></li>
