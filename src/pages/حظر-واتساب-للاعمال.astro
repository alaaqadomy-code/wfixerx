            <td class="py-3 px-3 text-white/70">حجم كبير وأنظمة مرتبطة</td>
          </tr>
          <tr class="border-b border-white/8">
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold">حد الإرسال</th>
