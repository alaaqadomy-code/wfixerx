            <td class="py-3 px-3 text-white/70">درجات معلنة تُرفع بالجودة</td>
          </tr>
          <tr class="border-b border-white/8">
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold">مسار المراجعة</th>
            <td class="py-3 px-3 text-white/70">من داخل التطبيق</td>
            <td class="py-3 px-3 text-white/70">من لوحة إدارة الحساب التجاري</td>
          </tr>
          <tr>
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold">الحملات التسويقية</th>
            <td class="py-3 px-3 text-white/70">غير مناسب وسببٌ شائع للحظر</td>
            <td class="py-3 px-3 text-white/70">مسموح بقوالب معتمدة وموافقة مسبقة</td>
          </tr>
