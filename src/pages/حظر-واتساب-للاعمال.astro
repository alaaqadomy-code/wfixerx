---
import BaseLayout from '../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%20%D8%A3%D8%B9%D9%85%D8%A7%D9%84%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "حظر واتساب الأعمال — كيف تسترد حسابك Business",
    "description": "حسابك على واتساب بيزنس محظور؟ دليل شامل لاسترداد حساب WhatsApp Business المحظور وحماية نشاطك التجاري.",
    "author": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "dateModified": "2026-10-13",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://wfixerx.com" },
      { "@type": "ListItem", "position": 2, "name": "حظر واتساب الأعمال", "item": "https://wfixerx.com/حظر-واتساب-للاعمال/" }
    ]
  }
]);
---

<BaseLayout
  title="حظر واتساب الأعمال — كيف تسترد حساب Business المحظور"
  description="حسابك على واتساب بيزنس محظور؟ نساعدك في استرداده بأسرع وقت. خدمة متخصصة لأصحاب الأعمال في السعودية والخليج."
  schema={schema}
>

  <nav class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#1A3C6E]">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">حظر واتساب الأعمال</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-[#07111f] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-xs font-medium text-blue-300 bg-blue-900/40 px-3 py-1 rounded-full">واتساب الأعمال</span>
        <span class="text-xs font-medium text-orange-200 bg-orange-100 px-3 py-1 rounded-full">أولوية قصوى</span>
        <span class="text-xs text-white/40">آخر تحديث: أكتوبر 2026</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6">
        حظر واتساب الأعمال — كيف تسترد حساب Business المحظور
      </h1>
      <p class="text-lg text-white/65 leading-relaxed">
        حساب واتساب Business المحظور يعني توقف التواصل مع عملائك وخسارة مباشرة. هذا الدليل يشرح لك كيف تسترده بأسرع وقت ممكن.
      </p>

      <!-- Urgent Banner -->
      <div class="mt-6 bg-orange-900/20 border border-orange-500/30 rounded-xl p-4 flex items-start gap-3">
        <span class="text-orange-400 text-xl shrink-0" aria-hidden="true">⚡</span>
        <div>
          <p class="font-semibold text-orange-300 text-sm">حالة عاجلة؟</p>
          <p class="text-orange-200 text-sm">إذا كان نشاطك التجاري يعاني من الحظر الآن، تواصل معنا فوراً — نعطي حسابات الأعمال أولوية قصوى.</p>
          <a href={WA_LINK} target="_blank" rel="noopener" class="inline-block mt-2 text-sm font-semibold text-orange-300 underline">تواصل الآن عبر واتساب ←</a>
        </div>
      </div>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="quick-answer mb-10">
      <p class="text-xs font-semibold text-[#1A3C6E] uppercase tracking-wider mb-2">الجواب السريع</p>
      <h2 class="text-xl font-bold text-white mb-3">كيف تفك حظر واتساب للأعمال؟</h2>
      <ol class="space-y-1 text-white/70">
        <li><strong>1.</strong> افتح تطبيق WhatsApp Business وتحقق من رسالة الحظر.</li>
        <li><strong>2.</strong> إذا ظهر زر "طلب مراجعة" اضغط عليه فوراً.</li>
        <li><strong>3.</strong> اكتب طلباً يذكر طبيعة نشاطك التجاري وعدد عملائك.</li>
        <li><strong>4.</strong> إذا كان الحظر معقداً أو لم يظهر الزر: تواصل مع WFixerX للحصول على أولوية في المعالجة.</li>
      </ol>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">لماذا يُحظر واتساب الأعمال؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">
      واتساب Business يخضع لشروط أكثر صرامة من الحساب العادي. الأسباب الأكثر شيوعاً للحظر:
    </p>
    <ul class="space-y-2 text-white/70 mb-6">
      {[
        "إرسال رسائل تسويقية جماعية لأشخاص لم يوافقوا على استقبالها.",
        "استخدام برامج أتمتة أو روبوتات للرسائل.",
        "الإفراط في إضافة أشخاص جدد لمجموعات.",
        "تلقي تقارير كثيرة من المستخدمين.",
        "استخدام حساب Business لأغراض لا تتطابق مع سياسة التجارة.",
        "ربط الحساب بـ API بطريقة تنتهك الشروط.",
      ].map(reason => (
        <li class="flex items-start gap-3">
          <span class="w-5 h-5 rounded-full bg-red-100 text-red-400 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" aria-hidden="true">!</span>
          {reason}
        </li>
      ))}
    </ul>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">الفرق بين حظر Business والحساب العادي</h2>
    <div class="overflow-x-auto rounded-2xl border border-white/10 mb-8">
      <table class="w-full text-sm">
        <thead class="bg-[#0A1628] text-white">
          <tr>
            <th class="px-4 py-3 text-right font-semibold">الجانب</th>
            <th class="px-4 py-3 text-right font-semibold">حساب عادي</th>
            <th class="px-4 py-3 text-right font-semibold">حساب Business</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          <tr class="bg-[#07111f]"><td class="px-4 py-3 font-medium">التأثير</td><td class="px-4 py-3 text-white/65">شخصي</td><td class="px-4 py-3 text-red-300/80 font-semibold">يؤثر على الأعمال والعملاء</td></tr>
          <tr class="bg-[#060d1a]"><td class="px-4 py-3 font-medium">الإلحاح</td><td class="px-4 py-3 text-white/65">متوسط</td><td class="px-4 py-3 text-red-300/80 font-semibold">عالٍ جداً</td></tr>
          <tr class="bg-[#07111f]"><td class="px-4 py-3 font-medium">صعوبة الاسترداد</td><td class="px-4 py-3 text-white/65">متوسطة</td><td class="px-4 py-3 text-orange-200 font-semibold">أعلى — يحتاج تفصيلاً أكثر</td></tr>
          <tr class="bg-[#060d1a]"><td class="px-4 py-3 font-medium">الطلب الأمثل</td><td class="px-4 py-3 text-white/65">شخصي</td><td class="px-4 py-3 text-green-300/80 font-semibold">يذكر بيانات النشاط التجاري</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">خطوات استرداد حساب Business المحظور</h2>
    <ol class="space-y-4 mb-8">
      {[
        { n: "١", title: "افتح التطبيق وحدد نوع الحظر", desc: "تحقق إذا كان الحظر مؤقتاً (مع عداد وقت) أو دائماً (رسالة لا يمكن)." },
        { n: "٢", title: "ابحث عن زر طلب المراجعة", desc: "إذا ظهر، اضغط عليه فوراً. إذا لم يظهر، توجه لـ support.whatsapp.com." },
        { n: "٣", title: "اكتب طلباً مخصصاً للأعمال", desc: "اذكر اسم نشاطك، عدد عملائك، وكيف يؤثر الحظر على عملك يومياً." },
        { n: "٤", title: "أرفق معلومات إضافية إذا أمكن", desc: "رقم هاتف العمل، اسم الشركة، وأي تفاصيل تثبت استخدامك المشروع." },
        { n: "٥", title: "تابع ولا تيأس", desc: "إذا رُفض الطلب أو كانت الحالة معقدة، تواصل مع WFixerX للحصول على مساعدة متخصصة." },
      ].map(s => (
        <li class="flex gap-4 glass-dark border border-white/8 rounded-xl p-4">
          <span class="w-10 h-10 rounded-full bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30 flex items-center justify-center text-lg font-bold shrink-0">{s.n}</span>
          <div>
            <p class="font-semibold text-white mb-1">{s.title}</p>
            <p class="text-white/65 text-sm">{s.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- CTA -->
    <div class="bg-gradient-to-l from-[#0088CC] to-[#006fa8] rounded-2xl p-6 my-8 text-white">
      <p class="font-semibold text-xl mb-2">⚡ حالة عاجلة؟ نحن هنا</p>
      <p class="text-white/80 text-sm mb-4">نشاطك التجاري يستحق أولوية. تواصل الآن ونبدأ فوراً.</p>
      <div class="flex flex-wrap gap-3">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">أو تلغرام</a>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">كيف تحمي حساب Business من الحظر مستقبلاً؟</h2>
    <ul class="space-y-2 text-white/70 mb-6">
      {[
        "أرسل رسائل تسويقية فقط لمن وافق على استقبالها (opt-in).",
        "لا تستخدم برامج أتمتة خارج WhatsApp Business API الرسمي.",
        "ردّ على رسائل العملاء بسرعة — النشاط الحقيقي يحمي الحساب.",
        "تجنب إرسال نفس الرسالة لعدد كبير من الأشخاص دفعة واحدة.",
        "استخدم WhatsApp Business API الرسمي إذا كان نشاطك كبيراً.",
      ].map(tip => (
        <li class="flex items-start gap-3">
          <span class="text-[#25D366] font-bold shrink-0 mt-0.5">✓</span>
          {tip}
        </li>
      ))}
    </ul>

    <!-- Internal Links -->
    <div class="grid sm:grid-cols-2 gap-4 mt-10">
      {[
        { href: "/فك-حظر-واتساب/", title: "دليل فك حظر واتساب الشامل" },
        { href: "/خدمة-فك-حظر-واتساب/", title: "خدمة WFixerX المتكاملة" },
        { href: "/استرجاع-حساب-واتساب/", title: "استرجاع حساب واتساب" },
        { href: "/طلب-مراجعة-واتساب/", title: "طلب مراجعة واتساب الرسمي" },
      ].map(link => (
        <a href={link.href} class="glass-dark rounded-xl p-4 border border-white/10 hover:border-[#25D366]/40 hover:bg-white/5 transition-colors group">
          <p class="font-semibold text-white text-sm group-hover:text-[#25D366]">{link.title} ←</p>
        </a>
      ))}
    </div>

  </article>
</BaseLayout>
