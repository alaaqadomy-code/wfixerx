---
import BaseLayout from '../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const faqs = [
  { q: "ما هو رابط طلب مراجعة واتساب؟", a: "رابط طلب مراجعة واتساب الرسمي هو support.whatsapp.com — يمكنك الوصول إليه من متصفح الإنترنت وتقديم طلبك مباشرة." },
  { q: "كم يستغرق طلب مراجعة واتساب؟", a: "يستغرق طلب المراجعة من 3 أيام إلى 4 أسابيع حسب تعقيد الحالة وحجم الطلبات لدى واتساب." },
  { q: "ماذا أكتب في طلب مراجعة واتساب؟", a: "اكتب فقرة قصيرة بصيغة هادئة ومحددة: من أنت وطبيعة استخدامك للحساب، وأنك لم تنتهك السياسات عن قصد أو أنك أزلت سبب المشكلة كحذف نسخة معدّلة، ثم تعهّد واضح بعدم تكرارها. اجعلها بضعة أسطر لا صفحة. تجنّب الغضب والاتهام والتكرار والعبارات العامة، ولا تضع كلمة مرور ولا رمز تحقق في نص الطلب." },
  { q: "كم مرة يمكنني تقديم طلب مراجعة؟", a: "لا حدّ رسمياً معلناً، لكن الإلحاح يضرّك. أرسل طلباً واحداً وانتظر رده. إن جاء الرفض فانتظر أسبوعاً على الأقل قبل طلب آخر، وأعد صياغته من زاوية جديدة بدل إرسال النص نفسه مرة ثانية. تكرار الطلب ذاته يومياً يُقرأ كإزعاج آلي ويضعف ملفك." },
  { q: "هل أحتاج مستنداً أو إثبات هوية مع الطلب؟", a: "طلب المراجعة العادي من التطبيق لا يحتاج مستندات؛ ملكية الرقم نفسها هي إثباتك. أما حسابات الأعمال فقد يُطلب منها ما يثبت نشاط النشاط التجاري، وتُدار مراجعة حسابات واجهة الأعمال الرسمية من لوحة إدارة الحساب التجاري لا من التطبيق. ولن يطلب منك واتساب يوماً كلمة مرورك أو رمز التحقق." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "طلب مراجعة واتساب — كيف تقدمه بشكل صحيح",
    "description": "كيفية تقديم طلب مراجعة واتساب لرفع الحظر وزيادة فرص القبول. رابط طلب المراجعة وخطوات الإرسال.",
    "author": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "dateModified": "2026-10-19",
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.filter(f => !f.noSchema).map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
]);
---

<BaseLayout
  title="طلب مراجعة واتساب — الرابط الرسمي وطريقة التقديم الصحيحة"
  description="طلب مراجعة واتساب خطوة بخطوة: صيغة جاهزة، ما تكتبه وما لا تكتبه، الجدول الزمني بعد الإرسال، والمسارات إن رُفض طلبك. طلب واحد مدروس أفضل من خمسة."
  schema={schema}
>

  <nav class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2" aria-label="مسار التنقل">
    <ol class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
      <li><a href="/" class="hover:text-[#1A3C6E]">الرئيسية</a></li>
      <li aria-hidden="true">←</li>
      <li><a href="/فك-حظر-واتساب/" class="hover:text-[#1A3C6E]">فك حظر واتساب</a></li>
      <li aria-hidden="true">←</li>
      <li class="text-white/70 font-medium">طلب مراجعة واتساب</li>
    </ol>
  </nav>

  <header class="bg-gradient-to-b from-[#07111f] to-[#060d1a] py-12 px-4 sm:px-6 border-b border-white/8">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-xs text-white/40">وقت القراءة: 5 دقائق · آخر تحديث: أكتوبر 2026</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-6">
        طلب مراجعة واتساب — الرابط الرسمي وطريقة التقديم الصحيحة
      </h1>
      <p class="text-lg text-white/65 leading-relaxed">
        طلب مراجعة واتساب هو الطريقة الرسمية الوحيدة لرفع الحظر النهائي. هذه الصفحة تشرح كيف تقدمه بشكل صحيح يزيد من فرص القبول.
      </p>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="quick-answer mb-10">
      <p class="text-xs font-semibold text-[#1A3C6E] uppercase tracking-wider mb-2">الجواب السريع</p>
      <h2 class="text-xl font-bold text-white mb-3">كيف تقدم طلب مراجعة واتساب؟</h2>
      <ol class="space-y-1 text-white/70">
        <li><strong>1.</strong> افتح واتساب — ابحث عن زر "طلب مراجعة" في شاشة الحظر.</li>
        <li><strong>2.</strong> إذا لم يظهر: توجّه لـ <strong>support.whatsapp.com</strong> من متصفح الإنترنت.</li>
        <li><strong>3.</strong> اكتب طلباً واضحاً يشرح استخدامك المشروع للحساب.</li>
        <li><strong>4.</strong> انتظر الرد (3 أيام — 4 أسابيع).</li>
        <li><strong>5.</strong> إذا رُفض أو تعقّد الأمر: تواصل مع WFixerX.</li>
      </ol>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">ما هو طلب المراجعة؟</h2>
    <p class="text-white/70 leading-relaxed mb-6">
      طلب المراجعة هو رسالة رسمية ترسلها لفريق واتساب تطلب فيها إعادة النظر في قرار الحظر. واتساب قد تقبل الطلب وترفع الحظر، أو ترفضه، أو لا ترد على الإطلاق — القرار النهائي بيدهم.
    </p>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">أين تجد رابط طلب المراجعة؟</h2>
    <div class="space-y-4 mb-8">
      <div class="glass-dark border border-white/10 rounded-xl p-5 flex items-start gap-4">
        <span class="w-10 h-10 rounded-full bg-[#25D366] text-white flex items-center justify-center text-lg font-bold shrink-0">١</span>
        <div>
          <p class="font-semibold text-white mb-1">داخل التطبيق مباشرة</p>
          <p class="text-white/65 text-sm">عند فتح واتساب وظهور رسالة الحظر، ابحث عن زر "طلب مراجعة" في نفس الشاشة. هذه أسهل طريقة.</p>
        </div>
      </div>
      <div class="glass-dark border border-white/10 rounded-xl p-5 flex items-start gap-4">
        <span class="w-10 h-10 rounded-full bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30 flex items-center justify-center text-lg font-bold shrink-0">٢</span>
        <div>
          <p class="font-semibold text-white mb-1">عبر موقع دعم واتساب الرسمي</p>
          <p class="text-white/65 text-sm">إذا لم يظهر الزر داخل التطبيق، افتح متصفح الإنترنت وانتقل إلى <strong>support.whatsapp.com</strong> واختر "الإبلاغ عن مشكلة".</p>
        </div>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">كيف تكتب طلب مراجعة فعّال؟</h2>
    <p class="text-white/70 leading-relaxed mb-4">الفرق بين طلب يُقبل وآخر يُرفض غالباً في طريقة الصياغة. إليك ما يجب أن يحتوي عليه طلب جيد:</p>

    <div class="space-y-3 mb-8">
      {[
        { num: "١", good: "اذكر كيف تستخدم الحساب (شخصي، عائلي، عمل).", bad: "لا تقل فقط \"أريد حسابي\"." },
        { num: "٢", good: "أكّد أنك لم تنتهك الشروط عن قصد (إن كان صحيحاً).", bad: "لا تكذب — واتساب يعرف الكثير." },
        { num: "٣", good: "اشرح أهمية الحساب في حياتك أو عملك.", bad: "لا تُبالغ أو تتهم الآخرين دون دليل." },
        { num: "٤", good: "اطلب بلهجة هادئة ومهنية مراجعة القرار.", bad: "لا تستخدم لغة غاضبة أو تهديدية." },
      ].map(item => (
        <div class="glass-dark border border-white/10 rounded-xl p-4 grid sm:grid-cols-2 gap-3">
          <div class="flex items-start gap-2">
            <span class="text-green-400 font-bold shrink-0">✓</span>
            <span class="text-white/70 text-sm">{item.good}</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-red-500 font-bold shrink-0">✗</span>
            <span class="text-white/55 text-sm">{item.bad}</span>
          </div>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-white mt-10 mb-4">ماذا تفعل إذا لم يظهر طلب المراجعة؟</h2>
    <p class="text-white/70 leading-relaxed mb-3">
      رسالة "طلب المراجعة غير متاح" تعني أن واتساب لم تفتح باب التقديم لحالتك بعد. الحلول:
    </p>
    <ul class="space-y-2 text-white/70 mb-6">
      <li class="flex items-start gap-3"><span class="text-orange-500 shrink-0">→</span>انتظر أسبوعاً وأعد المحاولة عبر التطبيق.</li>
      <li class="flex items-start gap-3"><span class="text-orange-500 shrink-0">→</span>جرّب عبر support.whatsapp.com مباشرة.</li>
      <li class="flex items-start gap-3"><span class="text-orange-500 shrink-0">→</span>تواصل مع WFixerX — لدينا خبرة في هذه الحالات.</li>
    </ul>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">صيغة طلب مراجعة جاهزة — انسخها وعدّلها</h2>
    <p class="text-white/70 leading-relaxed mb-5">
      أكثر الطلبات تُرفض لا لأن صاحبها مخطئ بل لأن نصه طويل أو عاطفي أو يعترف بما لا يلزم. الصيغة الناجحة قصيرة
      وواقعية ومحددة. هذه قاعدة جاهزة، بدّل ما بين القوسين بمعلوماتك واحذف ما لا ينطبق عليك:
    </p>
    <div class="bg-[#07111f] border border-[#25D366]/25 rounded-xl p-5 mb-5">
      <p class="text-white/80 text-sm leading-loose">
        السلام عليكم،<br>
        رقمي (رقمك بالصيغة الدولية) ومُنع من استخدام واتساب بتاريخ (التاريخ).<br>
        أستخدم التطبيق الرسمي من المتجر فقط، ولم أستخدم أي نسخة معدّلة أو أداة إرسال آلي.<br>
        استخدامي للحساب (شخصي للتواصل مع الأهل والعمل / تجاري لنشاط مرخّص يرد على عملاء يبدأون المحادثة).<br>
        لم أرسل رسائل إلى أرقام لم تتواصل معي، ولا أعلم سبباً واضحاً للقرار، وأعتقد أنه جاء بالخطأ.<br>
        أرجو إعادة النظر في الحساب، وأنا ملتزم بشروط الاستخدام.<br>
        شكراً لوقتكم.
      </p>
    </div>
    <div class="grid sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-emerald-900/15 border border-emerald-500/25 rounded-xl p-5">
        <h3 class="font-bold text-white mb-3 text-base">✓ اكتب هذا</h3>
        <ul class="space-y-2 text-white/65 text-sm">
          <li>• الرقم بالصيغة الدولية كاملاً</li>
          <li>• تاريخ الحظر أو تاريخه التقريبي</li>
          <li>• أنك تستخدم التطبيق الرسمي فقط</li>
          <li>• طبيعة استخدامك في سطر واحد</li>
          <li>• طلب إعادة النظر بعبارة مهذبة</li>
        </ul>
      </div>
      <div class="bg-red-900/15 border border-red-500/25 rounded-xl p-5">
        <h3 class="font-bold text-white mb-3 text-base">✗ لا تكتب هذا</h3>
        <ul class="space-y-2 text-white/65 text-sm">
          <li>• «ربما أرسلت رسائل كثيرة» وأي إقرار مشابه</li>
          <li>• قصة طويلة عاطفية عن ضرر الحظر عليك</li>
          <li>• تهديداً بالشكوى أو بالقانون أو بالإعلام</li>
          <li>• مطالبة بمهلة أو تعويض</li>
          <li>• نصاً منسوخاً حرفياً بلا تعديل على حالتك</li>
        </ul>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">ماذا يحدث بعد الإرسال؟ الجدول الزمني</h2>
    <div class="overflow-x-auto mb-6">
      <table class="w-full text-right border-collapse text-sm">
        <thead>
          <tr class="border-b border-white/15">
            <th class="py-3 px-3 text-white font-bold">المرحلة</th>
            <th class="py-3 px-3 text-white font-bold">التوقيت المعتاد</th>
            <th class="py-3 px-3 text-white font-bold">ما تفعله فيها</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-white/8">
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold align-top">تأكيد الاستلام</th>
            <td class="py-3 px-3 text-white/70 align-top">فوري أو خلال ساعات</td>
            <td class="py-3 px-3 text-white/70 align-top">لا شيء. وجود التأكيد يعني أن الطلب دخل الطابور فعلاً.</td>
          </tr>
          <tr class="border-b border-white/8">
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold align-top">المراجعة</th>
            <td class="py-3 px-3 text-white/70 align-top">24 إلى 48 ساعة غالباً</td>
            <td class="py-3 px-3 text-white/70 align-top">لا ترسل طلباً ثانياً ولا تحاول الدخول مراراً، فالتكرار يضرك.</td>
          </tr>
          <tr class="border-b border-white/8">
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold align-top">الرد بالقبول</th>
            <td class="py-3 px-3 text-white/70 align-top">يُرفع الحظر غالباً فوراً</td>
            <td class="py-3 px-3 text-white/70 align-top">سجّل الدخول وعالج السبب قبل أي شيء آخر، فالعود إلى النمط نفسه يعني حظراً نهائياً.</td>
          </tr>
          <tr>
            <th scope="row" class="py-3 px-3 text-[#25D366] font-semibold align-top">الرد بالرفض</th>
            <td class="py-3 px-3 text-white/70 align-top">نص قصير بلا تفصيل عادة</td>
            <td class="py-3 px-3 text-white/70 align-top">اقرأه بدقة فهو يشير للسبب، ولا تعد الطلب نفسه. المحاولة الثانية تحتاج زاوية مختلفة.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-white mt-12 mb-4">رُفض طلبي: ما الخطوات الباقية؟</h2>
    <p class="text-white/70 leading-relaxed mb-5">
      الرفض ليس نهاية الطريق دائماً، لكن تكرار الطلب نفسه بالنص نفسه لا يغيّر شيئاً. المسارات المتاحة بعد الرفض
      ثلاثة فقط، وكلها تحتاج تغييراً حقيقياً في الزاوية لا في الصياغة وحدها:
    </p>
    <ol class="space-y-3 mb-6 text-white/70">
      <li class="flex gap-3"><span class="text-[#25D366] font-bold shrink-0">١.</span> <span><strong class="text-white">البريد الرسمي:</strong> إن كان طلبك الأول من داخل التطبيق فالبريد مسار مستقل يُقرأ بشرياً في حالات. <a href="/مدونة/ايميل-واتساب-لفك-الحظر/" class="text-[#25D366] hover:underline">العنوان والصيغة</a>.</span></li>
      <li class="flex gap-3"><span class="text-[#25D366] font-bold shrink-0">٢.</span> <span><strong class="text-white">مسار حسابات الأعمال:</strong> إن كان حسابك تجارياً فله قناة مراجعة مختلفة أعمق من مسار الحساب الشخصي. <a href="/حظر-واتساب-للاعمال/" class="text-[#25D366] hover:underline">التفاصيل</a>.</span></li>
      <li class="flex gap-3"><span class="text-[#25D366] font-bold shrink-0">٣.</span> <span><strong class="text-white">معلومة جديدة حقيقية:</strong> إن ظهر ما يفسر الحظر (اختراق مثلاً أو خطأ في التصنيف) فهذه مادة لطلب جديد مختلف، لا إعادة للقديم.</span></li>
    </ol>
    <p class="text-white/70 leading-relaxed mb-6">
      وإن كان الرفض مبنياً على انتهاك موثّق كاستخدام نسخة معدّلة فالفرصة ضعيفة جداً، والصدق هنا أنفع لك من
      محاولات متكررة تستهلك وقتك. أرسل لنا نص الرفض ونخبرك مجاناً في أي خانة تقع حالتك.
    </p>

    <!-- CTA -->
    <div class="bg-gradient-to-l from-[#1A3C6E] to-[#0A1628] rounded-2xl p-6 my-8 text-white">
      <p class="font-semibold text-lg mb-2">تريد مساعدة في كتابة الطلب؟</p>
      <p class="text-white/70 text-sm mb-4">WFixerX تساعدك في صياغة طلب احترافي يرفع فرص القبول بشكل ملحوظ.</p>
      <div class="flex flex-wrap gap-3">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa">تواصل عبر واتساب</a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg">أو تلغرام</a>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 mt-10">
      {[
        { href: "/فك-حظر-واتساب/", title: "دليل فك حظر واتساب الشامل" },
        { href: "/رسالة-لا-يمكن-لهذا-الحساب/", title: "رسالة \"لا يمكن لهذا الحساب\"" },
      ].map(link => (
        <a href={link.href} class="glass-dark rounded-xl p-4 border border-white/10 hover:border-[#25D366]/40 hover:bg-white/5 transition-colors group">
          <p class="font-semibold text-white text-sm group-hover:text-[#25D366]">{link.title} ←</p>
        </a>
      ))}
    </div>

    <section class="wf-context-links max-w-5xl mx-auto px-4 sm:px-6 mt-12">
      <h2 class="text-2xl font-bold text-white mb-6">أدلة مكملة لطلب المراجعة</h2>
      <p class="text-white/70 leading-relaxed mb-5">لإرسال الطلب من القناة الصحيحة استخدم <a href="/مدونة/رابط-طلب-مراجعة-واتساب/" class="text-[#25D366] hover:underline">رابط طلب مراجعة واتساب</a> الرسمي، وإن لم يظهر لك الزر داخل التطبيق فاكتب عبر <a href="/مدونة/ايميل-واتساب-لفك-الحظر/" class="text-[#25D366] hover:underline">إيميل واتساب لفك الحظر</a> أو نموذج <a href="/مدونة/دعم-واتساب-لفك-الحظر/" class="text-[#25D366] hover:underline">دعم واتساب لفك الحظر</a>. وللخطوات من أولها راجع <a href="/مدونة/كيف-ارفع-الحظر-عن-رقمي/" class="text-[#25D366] hover:underline">كيف أرفع الحظر عن رقمي</a> و<a href="/مدونة/حل-مشكلة-حظر-الواتس/" class="text-[#25D366] hover:underline">حل مشكلة حظر الواتس</a>.</p>
      <p class="text-white/70 leading-relaxed mb-5">طلب المراجعة نفسه مجاني، وهذا ما نشرحه في <a href="/مدونة/فك-حظر-واتساب-مجاناً/" class="text-[#25D366] hover:underline">فك حظر واتساب مجاناً</a>، ولا يوجد <a href="/مدونة/برنامج-فك-حظر-الواتس-اب/" class="text-[#25D366] hover:underline">برنامج لفك حظر الواتس اب</a> يغني عنه. وبعد قبول الطلب اتبع <a href="/مدونة/تفعيل-واتساب-بعد-الحظر/" class="text-[#25D366] hover:underline">تفعيل واتساب بعد الحظر</a> حتى لا يتكرر.</p>
      <p class="text-white/70 leading-relaxed mb-5">لحسابات الأعمال مسارات مراجعة خاصة: <a href="/مدونة/استرداد-حساب-واتساب-الأعمال/" class="text-[#25D366] hover:underline">استرداد حساب واتساب الأعمال</a>، و<a href="/مدونة/كتالوج-واتساب-محظور/" class="text-[#25D366] hover:underline">كتالوج واتساب المحظور</a>، و<a href="/مدونة/تقييم-جودة-واتساب-بزنس/" class="text-[#25D366] hover:underline">تقييم جودة واتساب بزنس</a> الذي يسبق التقييد غالباً، أما حسابات <a href="/مدونة/واجهة-واتساب-الرسمية-للأعمال/" class="text-[#25D366] hover:underline">واجهة واتساب الرسمية للأعمال</a> فتُدار مراجعتها من لوحة إدارة الحساب التجاري لا من التطبيق.</p>
      <p class="text-white/70 leading-relaxed mb-5">لفهم نوع حظرك قبل الكتابة اقرأ <a href="/حظر-واتساب/" class="text-[#25D366] hover:underline">حظر واتساب: الأنواع والأسباب</a> و<a href="/فك-حظر-واتساب/" class="text-[#25D366] hover:underline">دليل فك حظر واتساب</a>، وإن أردت من يساعدك في الصياغة فهذه <a href="/خدمة-فك-حظر-واتساب/" class="text-[#25D366] hover:underline">خدمة فك حظر واتساب</a>، وكل الأدلة في <a href="/مدونة/" class="text-[#25D366] hover:underline">المدونة</a>.</p>
    </section>

    <div class="wf-crawl-links max-w-5xl mx-auto px-4 sm:px-6 mt-12 pt-8 border-t border-white/8">
      <h2 class="text-lg font-bold text-white mb-4">أدلة أخرى تهمك</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/مدونة/حظر-واتساب-في-الأردن/" class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group"><p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">حظر واتساب في الأردن ←</p></a>
        <a href="/مدونة/حظر-واتساب-في-عمان/" class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group"><p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">حظر واتساب في عُمان ←</p></a>
        <a href="/مدونة/واتساب-محظور-7-أيام/" class="bg-[#0a1628] border border-white/8 rounded-xl p-4 hover:border-[#25D366]/40 transition-colors group"><p class="font-semibold text-white/80 text-sm group-hover:text-[#25D366]">واتساب محظور 7 أيام ←</p></a>
      </div>
    </div>
  
