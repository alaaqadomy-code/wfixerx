---
import BaseLayout from '../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A%20%D9%85%D8%AD%D8%B8%D9%88%D8%B1%20%D9%88%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "كيف تفك حظر واتساب؟",
    "description": "خطوات فك حظر واتساب بشكل صحيح — من تحديد نوع الحظر إلى تقديم طلب المراجعة",
    "totalTime": "PT30M",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "حدّد نوع الحظر",
        "text": "تحقق من رسالة الحظر: إذا ظهر عداد وقت فهو حظر مؤقت. إذا ظهرت رسالة 'لا يمكن لهذا الحساب' فهو حظر نهائي."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "انتظر للحظر المؤقت",
        "text": "إذا كان الحظر مؤقتاً، أغلق التطبيق وانتظر من 24 إلى 72 ساعة دون تشغيله."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "قدّم طلب مراجعة للحظر الدائم",
        "text": "إذا كان الحظر نهائياً، اضغط على زر 'طلب مراجعة' في التطبيق أو زر support.whatsapp.com وأرسل طلباً احترافياً."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "احصل على مساعدة متخصصة",
        "text": "إذا رُفض طلبك أو لم تجد الزر، تواصل مع WFixerX للحصول على مساعدة في إعداد الطلب."
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    {
      "@type": "Question",
      "name": "كيف أفك حظر واتساب؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "لفك حظر واتساب، يمكنك: 1. الانتظار إذا كان الحظر مؤقتاً (24-72 ساعة)، 2. تقديم طلب مراجعة عبر رابط support.whatsapp.com إذا كان الحظر دائماً، 3. التواصل مع فريق WFixerX للمساعدة في إعداد الطلب بالطريقة الصحيحة."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكن فك حظر واتساب نهائياً؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، في حالات كثيرة يمكن رفع الحظر النهائي عبر تقديم طلب مراجعة رسمي. النجاح يعتمد على سبب الحظر وتفاصيل الحساب. WFixerX تساعدك في تحسين فرص قبول الطلب."
      }
    },
    {
      "@type": "Question",
      "name": "ما هي مدة حظر واتساب؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "مدة الحظر تعتمد على نوعه: الحظر المؤقت يستمر 24 ساعة إلى أسبوع، الحظر المشدد يمتد لأسابيع، أما الحظر النهائي فيحتاج تقديم طلب مراجعة رسمي."
      }
    },
    {
      "@type": "Question",
      "name": "هل تطلبون كلمة المرور أو رمز التحقق؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "لا، WFixerX لا تطلب كلمة المرور أو رمز التحقق أبداً. نحن نساعدك في إعداد طلب المراجعة وتقديمه بشكل صحيح دون الحاجة إلى أي بيانات سرية."
      }
    },
    {
      "@type": "Question",
      "name": "كم يكلف فك حظر واتساب؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "السعر يختلف حسب نوع الحظر وتعقيد الحالة. تواصل معنا عبر واتساب أو تلغرام للحصول على تقييم مجاني لحالتك."
      }
    }
  ]
  }
]);

const waIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`;

const tgIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.820 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>`;
---

<BaseLayout
  title="فك حظر واتساب — احصل على مساعدة متخصصة"
  description="حسابك على واتساب محظور؟ WFixerX تقدم مساعدة متخصصة لفك حظر واتساب واستعادة حسابك. خبرة حقيقية، لا نطلب كلمة مرور."
  schema={schema}
>

  <!-- ====== HERO ====== -->
  <section class="hero-animated dot-grid relative overflow-hidden min-h-screen flex items-center">

    <!-- Radial glow layers -->
    <div class="absolute top-[-10%] right-[-5%] w-[700px] h-[700px] bg-[#25D366]/8 rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[500px] h-[500px] bg-[#0088CC]/8 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-[#1A3C6E]/15 rounded-full blur-[80px] pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-24 relative z-10 w-full grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- LEFT: Content -->
      <div>
        <!-- Live status badge -->
        <div class="flex items-center gap-2.5 mb-7 animate-fade-up w-fit">
          <span class="relative flex h-2.5 w-2.5">
            <span class="status-dot absolute inline-flex h-full w-full rounded-full bg-[#25D366] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#25D366]"></span>
          </span>
          <span class="text-sm text-white/60 font-medium">نستقبل حالات جديدة الآن</span>
        </div>

        <h1 class="text-5xl sm:text-6xl md:text-7xl font-black text-white leading-[1.05] mb-6 animate-fade-up delay-1 tracking-tight">
          حسابك<br>
          واتساب<br>
          <span class="text-gradient-green neon-text">محظور؟</span>
        </h1>

        <p class="text-lg sm:text-xl text-white/60 mb-4 max-w-xl leading-relaxed animate-fade-up delay-2">
          فريق WFixerX يساعدك في استعادة حسابك — سواء كان الحظر مؤقتاً، مشدداً، أو نهائياً. <strong class="text-white/80">بدون كلمة مرور. بدون وعود كاذبة.</strong>
        </p>

        <!-- Typewriter rotating problems -->
        <div class="flex items-center gap-2 mb-8 animate-fade-up delay-2" aria-hidden="true">
          <span class="text-white/35 text-sm">نعالج:</span>
          <span id="typewriter" class="text-[#25D366] text-sm font-semibold border-l-2 border-[#25D366] pl-1"></span>
        </div>

        <div class="flex flex-wrap gap-3 mb-10 animate-fade-up delay-3">
          <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa pulse-glow text-base" set:html={`${waIcon} تواصل الآن عبر واتساب`} />
          <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg text-base" set:html={`${tgIcon} أو عبر تلغرام`} />
        </div>

        <!-- Stats row -->
        <div class="flex flex-wrap gap-4 animate-fade-up delay-4">
          <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-2xl px-4 py-3 backdrop-blur-sm">
            <div class="w-9 h-9 icon-box-green rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <div class="text-xl font-black text-white leading-none"><span data-target="500" data-suffix="+">500+</span></div>
              <div class="text-[10px] text-white/60 mt-0.5">حالة ناجحة</div>
            </div>
          </div>
          <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-2xl px-4 py-3 backdrop-blur-sm">
            <div class="w-9 h-9 icon-box-blue rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <div class="text-xl font-black text-white leading-none">&lt;٢٤س</div>
              <div class="text-[10px] text-white/60 mt-0.5">متوسط الرد</div>
            </div>
          </div>
          <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-2xl px-4 py-3 backdrop-blur-sm">
            <div class="w-9 h-9 icon-box-orange rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <div>
              <div class="text-xl font-black text-white leading-none">٠٪</div>
              <div class="text-[10px] text-white/60 mt-0.5">طلب كلمة مرور</div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Phone Mockup -->
      <div class="hidden lg:flex justify-center items-center relative py-12">

        <!-- Background glow behind phone -->
        <div class="absolute w-72 h-72 bg-[#25D366]/12 rounded-full blur-3xl" aria-hidden="true"></div>

        <!-- Phone frame -->
        <div class="relative float z-10">
          <div class="w-[230px] h-[460px] bg-gradient-to-b from-[#1c1c2e] to-[#0f0f1a] rounded-[42px] p-[10px] border border-white/10 shadow-[0_40px_100px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.08)]">
            <!-- Screen -->
            <div class="w-full h-full bg-[#0a0a16] rounded-[34px] overflow-hidden flex flex-col">
              <!-- Status bar -->
              <div class="flex justify-between items-center px-4 pt-3 pb-2 text-white/55 text-[10px] font-mono shrink-0">
                <span>9:41</span>
                <div class="flex items-center gap-1">
                  <svg class="w-3 h-2" viewBox="0 0 12 8" fill="currentColor"><rect x="0" y="2" width="2" height="6" rx="0.5"/><rect x="3" y="1" width="2" height="7" rx="0.5"/><rect x="6" y="0" width="2" height="8" rx="0.5"/><rect x="9.5" y="1.5" width="2" height="5" rx="1" opacity="0.3"/></svg>
                  <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor"><path d="M6 1a5 5 0 100 10A5 5 0 006 1zm0 1.5A3.5 3.5 0 116 9 3.5 3.5 0 016 2.5z" opacity="0.4"/><path d="M1 6C1 3.24 3.24 1 6 1"/></svg>
                  <div class="w-5 h-2.5 rounded-[2px] border border-white/30 p-[1.5px] flex items-center">
                    <div class="h-full bg-[#25D366] rounded-[1px]" style="width:70%"></div>
                  </div>
                </div>
              </div>

              <!-- App header bar -->
              <div class="bg-[#075E54] px-4 py-2.5 flex items-center gap-2.5 shrink-0">
                <div class="w-7 h-7 rounded-full bg-[#25D366] flex items-center justify-center shrink-0 ring-pulse">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </div>
                <div>
                  <div class="text-white text-xs font-semibold">WFixerX</div>
                  <div class="text-white/50 text-[9px] flex items-center gap-1">
                    <span class="status-dot inline-block w-1 h-1 bg-green-400 rounded-full"></span>
                    متصل الآن
                  </div>
                </div>
              </div>

              <!-- Chat area -->
              <div class="flex-1 px-3 py-3 space-y-2.5 overflow-hidden" style="background:#0d1117;">

                <!-- User message -->
                <div class="flex justify-end">
                  <div class="bg-[#1A3C6E] text-white/85 rounded-[14px] rounded-br-[4px] px-3 py-2 text-[11px] max-w-[82%] shadow-sm">
                    حسابي محظور على واتساب، لا أعرف ماذا أفعل
                    <div class="text-white/55 text-[8px] mt-0.5 text-left">10:24 ✓✓</div>
                  </div>
                </div>

                <!-- Response -->
                <div class="flex justify-start">
                  <div class="bg-[#1e2030] text-white/80 rounded-[14px] rounded-bl-[4px] px-3 py-2 text-[11px] max-w-[82%] shadow-sm">
                    أرسِل لنا تفاصيل حالتك وسنساعدك في الحل
                    <div class="text-white/55 text-[8px] mt-0.5 text-right">10:25</div>
                  </div>
                </div>

                <!-- User message 2 -->
                <div class="flex justify-end">
                  <div class="bg-[#1A3C6E] text-white/85 rounded-[14px] rounded-br-[4px] px-3 py-2 text-[11px] max-w-[82%] shadow-sm">
                    شكراً جزيلاً، متى يمكننا البدء؟
                    <div class="text-white/55 text-[8px] mt-0.5 text-left">10:26 ✓✓</div>
                  </div>
                </div>

                <!-- Success message -->
                <div class="flex justify-start">
                  <div class="bg-[#0d2a18] border border-[#25D366]/30 text-[#25D366] rounded-[14px] rounded-bl-[4px] px-3 py-2 text-[11px] max-w-[82%] shadow-sm">
                    <div class="flex items-center gap-1.5 mb-0.5">
                      <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                      <span class="font-semibold">تم فك الحظر ✅</span>
                    </div>
                    <span class="text-white/50 text-[9px]">حسابك عاد للعمل بنجاح</span>
                    <div class="text-[#25D366]/40 text-[8px] mt-0.5 text-right">10:58</div>
                  </div>
                </div>
              </div>

              <!-- Input bar mockup -->
              <div class="flex items-center gap-2 px-3 py-2.5 border-t border-white/5 bg-[#0a0a16] shrink-0">
                <div class="flex-1 bg-white/8 rounded-full px-3 py-1.5 text-[10px] text-white/20">اكتب رسالة...</div>
                <div class="w-7 h-7 rounded-full bg-[#25D366] flex items-center justify-center shrink-0">
                  <svg class="w-3 h-3 text-white rotate-180" viewBox="0 0 24 24" fill="currentColor"><path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/></svg>
                </div>
              </div>

              <!-- Home indicator -->
              <div class="flex justify-center py-1.5 bg-[#0a0a16] shrink-0">
                <div class="w-20 h-1 bg-white/15 rounded-full"></div>
              </div>
            </div>
          </div>

          <!-- Camera notch -->
          <div class="absolute top-[10px] left-1/2 -translate-x-1/2 w-[72px] h-[18px] bg-[#1c1c2e] rounded-b-2xl z-20 flex items-center justify-center">
            <div class="w-2 h-2 rounded-full bg-[#0a0a16]/90 border border-white/10"></div>
          </div>
          <!-- Side buttons -->
          <div class="absolute left-[-3px] top-[100px] w-[3px] h-9 bg-[#141420] rounded-l-full"></div>
          <div class="absolute right-[-3px] top-[90px] w-[3px] h-7 bg-[#141420] rounded-r-full"></div>
          <div class="absolute right-[-3px] top-[128px] w-[3px] h-7 bg-[#141420] rounded-r-full"></div>
        </div>

      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/55 text-xs" aria-hidden="true">
      <span>اسحب للأسفل</span>
      <div class="w-5 h-8 border border-white/20 rounded-full flex justify-center pt-1.5">
        <div class="w-1 h-2 bg-white/40 rounded-full scroll-dot"></div>
      </div>
    </div>
  </section>

  <!-- ====== TRUST BAR ====== -->
  <section class="bg-[#080f1f] border-b border-white/5 py-5" aria-label="مميزاتنا">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
        {[
          { icon: "🔒", text: "لا نطلب كلمة مرور", color: "text-[#25D366]" },
          { icon: "⚡", text: "رد سريع خلال ساعات", color: "text-[#F5A623]" },
          { icon: "🌍", text: "السعودية، مصر، الخليج", color: "text-[#0088CC]" },
          { icon: "✅", text: "مستقلون عن واتساب", color: "text-[#25D366]" },
        ].map(item => (
          <div class="flex items-center justify-center gap-2 text-sm text-white/50 py-1">
            <span class={`${item.color} text-base`} aria-hidden="true">{item.icon}</span>
            <span>{item.text}</span>
          </div>
        ))}
