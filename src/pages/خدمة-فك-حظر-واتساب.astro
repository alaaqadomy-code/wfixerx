---
import BaseLayout from '../layouts/BaseLayout.astro';

const WA_LINK = "https://wa.me/962795827790?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20WFixerX%20%F0%9F%91%8B%20%D8%A3%D8%B1%D9%8A%D8%AF%20%D9%85%D8%B9%D8%B1%D9%81%D8%A9%20%D8%AA%D9%81%D8%A7%D8%B5%D9%8A%D9%84%20%D8%A7%D9%84%D8%AE%D8%AF%D9%85%D8%A9%20%7C%20وصلت%20من%20موقع%20wfixerx.com";
const TG_LINK = "https://t.me/+962795827790";

const FAQS = [
  { q: "كم تكلفة خدمة فك حظر واتساب؟", a: "التقييم الأولي مجاني تماماً: ترسل نص رسالة الحظر ونخبرك بنوعه وفرصك بصدق قبل أي التزام. أما كلفة الخدمة فتُحدَّد بعد رؤية حالتك، لأن حساباً تجارياً معلّقاً بمسار مراجعة معقد لا يشبه حظراً مؤقتاً لثلاثة أيام. تواصل عبر واتساب لتعرف وضعك والسعر معاً، ولك أن ترفض بعدها بلا أي التزام." },
  { q: "هل تضمنون رفع الحظر؟", a: "لا، ولا تصدّق من يضمن. القرار النهائي لواتساب وحدها، ولا أحد خارجها يملك صلاحية الرفع. ما نضمنه هو العمل نفسه: تشخيص صحيح لنوع الحظر، صياغة احترافية للاستئناف، تقديمه في القناة الصحيحة، ومتابعة حتى الرد. وإن كانت حالتك بلا فرصة حقيقية نقول لك ذلك في البداية بدل أن نأخذ مالك." },
  { q: "هل تطلبون رمز التحقق أو كلمة المرور؟", a: "أبداً، ولا في أي مرحلة. من يطلب رمز التحقق منك يحاول سرقة حسابك لا استعادته، وهذه قاعدة تنطبق علينا وعلى غيرنا. كل ما نحتاجه هو نص رسالة الحظر ووصف ما حدث. لا تشارك الرمز مع أي جهة مهما بدت رسمية." },
  { q: "كم يستغرق الرد من واتساب؟", a: "الرد يأتي عادة خلال 24 إلى 48 ساعة من تقديم طلب المراجعة، وقد يمتد أكثر في فترات الضغط أو لحسابات الأعمال التي تحتاج فحصاً أعمق. الحظر المؤقت نفسه يُرفع تلقائياً بمدته المحددة، والمشدد قد يمتد إلى 30 يوماً. نخبرك بالتوقع المرجَّح لحالتك عند التشخيص." },
  { q: "طلبي رُفض سابقاً، هل ما زال هناك أمل؟", a: "في حالات كثيرة نعم، لكن المحاولة الثانية أصعب وتحتاج زاوية مختلفة لا تكراراً للطلب نفسه. نقرأ نص الرفض لأنه غالباً يشير إلى سبب القرار، ونبني عليه. لكن إن كان الرفض نهائياً ومبنياً على انتهاك موثّق فسنقول لك ذلك بوضوح بدل أن نبيعك محاولة بلا جدوى." },
  { q: "هل أنتم تابعون لواتساب أو ميتا؟", a: "لا. WFixerX خدمة مستقلة تماماً ولا تنتمي إلى WhatsApp LLC أو Meta Platforms ولا تمثلهما، ولا نملك أي وصول إلى أنظمتهما. من يدّعي أن له موظفاً أو واسطة داخل واتساب يكذب عليك. نحن خبرة في التعامل مع المسار الرسمي المتاح للجميع، لا أكثر ولا أقل." },
  { q: "هل يمكنني فعل ذلك بنفسي مجاناً؟", a: "نعم، والمسار الرسمي مجاني ومتاح للجميع. مدونتنا تشرح كل خطوة بلا مقابل، ومن يفهم حالته ويكتب طلباً جيداً قد لا يحتاجنا إطلاقاً. قيمتنا لمن لا يعرف نوع حظره، أو جرّب وفشل، أو لا يريد المخاطرة بفرصته الأولى، أو يخسر دخلاً يومياً ويريد أسرع مسار صحيح." },
  { q: "في أي دول تعمل الخدمة؟", a: "نخدم السعودية ومصر والإمارات والكويت وقطر والبحرين وعُمان والأردن والعراق، والتواصل كله عبر واتساب أو تلغرام فلا يهم مكانك. مسار المراجعة لدى واتساب واحد عالمياً، فالخدمة لا تتغير بتغيّر بلدك." },
  { q: "ماذا لو كان الحظر من شخص وليس من واتساب؟", a: "هذا حظر شخصي: مستخدم آخر حظر رقمك، ولا علاقة لشركة واتساب به ولا يمكن لأحد رفعه نيابة عنك. ستلاحظ أنك لا ترى صورته أو حالته ولا تصل رسائلك إليه، لكن حسابك يعمل طبيعياً مع الآخرين. في هذه الحالة لا توجد خدمة تُقدَّم، ونخبرك بذلك مجاناً." },
];

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "خدمة فك حظر واتساب — WFixerX",
    "description": "خدمة استشارية مستقلة لمساعدة أصحاب حسابات واتساب المحظورة: تشخيص نوع الحظر، صياغة طلب المراجعة، تقديمه في القناة الصحيحة، ومتابعة الرد. بلا ضمان نتيجة ودون طلب رمز تحقق.",
    "provider": { "@type": "Organization", "name": "WFixerX", "url": "https://wfixerx.com" },
    "areaServed": ["SA", "EG", "AE", "KW", "QA", "BH", "OM", "JO", "IQ"],
    "serviceType": "استشارة وإعداد طلب مراجعة واتساب",
    "audience": { "@type": "Audience", "audienceType": "أصحاب حسابات واتساب الشخصية وحسابات الأعمال المحظورة" },
    "availableChannel": { "@type": "ServiceChannel", "serviceUrl": "https://wfixerx.com/خدمة-فك-حظر-واتساب/", "availableLanguage": "ar" },
    "inLanguage": "ar"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": FAQS.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://wfixerx.com" },
      { "@type": "ListItem", "position": 2, "name": "خدمة فك حظر واتساب", "item": "https://wfixerx.com/خدمة-فك-حظر-واتساب/" }
    ]
  }
]);
---

<BaseLayout
  title="خدمة فك حظر واتساب — WFixerX"
  description="خدمة مستقلة لتشخيص نوع حظر واتساب وصياغة طلب مراجعة احترافي وتقديمه في القناة الصحيحة ومتابعة الرد. التقييم مجاني، ولا نطلب رمز تحقق ولا نضمن النتيجة."
  schema={schema}
>

  <!-- Hero -->
  <section class="hero-glow min-h-[70vh] flex items-center py-20 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="trust-badge mb-6 mx-auto w-fit">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        خدمة متخصصة موثوقة
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight mb-6">
        خدمة فك حظر واتساب<br>
        <span class="text-[#25D366]">احصل على مساعدة متخصصة</span>
      </h1>
      <p class="text-xl text-white/70 mb-10 max-w-2xl mx-auto leading-relaxed">
        لا تضيع وقتك في محاولات فاشلة. WFixerX تحلل وضعك وتساعدك في تقديم طلب مراجعة احترافي.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa pulse-glow text-lg px-8 py-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          تواصل الآن — مجاناً
        </a>
        <a href={TG_LINK} target="_blank" rel="noopener" class="btn-tg text-lg px-8 py-4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.820 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          أو تلغرام
        </a>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="py-16 sm:py-20 bg-[#07111f]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">ماذا تشمل الخدمة؟</h2>
        <p class="text-white/55">نقدم خدمة شاملة من التشخيص حتى الحل</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          { icon: "🔍", title: "تشخيص دقيق", desc: "نحدد نوع الحظر وسببه المحتمل ونقيّم فرص الاسترداد بصدق." },
          { icon: "✍️", title: "إعداد طلب المراجعة", desc: "نساعدك في صياغة طلب احترافي يزيد من احتمالية القبول." },
          { icon: "📋", title: "إرشاد الخطوات", desc: "نوضح بالتفصيل كيفية تقديم الطلب والمتابعة بعده." },
          { icon: "🔄", title: "متابعة الحالة", desc: "نتابع معك حتى تحصل على رد من واتساب." },
          { icon: "💼", title: "أولوية للأعمال", desc: "حسابات Business تحصل على أولوية في المعالجة." },
          { icon: "🛡️", title: "خصوصية تامة", desc: "لا نطلب كلمة مرور أو رمز تحقق. أمانك ضرورة لا خيار." },
        ].map(item => (
          <div class="glass-dark rounded-2xl p-6 border border-white/8 card-hover">
            <div class="text-4xl mb-4" aria-hidden="true">{item.icon}</div>
            <h3 class="font-bold text-white text-lg mb-2">{item.title}</h3>
            <p class="text-white/55 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What We Don't Do -->
  <section class="py-14 max-w-4xl mx-auto px-4 sm:px-6">
    <div class="bg-amber-900/20 border border-amber-500/30 rounded-2xl p-8">
      <h2 class="text-2xl font-bold text-white mb-4">الشفافية الكاملة — ما لا نفعله</h2>
      <ul class="space-y-3">
        {[
          { x: true, text: "لا نطلب كلمة المرور أو رمز التحقق OTP أبداً." },
          { x: true, text: "لا ننتمي إلى واتساب أو Meta — نحن خدمة مستقلة." },
          { x: true, text: "لا نضمن فك الحظر في كل الحالات — القرار النهائي لواتساب." },
          { x: true, text: "لا نستخدم طرقاً غير قانونية أو نسخاً معدّلة." },
        ].map(item => (
          <li class="flex items-start gap-3">
            <span class="text-red-500 font-bold text-lg shrink-0" aria-hidden="true">✗</span>
            <span class="text-white/70">{item.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-[#0A1628] py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white mb-4">كيف نعمل؟</h2>
      </div>
      <div class="grid sm:grid-cols-4 gap-6">
        {[
          { step: "١", title: "تواصل معنا", desc: "عبر واتساب أو تلغرام وأخبرنا بوضعك." },
          { step: "٢", title: "نحلل المشكلة", desc: "نحدد نوع الحظر وفرص النجاح." },
          { step: "٣", title: "نضع الخطة", desc: "نعد طلب مراجعة مناسباً لحالتك." },
          { step: "٤", title: "نتابع معك", desc: "حتى تحصل على رد ونتيجة." },
        ].map((s, i) => (
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-white/10 border border-white/20 flex items-center justify-center text-white text-2xl font-bold mx-auto mb-4">{s.step}</div>
            <h3 class="font-bold text-white mb-2">{s.title}</h3>
            <p class="text-white/50 text-sm">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- إجابة مباشرة AEO -->
  <section class="py-14 max-w-4xl mx-auto px-4 sm:px-6">
    <div class="glass-dark rounded-2xl p-7 border border-white/8">
      <h2 class="text-2xl font-bold text-white mb-4">ما هي خدمة فك حظر واتساب التي نقدمها بالضبط؟</h2>
      <p class="text-white/70 leading-relaxed mb-4">
        WFixerX خدمة استشارية مستقلة تساعد أصحاب حسابات واتساب المحظورة على تشخيص نوع الحظر وسببه، وإعداد
        طلب مراجعة مكتوب بصيغة صحيحة، وتقديمه عبر القناة الرسمية المناسبة لحالتك، ثم متابعة الرد. نحن لا نملك
        صلاحية على أنظمة واتساب ولا نستطيع رفع الحظر بأنفسنا — <strong class="text-white">القرار لواتساب وحدها</strong>.
        ما نبيعه هو الخبرة في التشخيص والصياغة والمتابعة، لا وعدٌ بنتيجة.
      </p>
      <p class="text-white/70 leading-relaxed">
        إن كان الفحص الأولي يظهر أن حالتك ميؤوس منها، أو أن بإمكانك حلها بنفسك مجاناً في دقائق، نقول لك ذلك
        صراحة ولا نأخذ منك شيئاً. التقييم الأولي مجاني دائماً، والخدمة متاحة للسعودية ومصر والإمارات والكويت
        وقطر والبحرين وعُمان والأردن والعراق.
      </p>
    </div>
  </section>

  <!-- ماذا تدفع مقابله -->
  <section class="py-14 bg-[#07111f]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl font-bold text-white mb-3 text-center">ماذا تدفع مقابله بالضبط؟</h2>
      <p class="text-white/55 text-center mb-10">شفافية كاملة: هذه هي قيمة الخدمة، وهذه حدودها</p>
      <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse">
          <thead>
            <tr class="border-b border-white/15">
              <th class="py-3 px-3 text-white font-bold text-sm">المرحلة</th>
              <th class="py-3 px-3 text-white font-bold text-sm">ما نفعله</th>
              <th class="py-3 px-3 text-white font-bold text-sm">لماذا يهم</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            <tr class="border-b border-white/8">
              <th scope="row" class="py-4 px-3 text-[#25D366] font-semibold align-top">التشخيص</th>
              <td class="py-4 px-3 text-white/70 align-top">نقرأ نص رسالة الحظر الحرفي ونحدد نوعه: مؤقت أم مشدد أم نهائي، وسببه المحتمل.</td>
              <td class="py-4 px-3 text-white/55 align-top">كل نوع له مسار مختلف. من يقدم طلباً خاطئاً للنوع الخطأ يحرق فرصته الأولى.</td>
            </tr>
            <tr class="border-b border-white/8">
              <th scope="row" class="py-4 px-3 text-[#25D366] font-semibold align-top">تقييم الفرص</th>
              <td class="py-4 px-3 text-white/70 align-top">نخبرك بصدق: فرصة جيدة، فرصة ضعيفة، أو لا فرصة.</td>
              <td class="py-4 px-3 text-white/55 align-top">تعرف قبل أن تدفع أو تنتظر. لا نبيع أملاً كاذباً.</td>
            </tr>
            <tr class="border-b border-white/8">
              <th scope="row" class="py-4 px-3 text-[#25D366] font-semibold align-top">صياغة الطلب</th>
              <td class="py-4 px-3 text-white/70 align-top">نكتب نص الاستئناف: موجز، واقعي، بلا عبارات تضر، وبالمعلومات التي تطلبها المراجعة فعلاً.</td>
              <td class="py-4 px-3 text-white/55 align-top">أكثر الطلبات تُرفض لأنها طويلة أو عاطفية أو تعترف بما لا يلزم.</td>
            </tr>
            <tr class="border-b border-white/8">
              <th scope="row" class="py-4 px-3 text-[#25D366] font-semibold align-top">القناة الصحيحة</th>
              <td class="py-4 px-3 text-white/70 align-top">نحدد المسار: زر المراجعة داخل التطبيق، أو البريد الرسمي، أو مسار حسابات الأعمال.</td>
              <td class="py-4 px-3 text-white/55 align-top">إرسال الطلب في المكان الخطأ يعني أنه لن يُقرأ أبداً.</td>
            </tr>
            <tr class="border-b border-white/8">
              <th scope="row" class="py-4 px-3 text-[#25D366] font-semibold align-top">المتابعة</th>
              <td class="py-4 px-3 text-white/70 align-top">نتابع معك حتى يصل الرد، ونقرأه معك، ونحدد الخطوة التالية إن رُفض.</td>
