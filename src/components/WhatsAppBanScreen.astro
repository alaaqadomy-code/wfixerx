---
interface Props {
  type?: 'final' | 'temp';
  hours?: string;
}
const { type = 'final', hours = '24' } = Astro.props;
---

<figure class="wa-ban-screen not-prose" role="img" aria-label={type === 'final' ? 'لقطة شاشة رسالة الحظر النهائي على واتساب' : `لقطة شاشة رسالة الحظر المؤقت ${hours} ساعة على واتساب`}>
  <div class="wa-device">
    <!-- Status bar -->
    <div class="wa-statusbar">
      <span>9:41</span>
      <div class="wa-statusbar-icons">
        <svg width="14" height="10" viewBox="0 0 14 10" fill="currentColor" aria-hidden="true">
          <rect x="0" y="4" width="2.5" height="6" rx="0.5"/>
          <rect x="4" y="2" width="2.5" height="8" rx="0.5"/>
          <rect x="8" y="0" width="2.5" height="10" rx="0.5"/>
          <rect x="12" y="1" width="2" height="6" rx="0.5" opacity="0.3"/>
        </svg>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
          <circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M6 1 A5 5 0 0 1 11 6" stroke="currentColor" stroke-width="1.5" fill="none"/>
        </svg>
        <div class="wa-battery">
          <div class="wa-battery-fill" style={type === 'final' ? 'width:35%' : 'width:72%'}></div>
        </div>
      </div>
    </div>

    <!-- WhatsApp header -->
    <div class="wa-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span>WhatsApp</span>
    </div>

    <!-- Screen content -->
    <div class="wa-screen">
      {type === 'final' ? (
        <div class="wa-ban-final">
          <div class="wa-ban-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e53e3e" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
            </svg>
          </div>
          <h3 class="wa-ban-title">لا يمكن لهذا الحساب<br>استخدام واتساب بعد الآن</h3>
          <p class="wa-ban-sub">انتهك هذا الرقم شروط خدمة واتساب.</p>
          <div class="wa-ban-actions">
            <button class="wa-btn-review" type="button" disabled>طلب مراجعة</button>
            <button class="wa-btn-more" type="button" disabled>معرفة المزيد</button>
          </div>
        </div>
      ) : (
        <div class="wa-ban-temp">
          <div class="wa-ban-icon wa-ban-icon-warn">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </div>
          <h3 class="wa-ban-title">حسابك معلّق مؤقتاً</h3>
          <p class="wa-ban-sub">تم تعليق حسابك مؤقتاً لمدة</p>
          <div class="wa-ban-timer">{hours}:00:00</div>
          <p class="wa-ban-hint">قم بإنهاء تشغيل واتساب وانتظر انتهاء مهلة التعليق.</p>
        </div>
      )}
    </div>

    <!-- Home indicator -->
    <div class="wa-home-bar" aria-hidden="true"></div>
  </div>
  <figcaption class="wa-caption">
    {type === 'final'
      ? 'رسالة الحظر النهائي على واتساب — "لا يمكن لهذا الحساب استخدام واتساب بعد الآن"'
      : `رسالة الحظر المؤقت على واتساب — يظهر عداد ${hours} ساعة`
    }
  </figcaption>
</figure>

<style>
.wa-ban-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  margin: 2rem auto;
  max-width: 280px;
}
.wa-device {
  width: 260px;
  background: #000;
  border-radius: 36px;
  padding: 10px;
  border: 2px solid #1a1a2e;
  box-shadow: 0 30px 80px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.06);
}
.wa-statusbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 14px 4px;
  color: rgba(255,255,255,0.7);
  font-size: 11px;
  font-family: -apple-system, Arial, sans-serif;
}
.wa-statusbar-icons { display: flex; align-items: center; gap: 5px; }
.wa-battery {
  width: 22px; height: 11px;
  border: 1.5px solid rgba(255,255,255,0.5);
  border-radius: 3px;
  padding: 1.5px;
  position: relative;
}
.wa-battery::after {
  content: '';
  position: absolute;
  right: -5px; top: 50%;
  transform: translateY(-50%);
  width: 3px; height: 5px;
  background: rgba(255,255,255,0.4);
  border-radius: 0 2px 2px 0;
}
.wa-battery-fill { height: 100%; background: rgba(255,255,255,0.8); border-radius: 1px; }
.wa-header {
  background: #075E54;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  border-radius: 4px 4px 0 0;
}
.wa-header span { color: white; font-weight: 600; font-size: 14px; font-family: Arial, sans-serif; }
.wa-screen {
  background: #ECE5DD;
  min-height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
}
.wa-ban-final, .wa-ban-temp {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  text-align: center;
}
.wa-ban-icon {
  width: 70px; height: 70px;
  background: #fef2f2;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 2px solid #fee2e2;
}
.wa-ban-icon-warn {
  background: #fffbeb;
  border-color: #fde68a;
}
.wa-ban-title {
  font-size: 13px;
  font-weight: 700;
  color: #111;
  line-height: 1.5;
  font-family: Arial, sans-serif;
  direction: rtl;
  margin: 0;
}
.wa-ban-sub {
  font-size: 11px;
  color: #555;
  font-family: Arial, sans-serif;
  direction: rtl;
  margin: 0;
}
.wa-ban-timer {
  font-size: 28px;
  font-weight: 700;
  color: #d97706;
  font-family: monospace;
  letter-spacing: 2px;
}
.wa-ban-hint {
  font-size: 11px;
  color: #777;
  font-family: Arial, sans-serif;
  direction: rtl;
  margin: 0;
}
.wa-ban-actions { display: flex; flex-direction: column; gap: 6px; width: 100%; margin-top: 4px; }
.wa-btn-review {
  background: #25D366;
  color: white;
  border: none;
  border-radius: 20px;
  padding: 8px 16px;
  font-size: 12px;
  font-weight: 600;
  font-family: Arial, sans-serif;
  cursor: default;
  width: 100%;
}
.wa-btn-more {
  background: transparent;
  color: #25D366;
  border: 1.5px solid #25D366;
  border-radius: 20px;
  padding: 7px 16px;
  font-size: 12px;
  font-weight: 600;
  font-family: Arial, sans-serif;
  cursor: default;
  width: 100%;
}
.wa-home-bar {
  width: 90px; height: 4px;
  background: rgba(255,255,255,0.2);
  border-radius: 3px;
  margin: 8px auto 2px;
}
.wa-caption {
  font-size: 12px;
  color: rgba(255,255,255,0.4);
  text-align: center;
  direction: rtl;
  line-height: 1.5;
  font-style: italic;
}
</style>
